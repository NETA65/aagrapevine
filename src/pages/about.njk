---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}about/index.html"
layout: layouts/base.njk
pageKey: about
titleKey: nav.about
descKey: read.about.meta_desc
pageScripts: ["/assets/vendor/lite-yt-embed.js"]
pageStyles: ["/assets/vendor/lite-yt-embed.css"]
---
{#- ABOUT — what and who first: the two magazines, AA Grapevine's two videos about them (#videos:
    config/site.yml about_videos, one card each, the page language's magazine first) and their history
    (config/history.yml, a timeline by decade), our NETA 65 committee; then privacy & anonymity | contact; how the site stays up to date
    (#how: two lines and a link to /status/ — no numbers here: the totals are on Home and /status/, the
    footer says "Last updated", and the step-by-step and the open-source credits live only on /status/).
    An "On this page" nav after the hero; every section opens with ui.sectionHead. The hero's right-hand
    card (the shared hero aside) teases the history timeline — hidden on smaller screens and at larger
    text, where the "On this page" nav right below already leads there.
    (The "not an official site" note is the footer's disclaimer.) -#}
{% import "macros/ui.njk" as ui with context %}
{%- set H = history -%}
{#- On /es/ La Viña comes first wherever both magazines appear -#}
{%- set pubs = ["lv", "gv"] if lang == "es" else ["gv", "lv"] -%}
{%- set vids = site.about_videos | readAboutVideos(db.videos, lang) -%}

{#- The shared hero (same height on every page); "read-hero" (read.css) keeps phone heroes within
    24–28rem. No jump buttons (the page has an "On this page" nav): "Contact us" writes to the committee.
    Right-hand card (ui.heroAsideStat): how long the magazines have carried the message, linking to the
    timeline (#history) — a teaser, never the magazines' facts shown right below. Its heading has its own
    name ("History at a glance"): a region named like the #history section would be a duplicate landmark. -#}
{% call(slot) ui.pageHero(lang, "read.about.title" | t(lang), "read.about.subtitle" | t(lang), "info", "read.about.eyebrow" | t(lang), { class: "read-hero", side: "hide" }) %}
{%- if slot == "side" %}
  {%- if H.items.length and H.years %}
  {{ ui.heroAsideStat("read.about.aside_title" | t(lang), H.years ~ "+", "read.about.aside_label" | t(lang), lang, {
       id: "about-aside-title", icon: "history", sr: "read.about.aside_sr" | t(lang, { years: H.years }),
       note: "read.about.aside_note" | t(lang, { n: H.count.all }), href: "#history", linkLabel: "read.about.aside_link" | t(lang) }) }}
  {%- endif %}
{%- else %}
  <div class="hero-actions">
    <a class="btn-light" href="mailto:{{ site.contact_email }}">{% icon "mail", "size-4" %} {{ "read.about.contact_btn" | t(lang) }}</a>
    <a class="btn-on-dark" href="{{ '/meetings/' | lurl(lang) }}#committee-meeting">{% icon "video", "size-4" %} {{ "read.about.com_meeting" | t(lang) }}</a>
  </div>
{%- endif %}
{% endcall %}

<div class="container-page page-overlap">
  {{ ui.pageNav([
    { href: "#magazines", label: "read.about.mags_title" | t(lang), icon: "grapes" },
    { href: ("#videos" if vids.length else ""), label: "read.about.nav_videos" | t(lang), icon: "circle-play" },
    { href: ("#history" if H.items.length else ""), label: "read.about.hist_title" | t(lang), icon: "history" },
    { href: "#committee", label: "read.about.com_title" | t(lang), icon: "users" },
    { href: "#privacy", label: "read.about.nav_privacy" | t(lang), icon: "eye-off" },
    { href: "#contact", label: "read.about.contact_title" | t(lang), icon: "mail" },
    { href: "#how", label: "read.about.nav_how" | t(lang), icon: "refresh-cw" }
  ], lang) }}
</div>

{#- ---------- The two magazines ---------- -#}
<section id="magazines" class="container-page section pt-10 sm:pt-12" aria-labelledby="mags-title">
  {{ ui.sectionHead("read.about.mags_title" | t(lang), "read.about.mags_sub" | t(lang), "", "", "grapes", { eyebrow: "Grapevine · La Viña", id: "mags-title", lang: lang }) }}

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    {% for p in pubs %}
    {%- set isLv = p == "lv" -%}
    {#- @container: when the card is wide (two cards side by side on a big screen) the story
        keeps a readable line length and the facts move into a column beside it -#}
    <article class="card @container overflow-hidden">
      <header class="read-cover read-cover-head {{ 'read-cover--lv' if isLv else 'read-cover--gv' }} relative isolate overflow-hidden px-6 py-6 text-white sm:px-8">
        <svg class="read-cover-art w-36!" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
        <p class="read-cover-kicker text-xs font-semibold uppercase tracking-[0.18em] text-white/70">{{ ("read.about.lv_kicker" if isLv else "read.about.gv_kicker") | t(lang) }}</p>
        <h3 class="read-cover-title mt-1 flex items-center gap-2 font-display font-semibold">{% icon "grapes", "read-cover-icon size-7 shrink-0" %} <span class="min-w-0">{{ "La Viña" if isLv else "AA Grapevine" }}</span></h3>
      </header>
      <div class="grid grid-cols-1 p-6 sm:p-8 @3xl:grid-cols-[minmax(0,1fr)_12rem] @3xl:gap-x-10">
        <div class="measure">
          <p class="leading-relaxed text-ink">{{ ("read.about.lv_p1" if isLv else "read.about.gv_p1") | t(lang) }}</p>
          <p class="mt-3 leading-relaxed text-muted">{{ ("read.about.lv_p2" if isLv else "read.about.gv_p2") | t(lang) }}</p>
        </div>
        <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line pt-5 text-sm @3xl:mt-0 @3xl:grid-cols-1 @3xl:content-start @3xl:gap-4 @3xl:border-t-0 @3xl:border-l @3xl:pt-0 @3xl:pl-6">
          <div><dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.about.f_first" | t(lang) }}</dt><dd class="mt-0.5 font-semibold text-ink">{{ ("read.about.lv_first" if isLv else "read.about.gv_first") | t(lang) }}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.about.f_freq" | t(lang) }}</dt><dd class="mt-0.5 font-semibold text-ink">{{ ("read.subs.f_every2" if isLv else "read.subs.f_monthly") | t(lang) }}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.about.f_lang" | t(lang) }}</dt><dd class="mt-0.5 font-semibold text-ink">{{ ("common.spanish" if isLv else "common.english") | t(lang) }}</dd></div>
        </dl>
        <a class="link tap-link mt-5 inline-flex items-center gap-1 justify-self-start text-sm @3xl:col-span-2" href="{{ site.links.lv_home if isLv else site.links.gv_home }}" target="_blank" rel="noopener">{{ (site.links.lv_home if isLv else site.links.gv_home) | hostname }} {% icon "arrow-up-right", "size-4" %}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{#- ---------- The two videos: AA Grapevine's own videos about the magazines (config/site.yml about_videos,
    readAboutVideos in eleventy/filters/read.js), one card each — side by side from 1024px, stacked on
    phones; the page language's magazine first. Each card: the player (lite-youtube, privacy-enhanced:
    only the preview picture loads until it is played, and with Data saver not even that), the magazine,
    the video's language and length, its title and its own summary in its own language (lang), and —
    on the other-language page — our translation under it (its title, the summary one tap away), then
    "Watch on YouTube". ---------- -#}
{% if vids | length %}
<section id="videos" class="container-page section pt-0" aria-labelledby="videos-title">
  {{ ui.sectionHead("read.about.vid_title" | t(lang), "read.about.vid_sub" | t(lang), "", "", "circle-play", { eyebrow: "read.about.vid_eyebrow" | t(lang), tone: "text-grape", id: "videos-title", lang: lang }) }}
  {#- From 1024px side by side, each card's parts on rows shared with the other card (subgrid: player ·
      badges · title · summary · translation · link), so they line up and a shorter card's spare room is
      spread over its rows instead of left in one block. -#}
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-x-6 lg:gap-y-0">
    {% for v in vids %}
    {%- set play = ("media.play" | t(lang)) ~ ": " ~ v.title -%}
    {%- set other = v.lang != lang -%}
    <article class="card read-vid flex min-w-0 flex-col overflow-hidden lg:row-span-6 lg:grid lg:grid-rows-subgrid" aria-labelledby="vid-{{ v.id }}-h">
      <div class="read-vid-player">
        <lite-youtube videoid="{{ v.id }}" class="media-lyt" params="rel=0&amp;playsinline=1&amp;hl={{ lang }}"
                      style="background-image: url('{{ v.id | ytThumb('hqdefault') }}');" playlabel="{{ play }}">
          <a href="{{ v.url }}" class="lyt-playbtn" title="{{ play }}" target="_blank" rel="noopener"><span class="lyt-visually-hidden">{{ play }}</span></a>
        </lite-youtube>
      </div>
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1.5 px-5 pt-5 sm:px-6">
        <span class="{{ 'badge-lv' if v.isLv else 'badge-gv' }}">{% icon "grapes", "size-3" %} {{ "La Viña" if v.isLv else "Grapevine" }}</span>
        <span class="badge-muted">{% icon "languages", "size-3" %} {{ ("committee.weekly.lang_" + v.lang) | t(lang) }}</span>
        {%- if v.seconds %}
        <span class="inline-flex items-center gap-1 text-sm text-muted">{% icon "clock-3", "size-3.5 shrink-0" %}<span class="sr-only">{{ "read.about.vid_length" | t(lang) }}:</span> {{ v.seconds | mediaMinutes }}</span>
        {%- endif %}
      </p>
      <h3 id="vid-{{ v.id }}-h" class="h-card mt-3 px-5 text-balance sm:px-6"{% if other %} lang="{{ v.lang }}"{% endif %}>{{ v.title }}</h3>
      <div class="px-5 sm:px-6">{% if v.summary %}<p class="mt-2 leading-relaxed text-muted"{% if other %} lang="{{ v.lang }}"{% endif %}>{{ v.summary }}</p>{% endif %}</div>
      {#- our translation (the other-language page only): the translated title shows, the summary opens under it -#}
      <div class="px-5 sm:px-6">
        {%- if v.tr and (v.tr.title or v.tr.summary) %}
        <details class="read-vid-tr group/tr mt-4">
          <summary>
            {% icon "languages", "size-4 mt-0.5 shrink-0 text-grape" %}
            <span class="min-w-0 flex-1"><span class="eyebrow block">{{ "read.about.vid_tr" | t(lang) }}</span>{% if v.tr.title %}<span class="mt-0.5 block font-semibold leading-snug text-ink">{{ v.tr.title }}</span>{% endif %}</span>
            {% icon "chevron-down", "size-4 mt-0.5 shrink-0 text-muted transition group-open/tr:rotate-180" %}
          </summary>
          <div class="px-4 pb-4">
            {% if v.tr.summary %}<p class="text-sm leading-relaxed text-muted">{{ v.tr.summary }}</p>{% endif %}
            {% if v.tr.machine %}<p class="mt-2"><span class="auto-note" title="{{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</span></p>{% endif %}
          </div>
        </details>
        {%- endif %}
      </div>
      <p class="mt-auto px-5 pt-5 pb-5 sm:px-6 sm:pb-6"><a class="btn-secondary btn-sm" href="{{ v.url }}" target="_blank" rel="noopener">{% icon "youtube", "size-4" %} {{ "media.watch_on_yt" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

{#- ---------- Our history: the milestones of both magazines, by decade (config/history.yml) ----------
    One rail (phones) or a rail in the middle with the milestones taking turns left and right (wide).
    Filter chips (All · Grapevine · La Viña, with counts) and "Show all" are CSS states that Alpine
    switches (data-f / data-open on .read-hist — read.css "History"): every milestone is in the HTML,
    and without JavaScript (or on paper) every one shows. -#}
{% if H.items.length %}
{%- set fLabel = { all: "common.all" | t(lang), gv: "Grapevine", lv: "La Viña" } -%}
{%- set tBadge = { grapevine: ["badge-gv", "Grapevine"], lavina: ["badge-lv", "La Viña"], both: ["badge-vine", "read.about.hist_both" | t(lang)] } -%}
<section id="history" class="container-page section pt-0" aria-labelledby="history-title">
  {{ ui.sectionHead("read.about.hist_title" | t(lang), "read.about.hist_sub" | t(lang, { years: H.years, n: H.count.all, first: H.first }), "", "", "history", { eyebrow: "read.about.hist_eyebrow" | t(lang, { year: H.first }), id: "history-title", lang: lang }) }}
  <div class="read-hist" x-data="{ f: 'all', open: false, said: '' }" data-f="all" data-open="0" :data-f="f" :data-open="open ? '1' : '0'">
    <div class="read-hist-bar" role="group" aria-label="{{ 'read.about.hist_filter' | t(lang) }}" data-js-only>
      {%- for k in ["all", pubs[0], pubs[1]] %}
      <button type="button" class="chip" aria-pressed="{{ 'true' if k == 'all' else 'false' }}" :aria-pressed="String(f === '{{ k }}')" data-said="{{ 'read.about.hist_shown' | t(lang, { what: fLabel[k], n: H.count[k] }) }}" @click="f = '{{ k }}'; said = $el.dataset.said">
        {%- if k != "all" %}<span class="read-hist-dot {{ 'bg-gv' if k == 'gv' else 'bg-lv' }}" aria-hidden="true"></span>{% endif %}
        <span>{{ fLabel[k] }}</span> <span class="cm-chip-count">{{ H.count[k] }}</span>
      </button>
      {%- endfor %}
    </div>
    <p class="sr-only" aria-live="polite" x-text="said"></p>
    <ol id="history-list" class="read-hist-decades" role="list">
      {% for d in H.decades %}
      <li class="read-hist-decade {{ d.cls }}">
        <h3 class="read-hist-dec"><span>{{ "read.about.hist_decade" | t(lang, { d: d.decade }) }}</span></h3>
        <ol class="read-hist-list" role="list">
          {% for it in d.items %}
          <li class="read-hist-item {{ it.cls }}" data-t="{{ it.type }}">
            <div class="read-hist-card card">
              <p class="read-hist-meta"><time class="read-hist-when" datetime="{{ it.iso }}">{{ it.label[lang] }}</time><span class="{{ tBadge[it.type][0] }}">{{ tBadge[it.type][1] }}</span></p>
              <h4 class="h-card mt-1.5 text-balance">{{ it.title[lang] }}</h4>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{{ it.desc[lang] }}</p>
            </div>
          </li>
          {% endfor %}
        </ol>
      </li>
      {% endfor %}
    </ol>
    <div class="read-hist-foot">
      <button type="button" class="btn-secondary read-hist-more {{ H.moreCls }}" aria-controls="history-list" aria-expanded="false" :aria-expanded="String(open)" @click="open = !open; if (!open) $nextTick(() => $el.scrollIntoView({ block: 'nearest' }))" data-js-only>
        {%- for k in ["all", "gv", "lv"] %}<span data-l="{{ k }}">{{ "read.about.hist_more" | t(lang, { n: H.count[k] }) }}</span>{% endfor -%}
        <span data-l="less">{{ "read.about.hist_less" | t(lang) }}</span> {% icon "chevron-down", "size-4" %}
      </button>
      {%- if H.official.grapevine and H.official.lavina %}
      {%- set offLinks = { gv: [H.official.grapevine, "read.about.hist_official_gv" | t(lang)], lv: [H.official.lavina, "read.about.hist_official_lv" | t(lang)] } %}
      <p class="max-w-2xl text-sm leading-relaxed text-muted">{{ "read.about.hist_official" | t(lang) }}
        {% for p in pubs %}<a class="link" href="{{ offLinks[p][0] }}" target="_blank" rel="noopener">{{ offLinks[p][1] }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>{{ " · " if loop.first }}{% endfor %}
      </p>
      {%- endif %}
    </div>
  </div>
</section>
{% endif %}

{#- ---------- Our committee (who we are, who we serve) ---------- -#}
<section id="committee" class="section section-band" aria-labelledby="committee-title">
  <div class="container-page">
    {{ ui.sectionHead("read.about.com_title" | t(lang), "read.about.com_p1" | t(lang), site.committee_page or "", "read.about.com_area_page" | t(lang), "users", { eyebrow: site | pick(lang, "area"), tone: "text-vine", id: "committee-title", lang: lang }) }}
    <div class="max-w-3xl">
      <p class="leading-relaxed text-muted">{{ "read.about.com_p2" | t(lang) }}</p>
      {% if meeting.next %}<p class="mt-3 flex gap-2 text-sm text-muted"><span class="mt-0.5 text-gv">{% icon "calendar-days", "size-4" %}</span><span>{{ "read.about.com_next" | t(lang, {date: meeting.next.start | fmtDate(lang, "long"), time: meeting.next.start | fmtDate(lang, "time")}) }}</span></p>{% endif %}
    </div>
    <div class="mt-8">
        <h3 class="eyebrow mb-3 font-sans">{{ "read.about.serve_title" | t(lang) }}</h3>
        {#- four short cards: 1 → 2 (640px) → 4 (1280px) a row, never 3 + 1 -#}
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {% for w in [["house", "bg-gv-soft text-gv", "w1"], ["badge-check", "bg-lv-soft text-lv", "w2"], ["map", "bg-vine-soft text-vine", "w3"], ["languages", "bg-grape-soft text-grape", "w4"]] %}
          <li class="card card-pad">
            <div class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl {{ w[1] }}">{% icon w[0], "size-5" %}</span>
              <h4 class="h-card min-w-0 flex-1">{{ ("read.about." + w[2] + "_t") | t(lang) }}</h4>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{{ ("read.about." + w[2]) | t(lang) }}</p>
          </li>
          {% endfor %}
        </ul>
    </div>
  </div>
</section>

{#- ---------- Privacy & anonymity | contact ---------- -#}
<div class="container-page section grid grid-cols-1 gap-x-10 gap-y-12 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
  <section id="privacy" aria-labelledby="privacy-title">
    {{ ui.sectionHead("read.about.privacy_title" | t(lang), "", "", "", "eye-off", { eyebrow: "read.about.privacy_eyebrow" | t(lang), tone: "text-vine", id: "privacy-title", lang: lang }) }}
    <ul class="card card-pad space-y-3">
      {% for n in range(1, 6) %}
      <li class="flex gap-3"><span class="mt-0.5 text-vine">{% icon "circle-check", "size-5" %}</span><span class="leading-relaxed text-ink">{{ ("read.about.privacy" + n) | t(lang) }}</span></li>
      {% endfor %}
    </ul>
  </section>
  <section id="contact" aria-labelledby="contact-title">
    {{ ui.sectionHead("read.about.contact_title" | t(lang), "read.about.contact_text" | t(lang), "", "", "mail", { eyebrow: "read.about.contact_eyebrow" | t(lang), id: "contact-title", lang: lang }) }}
    <div class="card card-pad">
      <div class="flex flex-wrap items-center gap-2">
        <a class="btn-primary max-w-full" href="mailto:{{ site.contact_email }}">{% icon "send", "size-4 shrink-0" %} <span class="min-w-0 truncate">{{ site.contact_email | replace("@", "@<wbr>") | safe }}</span></a>
        <button type="button" class="btn-secondary" data-js-only data-copy="{{ site.contact_email }}">{% icon "copy", "size-4" %} {{ "common.copy" | t(lang) }}</button>
      </div>
      <ul class="mt-5 grid gap-1 border-t border-line pt-4 text-sm">
        <li><a class="link tap-link" href="{{ '/meetings/' | lurl(lang) }}#committee-meeting">{{ "nav.meeting" | t(lang) }}</a></li>
        {% if site.area_website %}<li><a class="link tap-link" href="{{ site.area_website }}" target="_blank" rel="noopener">{{ site | pick(lang, "area") }} — {{ site.area_website | hostname }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></li>{% endif %}
        <li><a class="link tap-link" href="{{ site.links.aa_org_es if lang == 'es' else site.links.aa_org }}" target="_blank" rel="noopener">{{ "read.about.find_meeting" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></li>
      </ul>
    </div>
  </section>
</div>

{#- ---------- How this site stays up to date: two lines and the link to the full status ---------- -#}
<section id="how" class="container-page section pt-0" aria-labelledby="how-title">
  {{ ui.sectionHead("read.about.how_title" | t(lang), "read.about.how_sub" | t(lang), '/status/' | lurl(lang), "read.about.status_link" | t(lang), "refresh-cw", { eyebrow: "read.about.how_eyebrow" | t(lang), id: "how-title", lang: lang }) }}
  <p class="flex max-w-3xl gap-2.5 text-sm leading-relaxed text-muted"><span class="mt-0.5 text-gv">{% icon "shield-check", "size-4" %}</span><span><strong class="font-semibold text-ink">{{ "read.about.polite_title" | t(lang) }}.</strong> {{ "read.about.polite_text" | t(lang) }}</span></p>
</section>
