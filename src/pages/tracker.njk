                <ul class="xp-cards" role="list" aria-label="{{ 'expenses.list.caption' | t(lang) }}">
                  <template x-for="r in rows()" :key="r.id">
                    <li class="xp-card" :class="{ 'is-flash': flashId === r.id, 'is-sel': isSel(r.id) }">
                      <div class="xp-card-top">
                        <span class="xp-cat" :class="r.tone"><span class="xp-cat-i" x-xp-icon="r.icon"></span><span x-text="r.cat"></span></span>
                        <span class="xp-card-date" x-text="r.date"></span>
                      </div>
                      <p class="xp-desc" x-text="r.desc"></p>
                      <p class="xp-sub meta-row"><span x-show="r.funder" x-text="r.funder"></span><span x-show="r.miles" x-text="r.miles"></span><span x-show="r.sub" x-text="r.sub"></span></p>
                      <div class="xp-card-mid">
                        <span class="xp-status" x-show="r.status" :class="'is-' + r.status"><span x-xp-icon="r.statusIcon"></span><span x-text="r.statusText"></span></span>
                        <span class="badge-muted" x-show="r.example">{{ "expenses.list.example" | t(lang) }}</span>
                        <span class="badge-muted" x-show="r.direct">{{ "expenses.list.direct" | t(lang) }}</span>
                        <span class="xp-rc" x-show="r.receipt !== 'none'">{% icon "paperclip", "size-3.5" %}<span class="sr-only" x-text="t('receipt.' + r.receipt)"></span></span>
                        <span class="xp-amt" :class="'is-' + r.flow"><span x-show="r.flow === 'in'" aria-hidden="true">{% icon "arrow-down-left", "size-3.5" %}</span><span x-text="r.amount"></span></span>
                      </div>
                      <div class="xp-card-acts">
                        <label class="xp-check"><input type="checkbox" :checked="isSel(r.id)" @change="toggleSel(r.id)"><span class="sr-only" x-text="t('list.select', { what: r.desc })"></span></label>
                        <button type="button" class="xp-icon-btn" :aria-label="t('list.edit', { what: r.desc })" @click="openEdit(r.id)">{% icon "pencil", "size-4" %}</button>
                        <button type="button" class="xp-icon-btn" :aria-label="t('list.duplicate', { what: r.desc })" @click="duplicate(r.id)">{% icon "copy", "size-4" %}</button>
                        <button type="button" class="xp-icon-btn xp-danger" :aria-label="t('list.delete', { what: r.desc })" @click="remove([r.id])">{% icon "trash-2", "size-4" %}</button>
                      </div>
                    </li>
                  </template>
                </ul>
              </div>
            </template>
            <div class="mt-5 text-center" x-show="remaining()">
              <button type="button" class="btn-secondary btn-sm" @click="more()">{% icon "chevrons-down", "size-4" %} <span x-text="t('list.show_more', { n: count(Math.min(remaining(), 100)) })"></span></button>
            </div>
          </div>
          </template>
        </div>
        </template>
      </section>

      {#- ================= 2. Summary ================= -#}
      <section role="tabpanel" id="xp-panel-summary" aria-labelledby="xp-tab-summary" class="xp-panel" x-show="view === 'summary'" tabindex="-1">
        <template x-if="view === 'summary'">
        <div class="xp-pad">
          <div class="xp-head">
            <div class="min-w-0">
              <h3 class="card-h"><span>{% icon "chart-column", "size-5" %}</span>{{ "expenses.sum.title" | t(lang) }}</h3>
              <p class="mt-1 text-sm text-muted">{{ "expenses.sum.sub" | t(lang) }}</p>
            </div>
            <div class="xp-f xp-f-inline">
              <label class="xp-label" for="xp-s-period">{{ "expenses.f.period" | t(lang) }}</label>
              <select id="xp-s-period" class="input xp-select" @change="setPeriod($event.target.value)">
                <template x-for="p in periods()" :key="p.id"><option :value="p.id" :selected="p.id === f.period" x-text="p.label"></option></template>
              </select>
            </div>
          </div>
          <div class="xp-custom-dates" x-show="f.period === 'custom'">
            <div class="xp-f"><label class="xp-label" for="xp-s-from">{{ "expenses.f.from" | t(lang) }}</label><input id="xp-s-from" class="input" type="date" x-model="f.from" @change="saveUi()"></div>
            <div class="xp-f"><label class="xp-label" for="xp-s-to">{{ "expenses.f.to" | t(lang) }}</label><input id="xp-s-to" class="input" type="date" x-model="f.to" @change="saveUi()"></div>
          </div>

          <ul class="xp-stats" role="list">
            <template x-for="s in stats()" :key="s.id">
              <li class="xp-stat" :class="s.tone">
                <span class="xp-stat-i" x-xp-icon="s.icon"></span>
                <span class="xp-stat-label" x-text="s.label"></span>
                <span class="xp-stat-value" x-text="s.value"></span>
                <span class="xp-stat-note" x-text="s.note"></span>
              </li>
            </template>
          </ul>

          <div class="xp-sum-grid">
            {#- by category: CSS bars (the amount and the share in text; the bar is a picture of them) -#}
            <div class="xp-box">
              <h4 class="xp-h4">{{ "expenses.sum.by_category" | t(lang) }}</h4>
              <p class="xp-none" x-show="!byCat().length">{{ "expenses.sum.nothing" | t(lang) }}</p>
              <ul class="xp-bars" role="list">
                <template x-for="c in byCat()" :key="c.id">
                  <li class="xp-bar-row" :class="c.tone">
                    <span class="xp-bar-label"><span class="xp-cat-i" x-xp-icon="c.icon"></span><span x-text="c.label"></span></span>
                    <span class="xp-bar-val"><span x-text="c.amount"></span> <span class="text-muted" x-show="c.items" x-text="'· ' + c.items"></span> <span class="text-muted" x-text="'· ' + c.share"></span></span>
                    <span class="xp-bar-track" aria-hidden="true"><span class="xp-bar-fill" :style="'width:' + c.w + '%'"></span></span>
                  </li>
                </template>
              </ul>
            </div>
            {#- by month: spent vs received -#}
            <div class="xp-box">
              <h4 class="xp-h4">{{ "expenses.sum.by_month" | t(lang) }}</h4>
              <p class="xp-legend" aria-hidden="true" x-show="byMonth().length"><span class="xp-key is-spent"></span>{{ "expenses.sum.spent_short" | t(lang) }} <span class="xp-key is-received"></span>{{ "expenses.sum.received_short" | t(lang) }}</p>
              <p class="xp-none" x-show="!byMonth().length">{{ "expenses.sum.nothing" | t(lang) }}</p>
              <ul class="xp-months" role="list">
                <template x-for="m in byMonth()" :key="m.ym">
                  <li class="xp-month">
                    <span class="xp-month-label" x-text="m.label"></span>
                    <span class="xp-month-bars" aria-hidden="true">
                      <span class="xp-mbar is-spent" :style="'width:' + m.ws + '%'"></span>
                      <span class="xp-mbar is-received" :style="'width:' + m.wr + '%'"></span>
                    </span>
                    <span class="xp-month-val" x-text="t('sum.month_line', { spent: m.spent, received: m.received })"></span>
                  </li>
                </template>
              </ul>
            </div>
            {#- by service activity: assemblies, district meetings, tables … — what each cost (its trips and its
                expenses), its miles and trips: the sections of the service report -#}
            <div class="xp-box">
              <h4 class="xp-h4">{{ "expenses.sum.by_activity" | t(lang) }}</h4>
              <p class="xp-none" x-show="!actRows().length">{{ "expenses.sum.nothing" | t(lang) }}</p>
              <ul class="xp-bars" role="list">
                <template x-for="a in actRows()" :key="a.id">
                  <li class="xp-bar-row xp-tone-grape">
                    <span class="xp-bar-label"><span x-text="a.label"></span></span>
                    <span class="xp-bar-val"><span x-text="a.amount"></span> <span class="text-muted" x-show="a.line" x-text="'· ' + a.line"></span></span>
                    <span class="xp-bar-track" aria-hidden="true"><span class="xp-bar-fill" :style="'width:' + a.w + '%'"></span></span>
                  </li>
                </template>
              </ul>
              <p class="xp-hint" x-show="actRows().length">{{ "expenses.sum.by_activity_hint" | t(lang) }}</p>
            </div>
          </div>

          {#- who owes you: one row per funder (Area, district, group … and people you helped) -#}
          <div class="xp-box mt-5" id="xp-owed">
            <h4 class="xp-h4">{{ "expenses.sum.owed_title" | t(lang) }}</h4>
            <p class="mt-1 text-sm text-muted">{{ "expenses.sum.owed_sub" | t(lang) }}</p>
            <p class="xp-none" x-show="!balances().length">{{ "expenses.sum.owed_none" | t(lang) }}</p>
            <template x-if="wide && balances().length">
            <div class="xp-table-wrap mt-3" role="region" tabindex="0" aria-labelledby="xp-owed-cap">
              <table class="xp-table">
                <caption id="xp-owed-cap" class="sr-only">{{ "expenses.sum.owed_title" | t(lang) }}</caption>
                <thead><tr>
                  <th scope="col">{{ "expenses.sum.col_funder" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.sum.col_to_request" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.sum.col_submitted" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.sum.col_received" | t(lang) }}</th>
                  <th scope="col">{{ "expenses.sum.col_balance" | t(lang) }}</th>
                  <th scope="col"><span class="sr-only">{{ "expenses.list.actions" | t(lang) }}</span></th>
                </tr></thead>
                <tbody>
                  <template x-for="b in balances()" :key="b.id">
                    <tr>
                      <th scope="row" class="font-semibold text-ink"><span x-text="b.name"></span> <span class="badge-muted" x-show="b.person">{{ "expenses.kind.person" | t(lang) }}</span></th>
                      <td class="xp-num" x-text="b.toRequest"></td>
                      <td class="xp-num" x-text="b.submitted"></td>
                      <td class="xp-num" x-text="b.received"></td>
                      <td><span class="xp-bal" :class="b.balance < 0 ? 'is-owed' : b.balance > 0 ? 'is-held' : 'is-even'" x-text="b.balanceText"></span></td>
                      <td><button type="button" class="btn-secondary btn-sm" x-show="!b.person" @click="rqStart(b.id)">{% icon "file-text", "size-4" %} {{ "expenses.sum.build_request" | t(lang) }}</button></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
            </template>
            <template x-if="!wide && balances().length">
              <ul class="xp-rows mt-3" role="list">
                <template x-for="b in balances()" :key="b.id">
                  <li class="xp-row">
                    <p class="xp-row-top"><span class="font-semibold text-ink" x-text="b.name"></span><span class="xp-bal" :class="b.balance < 0 ? 'is-owed' : b.balance > 0 ? 'is-held' : 'is-even'" x-text="b.balanceText"></span></p>
                    <p class="mt-0.5 text-sm text-muted" x-text="t('sum.owed_line', { to_request: b.toRequest, submitted: b.submitted, received: b.received })"></p>
                    <button type="button" class="btn-secondary btn-sm mt-2" x-show="!b.person" @click="rqStart(b.id)">{% icon "file-text", "size-4" %} {{ "expenses.sum.build_request" | t(lang) }}</button>
                  </li>
                </template>
              </ul>
            </template>
          </div>

          <div class="xp-sum-grid mt-5">
            {#- budgets -#}
            <div class="xp-box">
              <h4 class="xp-h4">{{ "expenses.sum.budgets" | t(lang) }}</h4>
              <p class="xp-none" x-show="!budgetRows().length">{{ "expenses.sum.budgets_none" | t(lang) }} <button type="button" class="link" @click="go('settings'); setGo('budgets')">{{ "expenses.sum.budgets_add" | t(lang) }}</button></p>
              <ul class="space-y-4" role="list">
                <template x-for="b in budgetRows()" :key="b.id">
                  <li>
                    <p class="flex flex-wrap justify-between gap-x-3 text-sm"><span class="font-semibold text-ink" x-text="b.label + (b.year ? ' · ' + b.year : '')"></span><span class="text-muted" x-text="t('sum.budget_line', { used: b.used, total: b.total })"></span></p>
                    <span class="xp-bar-track mt-1.5" :class="{ 'is-over': b.over }" role="progressbar" aria-valuemin="0" aria-valuemax="100" :aria-valuenow="Math.min(100, b.pct)" :aria-label="b.label"><span class="xp-bar-fill" :style="'width:' + Math.min(100, b.pct) + '%'"></span></span>
                    <p class="mt-1 text-xs" :class="b.over ? 'text-danger font-semibold' : 'text-muted'" x-text="b.over ? t('sum.budget_over', { amount: b.left.replace('-', '') }) : t('sum.budget_left', { amount: b.left, pct: b.pct })"></p>
                  </li>
                </template>
              </ul>
            </div>
            {#- subscriptions: renewals due soon; helped purchases not paid back -#}
            <div class="xp-box">
              <h4 class="xp-h4">{{ "expenses.sum.subs" | t(lang) }}</h4>
              <p class="xp-none" x-show="!renewalRows().length">{{ "expenses.sum.renew_none" | t(lang) }}</p>
              <ul class="xp-lines" role="list">
                <template x-for="r in renewalRows()" :key="r.id">
                  <li><span class="font-semibold text-ink" x-text="r.what"></span><span class="text-muted" x-show="r.who" x-text="' · ' + r.who"></span>
                    <span class="block text-sm" :class="r.past ? 'text-danger' : 'text-muted'" x-text="t(r.past ? 'sum.renew_ended' : 'sum.renew_due', { date: r.end })"></span>
                    <button type="button" class="link text-sm" @click="renew(r.id)">{{ "expenses.sum.renew_now" | t(lang) }}</button></li>
                </template>
              </ul>
              <p class="mt-3 text-sm text-muted" x-show="peopleOwed().length">
                <span x-text="plural(peopleOwed().length, 'sum.helped_one', 'sum.helped')"></span>
                <a class="link" href="#xp-owed">{{ "expenses.sum.see_owed" | t(lang) }}</a>
              </p>
              <p class="mt-3"><button type="button" class="link text-sm xp-link-btn" @click="jump('giveaways', 'xp-subs')">{{ "expenses.sum.see_subs" | t(lang) }}</button></p>
            </div>
            {#- reminders -#}
            <div class="xp-box">
              <h4 class="xp-h4">{{ "expenses.sum.reminders" | t(lang) }}</h4>
              <p class="xp-none" x-show="!reminderCount()">{% icon "circle-check", "size-4 inline -mt-0.5 text-vine" %} {{ "expenses.sum.reminders_none" | t(lang) }}</p>
              <ul class="xp-lines" role="list">
                <li x-show="backupDue()">
                  <span class="font-semibold text-ink">{{ "expenses.sum.backup_due" | t(lang) }}</span>
                  <span class="block text-sm text-muted" x-text="t('sum.backup_last', { when: lastBackupText() })"></span>
                  <button type="button" class="link text-sm" @click="exportBackup()">{{ "expenses.aside.backup_now" | t(lang) }}</button>
                </li>
                <template x-for="s in staleRows()" :key="s.id">
                  <li><span class="font-semibold text-ink" x-text="t('sum.stale', { funder: s.funder, amount: s.amount })"></span>
                    <span class="block text-sm text-muted" x-text="s.desc + ' · ' + t('sum.stale_since', { date: s.since })"></span>
                    <button type="button" class="link text-sm" @click="openEdit(s.id)">{{ "expenses.sum.stale_open" | t(lang) }}</button></li>
                </template>
              </ul>
            </div>
          </div>
        </div>
        </template>
      </section>

      {#- ================= 3. Giveaways (carry the message): literature, then subscriptions ================= -#}
      <section role="tabpanel" id="xp-panel-giveaways" aria-labelledby="xp-tab-giveaways" class="xp-panel" x-show="view === 'giveaways'" tabindex="-1">
        <template x-if="view === 'giveaways'">
        <div class="xp-pad">
          <div class="xp-head">
            <div class="min-w-0 max-w-3xl">
              <h3 class="card-h"><span>{% icon "gift", "size-5" %}</span>{{ "expenses.give.title" | t(lang) }}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{{ "expenses.give.why" | t(lang) }} <a class="link" href="{{ carryHref }}">{{ "expenses.give.shop_link" | t(lang) }}</a></p>
            </div>
            {#- the period (the same one as Entries and Summary): what came in and went out in it -#}
            <div class="xp-f xp-f-inline">
              <label class="xp-label" for="xp-g-period">{{ "expenses.f.period" | t(lang) }}</label>
              <select id="xp-g-period" class="input xp-select" @change="setPeriod($event.target.value)">
                <template x-for="p in periods()" :key="p.id"><option :value="p.id" :selected="p.id === f.period" x-text="p.label"></option></template>
              </select>
            </div>
          </div>
          <div class="xp-custom-dates" x-show="f.period === 'custom'">
            <div class="xp-f"><label class="xp-label" for="xp-g-from">{{ "expenses.f.from" | t(lang) }}</label><input id="xp-g-from" class="input" type="date" x-model="f.from" @change="saveUi()"></div>
            <div class="xp-f"><label class="xp-label" for="xp-g-to">{{ "expenses.f.to" | t(lang) }}</label><input id="xp-g-to" class="input" type="date" x-model="f.to" @change="saveUi()"></div>
          </div>
          {#- the view's two parts (a long page on a phone): a jump to each -#}
          <div class="chip-row xp-jumps" role="group" aria-label="{{ 'expenses.give.parts' | t(lang) }}">
            <button type="button" class="chip" @click="jump('', 'xp-lit')">{% icon "book-open", "size-4 shrink-0" %}{{ "expenses.give.jump_lit" | t(lang) }}</button>
            <button type="button" class="chip" @click="jump('', 'xp-subs')">{% icon "newspaper", "size-4 shrink-0" %}{{ "expenses.subs.title" | t(lang) }}</button>
          </div>

          {#- ---- literature to give away: the period's stock (start + bought + received − given = on hand) ---- -#}
          <h4 id="xp-lit" class="xp-h4 xp-part" tabindex="-1">{{ "expenses.give.lit" | t(lang) }}</h4>
          <div class="xp-actions mt-3">
            <button type="button" class="btn-primary btn-sm" @click="openAdd('giveaway')">{% icon "heart-handshake", "size-4" %} {{ "expenses.give.record" | t(lang) }}</button>
            <button type="button" class="btn-secondary btn-sm" @click="openAdd('expense', 'giveaways')">{% icon "shopping-bag", "size-4" %} {{ "expenses.give.buy" | t(lang) }}</button>
            <button type="button" class="btn-secondary btn-sm" @click="openAdd('stock')">{% icon "package", "size-4" %} {{ "expenses.give.stock" | t(lang) }}</button>
          </div>
          <ul class="xp-stats mt-4" role="list">
            <template x-for="s in giveTiles()" :key="s.id">
              <li class="xp-stat" :class="s.tone">
                <span class="xp-stat-i" x-xp-icon="s.icon"></span>
                <span class="xp-stat-label" x-text="s.label"></span>
                <span class="xp-stat-value" x-text="s.value"></span>
                <span class="xp-stat-note" x-text="s.note"></span>
              </li>
            </template>
          </ul>

          <h5 class="xp-h5 mt-6">{{ "expenses.give.inventory" | t(lang) }}</h5>
          {#- empty: "in this period" once anything was ever recorded, "yet" before that -#}
          <p class="xp-none" x-show="!inv().length" x-text="everLit() ? t('give.inventory_none_period') : t('give.inventory_none')"></p>
          <template x-if="inv().length && wide">
            <div class="xp-table-wrap mt-3" role="region" tabindex="0" aria-labelledby="xp-inv-cap">
              <table class="xp-table">
                <caption id="xp-inv-cap" class="sr-only">{{ "expenses.give.inventory" | t(lang) }}</caption>
                <thead><tr>
                  <th scope="col">{{ "expenses.field.item" | t(lang) }}</th>
                  <th scope="col" class="xp-num" x-show="anyStart()">{{ "expenses.give.col_start" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.give.col_bought" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.give.col_received" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.give.col_given" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.give.col_on_hand" | t(lang) }}</th>
                  <th scope="col" class="xp-num">{{ "expenses.give.col_each" | t(lang) }}</th>
                </tr></thead>
                <tbody>
                  <template x-for="x in inv()" :key="x.key">
                    <tr>
                      <th scope="row"><span class="font-semibold text-ink" x-text="x.item"></span> <span class="xp-fmt" :class="'is-' + x.format" x-show="x.format" x-text="x.formatText"></span></th>
                      <td class="xp-num" x-show="anyStart()" x-text="x.start"></td>
                      <td class="xp-num" x-text="x.bought"></td>
                      <td class="xp-num" x-text="x.received"></td>
                      <td class="xp-num" x-text="x.given"></td>
                      <td class="xp-num"><span :class="x.onHand < 0 ? 'xp-neg' : 'font-semibold text-ink'"><span x-show="x.onHand < 0" aria-hidden="true">{% icon "triangle-alert", "size-3.5" %}</span><span x-text="x.onHandText"></span><span class="sr-only" x-show="x.onHand < 0">{{ "expenses.give.negative_sr" | t(lang) }}</span></span></td>
                      <td class="xp-num" x-text="x.avg"></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </template>
          <template x-if="inv().length && !wide">
            <ul class="xp-rows mt-3" role="list">
              <template x-for="x in inv()" :key="x.key">
                <li class="xp-row">
                  <p><span class="font-semibold text-ink" x-text="x.item"></span> <span class="xp-fmt" :class="'is-' + x.format" x-show="x.format" x-text="x.formatText"></span></p>
                  <p class="text-sm text-muted" x-show="anyStart()" x-text="t('give.row_start', { n: x.start })"></p>
                  <p class="text-sm text-muted" x-text="t(x.hasAvg ? 'give.row_line' : 'give.row_line_free', { bought: x.bought, received: x.received, given: x.given, each: x.avg })"></p>
                  <p class="text-sm" :class="x.onHand < 0 ? 'xp-neg' : 'font-semibold text-ink'" x-text="t(x.onHand < 0 ? 'give.row_negative' : 'give.row_on_hand', { n: x.onHandText })"></p>
                </li>
              </template>
            </ul>
          </template>
          <p class="mt-2 text-xs text-muted" x-show="anyStart()">{{ "expenses.give.start_note" | t(lang) }}</p>
          <p class="mt-2 text-xs text-muted" x-show="invNegative()">{{ "expenses.give.negative_note" | t(lang) }}</p>

          <h5 class="xp-h5 mt-8">{{ "expenses.give.by_event" | t(lang) }}</h5>
          <p class="xp-none" x-show="!giveEvents().length" x-text="everGiven() ? t('give.by_event_none_period') : t('give.by_event_none')"></p>
          <ul class="xp-events" role="list">
            <template x-for="g in giveEvents()" :key="g.key">
              <li class="xp-event">
                <p class="flex flex-wrap items-baseline justify-between gap-x-3"><span class="font-semibold text-ink" x-text="g.name"></span><span class="text-sm text-muted" x-text="g.date"></span></p>
                <p class="mt-0.5 text-sm font-semibold text-vine" x-text="t('give.event_total', { n: g.total })"></p>
                <ul class="mt-2 space-y-1 text-sm text-muted" role="list">
                  <template x-for="i in g.items" :key="i.key"><li class="flex justify-between gap-3"><span x-text="i.text"></span><span class="tabular-nums" x-text="i.qty"></span></li></template>
                </ul>
              </li>
            </template>
          </ul>

          {#- ---- subscriptions: every one you gave (or bought for someone, the group, yourself), where it
              stands today, and the end dates for your calendar ---- -#}
          <h4 id="xp-subs" class="xp-h4 xp-part mt-10" tabindex="-1">{{ "expenses.subs.title" | t(lang) }}</h4>
          <p class="mt-1 max-w-3xl text-sm leading-relaxed text-muted">{{ "expenses.subs.intro" | t(lang) }}</p>
          <div class="xp-actions mt-3">
            <button type="button" class="btn-primary btn-sm" @click="openAdd('expense', 'subscriptions')">{% icon "plus", "size-4" %} {{ "expenses.subs.add" | t(lang) }}</button>
            <button type="button" class="btn-secondary btn-sm" :disabled="!subStatusCount('ending') && !subStatusCount('active')" @click="subsIcs()" aria-describedby="xp-ics-hint">{% icon "calendar-plus", "size-4" %} {{ "expenses.subs.ics" | t(lang) }}</button>
          </div>
          <p id="xp-ics-hint" class="xp-hint">{{ "expenses.subs.ics_hint" | t(lang) }}</p>
          <ul class="xp-stats mt-4" role="list">
            <template x-for="s in subTiles()" :key="s.id">
              <li class="xp-stat" :class="s.tone">
                <span class="xp-stat-i" x-xp-icon="s.icon"></span>
                <span class="xp-stat-label" x-text="s.label"></span>
                <span class="xp-stat-value" x-text="s.value"></span>
                <span class="xp-stat-note" x-text="s.note"></span>
              </li>
            </template>
          </ul>
          <p class="xp-none" x-show="!subsAll().length">{{ "expenses.subs.none" | t(lang) }}</p>
          <template x-if="subsAll().length">
          <div>
            <div class="xp-chips">
              <div class="chip-row" role="group" aria-label="{{ 'expenses.subs.show' | t(lang) }}">
                <button type="button" class="chip" :aria-pressed="subF.status ? 'false' : 'true'" @click="subF.status = ''">{{ "common.all" | t(lang) }}<span class="xp-chip-n tabular-nums" x-text="subStatusCount('')"></span></button>
                {%- for s in ["ending", "ended", "active", "renewed", "no_end"] %}
                <button type="button" class="chip" x-show="subStatusCount('{{ s }}')" :aria-pressed="subF.status === '{{ s }}' ? 'true' : 'false'" @click="subToggle('{{ s }}')">{{ ("expenses.subs.st_" + s) | t(lang) }}<span class="xp-chip-n tabular-nums" x-text="subStatusCount('{{ s }}')"></span></button>
                {%- endfor %}
              </div>
              <div class="xp-f">
                <label class="sr-only" for="xp-sub-kind">{{ "expenses.subs.kind_filter" | t(lang) }}</label>
                <select id="xp-sub-kind" class="input xp-select xp-select-sm" x-model="subF.kind">
                  <option value="">{{ "expenses.subs.all_kinds" | t(lang) }}</option>
                  {%- for k in ["gift", "helped", "group", "self"] %}<option value="{{ k }}">{{ ("expenses.sub_kind." + k) | t(lang) }}</option>{% endfor %}
                </select>
              </div>
            </div>
            {#- how many subscriptions are listed (10 gifts bought at once count 10, as on the tiles) -#}
            <p class="xp-count" role="status" aria-live="polite" aria-atomic="true" x-text="plural(subShown(), 'subs.shown_one', 'subs.shown')"></p>
            {#- the table needs a laptop's width (six columns and "Record the renewal"): below it, cards (subsWide) -#}
            <template x-if="subsWide && subRows().length">
              <div class="xp-table-wrap mt-3" role="region" tabindex="0" aria-labelledby="xp-subs-cap">
                <table class="xp-table xp-subs-table">
                  <caption id="xp-subs-cap" class="sr-only">{{ "expenses.subs.title" | t(lang) }}</caption>
                  <thead><tr>
                    <th scope="col">{{ "expenses.subs.col_who" | t(lang) }}</th>
                    <th scope="col">{{ "expenses.field.sub_product" | t(lang) }}</th>
                    <th scope="col">{{ "expenses.subs.col_started" | t(lang) }}</th>
                    <th scope="col">{{ "expenses.subs.col_ends" | t(lang) }}</th>
                    <th scope="col">{{ "expenses.field.status" | t(lang) }}</th>
                    <th scope="col"><span class="sr-only">{{ "expenses.list.actions" | t(lang) }}</span></th>
                  </tr></thead>
                  <tbody>
                    <template x-for="s in subRows()" :key="s.id">
                      <tr>
                        <th scope="row"><span class="font-semibold text-ink" x-text="s.who"></span><span class="xp-sub" x-show="s.kind || s.qty" x-text="[s.kind, s.qty].filter(Boolean).join(' · ')"></span></th>
                        <td x-text="s.what"></td>
                        <td class="whitespace-nowrap" x-text="s.start"></td>
                        <td class="whitespace-nowrap" x-text="s.end"></td>
                        <td><span class="xp-status" :class="'is-sub-' + s.status"><span x-xp-icon="s.icon"></span><span x-text="s.statusText"></span></span><span class="xp-sub" x-show="s.when" x-text="s.when"></span></td>
                        <td>
                          <div class="xp-acts">
                            <button type="button" class="btn-ghost btn-sm" x-show="s.canRenew" @click="renew(s.id)">{% icon "repeat", "size-4" %}<span>{{ "expenses.sum.renew_now" | t(lang) }}</span><span class="sr-only" x-text="': ' + s.who"></span></button>
                            <button type="button" class="xp-icon-btn" :aria-label="t('list.edit', { what: s.who + ' · ' + s.what })" @click="openEdit(s.id)">{% icon "pencil", "size-4" %}</button>
                          </div>
                        </td>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </div>
            </template>
            <template x-if="!subsWide && subRows().length">
              <ul class="xp-rows mt-3" role="list">
                <template x-for="s in subRows()" :key="s.id">
                  <li class="xp-row">
                    <p class="xp-row-top"><span class="font-semibold text-ink" x-text="s.who"></span><span class="xp-status" :class="'is-sub-' + s.status"><span x-xp-icon="s.icon"></span><span x-text="s.statusText"></span></span></p>
                    <p class="mt-0.5 text-sm text-muted" x-text="[s.what, s.kind, s.qty].filter(Boolean).join(' · ')"></p>
                    <p class="text-sm text-muted" x-text="t('subs.dates', { start: s.start, end: s.end })"></p>
                    <p class="text-sm font-semibold text-ink" x-show="s.when" x-text="s.when"></p>
                    <div class="xp-row-acts">
                      <button type="button" class="btn-secondary btn-sm" x-show="s.canRenew" @click="renew(s.id)">{% icon "repeat", "size-4" %}<span>{{ "expenses.sum.renew_now" | t(lang) }}</span><span class="sr-only" x-text="': ' + s.who"></span></button>
                      <button type="button" class="xp-icon-btn" :aria-label="t('list.edit', { what: s.who + ' · ' + s.what })" @click="openEdit(s.id)">{% icon "pencil", "size-4" %}</button>
                    </div>
                  </li>
                </template>
              </ul>
            </template>
            <p class="xp-none" x-show="!subRows().length">{{ "expenses.subs.none_match" | t(lang) }}</p>
          </div>
          </template>
        </div>
        </template>
      </section>

      {#- ================= 4. Requests (reimbursement) ================= -#}
      <section role="tabpanel" id="xp-panel-requests" aria-labelledby="xp-tab-requests" class="xp-panel" x-show="view === 'requests'" tabindex="-1">
        <template x-if="view === 'requests'">
        <div class="xp-pad">
          <div class="xp-head">
            <div class="min-w-0 max-w-3xl">
              <h3 class="card-h"><span>{% icon "file-text", "size-5" %}</span>{{ "expenses.req.title" | t(lang) }}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{{ "expenses.req.sub" | t(lang) }}</p>
            </div>
          </div>
          <div class="xp-rq">
            {#- the choices -#}
            <div class="xp-rq-setup panel-muted">
              <div class="xp-f">
                <label class="xp-label" for="xp-rq-funder"><span class="step-num" aria-hidden="true">1</span>{{ "expenses.req.who" | t(lang) }}</label>
                <select id="xp-rq-funder" class="input xp-select" x-model="rq.funder">
                  <option value="">{{ "expenses.req.pick" | t(lang) }}</option>
                  <template x-for="x in claimFunders()" :key="x.id"><option :value="x.id" :selected="x.id === rq.funder" x-text="lbl(x.name)"></option></template>
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-rq-period"><span class="step-num" aria-hidden="true">2</span>{{ "expenses.req.when" | t(lang) }}</label>
                <select id="xp-rq-period" class="input xp-select" x-model="rq.period">
                  <template x-for="p in periods()" :key="p.id"><option :value="p.id" :selected="p.id === rq.period" x-text="p.label"></option></template>
                </select>
              </div>
              <div class="xp-custom-dates" x-show="rq.period === 'custom'">
                <div class="xp-f"><label class="xp-label" for="xp-rq-from">{{ "expenses.f.from" | t(lang) }}</label><input id="xp-rq-from" class="input" type="date" x-model="rq.from"></div>
                <div class="xp-f"><label class="xp-label" for="xp-rq-to">{{ "expenses.f.to" | t(lang) }}</label><input id="xp-rq-to" class="input" type="date" x-model="rq.to"></div>
              </div>
              <fieldset class="xp-f">
                <legend class="xp-label"><span class="step-num" aria-hidden="true">3</span>{{ "expenses.req.which" | t(lang) }}</legend>
                <div class="xp-checks">
                  {%- for s in ["to_request", "submitted", "paid", "denied"] %}
                  <label class="xp-check-line"><input type="checkbox" x-model="rq.st.{{ s }}"><span>{{ ("expenses.status." + s) | t(lang) }}</span></label>
                  {%- endfor %}
                </div>
              </fieldset>
              <fieldset class="xp-f">
                <legend class="xp-label">{{ "expenses.req.options" | t(lang) }}</legend>
                <label class="xp-check-line"><input type="checkbox" x-model="rq.names"><span>{{ "expenses.req.names" | t(lang) }}</span></label>
                <p class="xp-hint">{{ "expenses.req.names_hint" | t(lang) }}</p>
                <label class="xp-check-line"><input type="checkbox" x-model="rq.photos" @change="rqLoadPhotos()"><span>{{ "expenses.req.photos" | t(lang) }}</span></label>
              </fieldset>
              <p class="xp-hint" x-show="!profileLine()">{{ "expenses.req.profile_hint" | t(lang) }} <button type="button" class="link" @click="go('settings'); setGo('profile')">{{ "expenses.req.profile_link" | t(lang) }}</button></p>
            </div>

            {#- the request itself (what is printed) + its actions -#}
            <div class="xp-rq-out">
              <p class="xp-none" x-show="!rq.funder">{{ "expenses.req.pick_first" | t(lang) }}</p>
              <template x-if="rq.funder">
              <div>
                <div class="xp-actions">
                  <button type="button" class="btn-primary btn-sm" :disabled="!rqLines().length && !rqMileage().length" @click="rqPrint()">{% icon "printer", "size-4" %} {{ "expenses.req.print" | t(lang) }}</button>
                  <button type="button" class="btn-secondary btn-sm" :disabled="!rqLines().length && !rqMileage().length" @click="rqCopy()">{% icon "copy", "size-4" %} {{ "expenses.req.copy" | t(lang) }}</button>
                  <button type="button" class="btn-secondary btn-sm" :disabled="!rqLines().length && !rqMileage().length" @click="rqShare()">{% icon "share-2", "size-4" %} {{ "expenses.req.share" | t(lang) }}</button>
                  <button type="button" class="btn-secondary btn-sm" :disabled="!rqEntries().length" @click="rqCsv()">{% icon "file-spreadsheet", "size-4" %} {{ "expenses.req.csv" | t(lang) }}</button>
                </div>
                <div class="xp-mark" x-show="rqToMark()">
                  <div class="xp-f">
                    <label class="xp-label" for="xp-rq-ref">{{ "expenses.req.ref" | t(lang) }}</label>
                    <input id="xp-rq-ref" class="input" type="text" autocomplete="off" maxlength="40" x-model="rq.ref" :placeholder="rqRefDefault()" aria-describedby="xp-rq-ref-hint">
                    <p id="xp-rq-ref-hint" class="xp-hint">{{ "expenses.req.ref_hint" | t(lang) }}</p>
                  </div>
                  <button type="button" class="btn-secondary btn-sm" @click="rqMark()">{% icon "send", "size-4" %} <span x-text="plural(rqToMark(), 'req.mark_one', 'req.mark')"></span></button>
                </div>

                <article class="xp-doc" id="xp-request" aria-labelledby="xp-doc-title">
                  <header class="xp-doc-head">
                    <p class="xp-doc-site">{{ site | pick(lang, "title") }} — NETA 65</p>
                    <h4 id="xp-doc-title" class="xp-doc-title">{{ "expenses.req.doc_title" | t(lang) }}</h4>
                    <dl class="xp-doc-meta">
                      <div><dt>{{ "expenses.req.to" | t(lang) }}</dt><dd x-text="funderName(rq.funder)"></dd></div>
                      <div><dt>{{ "expenses.req.from" | t(lang) }}</dt><dd x-text="profileLine() || '—'"></dd></div>
                      <div x-show="prof('email')"><dt>{{ "expenses.req.email" | t(lang) }}</dt><dd x-text="prof('email')"></dd></div>
                      <div><dt>{{ "expenses.req.period" | t(lang) }}</dt><dd x-text="rqPeriodText()"></dd></div>
                      <div><dt>{{ "expenses.req.prepared" | t(lang) }}</dt><dd x-text="todayLong()"></dd></div>
                    </dl>
                  </header>
                  <p class="xp-none" x-show="!rqLines().length && !rqMileage().length">{{ "expenses.req.empty" | t(lang) }}</p>
                  <template x-if="rqLines().length">
                    <div class="xp-doc-sec">
                      <h5 class="xp-doc-h">{{ "expenses.req.lines" | t(lang) }}</h5>
                      <div class="xp-table-wrap" role="region" tabindex="0" aria-label="{{ 'expenses.req.lines' | t(lang) }}">
                        <table class="xp-table xp-doc-table">
                          {#- on a narrow sheet the date, the category and the receipt go under the description (.xp-doc-sub) and
                              their columns step aside (.xp-wide-col): Description | Amount, the amount always in sight — under the
                              words too when even that leaves a word no room (.xp-amt-line, .xp-amt-col: expenses.css) -#}
                          <thead><tr><th scope="col" class="xp-wide-col">{{ "expenses.field.date" | t(lang) }}</th><th scope="col">{{ "expenses.field.description" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.field.category" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.field.receipt" | t(lang) }}</th><th scope="col" class="xp-num xp-amt-col">{{ "expenses.field.amount" | t(lang) }}</th></tr></thead>
                          <tbody><template x-for="l in rqLines()" :key="l.i"><tr><td class="whitespace-nowrap xp-wide-col" x-text="l.date"></td><td><span x-text="l.desc"></span><span class="xp-doc-sub" x-text="[l.date, l.cat, l.hasReceipt ? t('req.receipt_line', { receipt: l.receipt }) : ''].filter(Boolean).join(' · ')"></span><span class="xp-amt-line" x-text="l.amount"></span></td><td class="xp-wide-col" x-text="l.cat"></td><td class="xp-wide-col"><span x-show="l.hasReceipt" aria-hidden="true">✓ </span><span x-text="l.receipt"></span></td><td class="xp-num xp-amt-col" x-text="l.amount"></td></tr></template></tbody>
                        </table>
                      </div>
                    </div>
                  </template>
                  <template x-if="rqMileage().length">
                    <div class="xp-doc-sec">
                      <h5 class="xp-doc-h">{{ "expenses.req.mileage" | t(lang) }}</h5>
                      <div class="xp-table-wrap" role="region" tabindex="0" aria-label="{{ 'expenses.req.mileage' | t(lang) }}">
                        <table class="xp-table xp-doc-table">
                          <thead><tr><th scope="col" class="xp-wide-col">{{ "expenses.field.date" | t(lang) }}</th><th scope="col">{{ "expenses.req.route" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.req.purpose" | t(lang) }}</th><th scope="col" class="xp-num xp-wide-col">{{ "expenses.field.miles" | t(lang) }}</th><th scope="col" class="xp-num xp-wide-col">{{ "expenses.field.rate" | t(lang) }}</th><th scope="col" class="xp-num xp-amt-col">{{ "expenses.field.amount" | t(lang) }}</th></tr></thead>
                          <tbody><template x-for="l in rqMileage()" :key="l.i"><tr><td class="whitespace-nowrap xp-wide-col" x-text="l.date"></td><td><span x-text="l.route"></span><span class="xp-doc-sub" x-text="[l.date, l.purpose !== l.route ? l.purpose : '', t('req.miles_at', { miles: l.miles, rate: l.rate })].filter(Boolean).join(' · ')"></span><span class="xp-amt-line" x-text="l.amount"></span></td><td class="xp-wide-col" x-text="l.purpose"></td><td class="xp-num xp-wide-col" x-text="l.miles"></td><td class="xp-num xp-wide-col" x-text="l.rate"></td><td class="xp-num xp-amt-col" x-text="l.amount"></td></tr></template></tbody>
                        </table>
                      </div>
                    </div>
                  </template>
                  <template x-if="rqLines().length || rqMileage().length">
                    <div class="xp-doc-sec xp-doc-totals">
                      <h5 class="xp-doc-h">{{ "expenses.req.totals" | t(lang) }}</h5>
                      <dl class="xp-totals">
                        <template x-for="c in rqTotals().cats" :key="c.id"><div><dt x-text="c.label"></dt><dd x-text="c.amount"></dd></div></template>
                        <div class="is-total"><dt>{{ "expenses.req.total" | t(lang) }}</dt><dd x-text="rqTotals().total"></dd></div>
                      </dl>
                    </div>
                  </template>
                  <div class="xp-doc-sign">
                    {%- for k in ["sign_submitted", "sign_date", "sign_approved", "sign_paid_date", "sign_check"] %}
                    <p><span class="xp-sign-line"></span>{{ ("expenses.req." + k) | t(lang) }}</p>
                    {%- endfor %}
                  </div>
                  <template x-if="rq.photos && rqPhotos.length">
                    <div class="xp-doc-sec xp-receipts">
                      <h5 class="xp-doc-h">{{ "expenses.req.receipts" | t(lang) }}</h5>
                      <template x-for="p in rqPhotos" :key="p.id"><figure class="xp-receipt"><img :src="p.url" :alt="p.label"><figcaption x-text="p.label"></figcaption></figure></template>
                    </div>
                  </template>
                </article>
              </div>
              </template>
            </div>
          </div>

          {#- the service report (printable): what your service cost, set out as a GVR's own expense report is —
              the money by category, the miles by service activity, every entry if you like, and the total cost
              of service; giveaways and subscriptions counted. For your records, your district or the next GVR:
              a record, not a request (GVX.serviceReport). "Prepared for" and the note are kept with the
              settings; names and notes stay out unless asked, as on a request. -#}
          <div class="xp-box xp-rp-box mt-8" id="xp-report">
            <div class="xp-head">
              <div class="min-w-0 max-w-3xl">
                <h4 class="card-h"><span>{% icon "calendar-range", "size-5" %}</span>{{ "expenses.rep.title" | t(lang) }}</h4>
                <p class="mt-1 text-sm leading-relaxed text-muted">{{ "expenses.rep.sub" | t(lang) }}</p>
              </div>
            </div>
            <div class="xp-rq xp-rp">
              <div class="xp-rq-setup panel-muted">
                <div class="xp-f">
                  <label class="xp-label" for="xp-rp-period">{{ "expenses.f.period" | t(lang) }}</label>
                  <select id="xp-rp-period" class="input xp-select" x-model="rp.period">
                    <template x-for="p in rpPeriods()" :key="p.id"><option :value="p.id" :selected="p.id === rp.period" x-text="p.label"></option></template>
                  </select>
                </div>
                <div class="xp-custom-dates" x-show="rp.period === 'custom'">
                  <div class="xp-f"><label class="xp-label" for="xp-rp-from">{{ "expenses.f.from" | t(lang) }}</label><input id="xp-rp-from" class="input" type="date" x-model="rp.from"></div>
                  <div class="xp-f"><label class="xp-label" for="xp-rp-to">{{ "expenses.f.to" | t(lang) }}</label><input id="xp-rp-to" class="input" type="date" x-model="rp.to"></div>
                </div>
                <div class="xp-f">
                  <label class="xp-label" for="xp-rp-for">{{ "expenses.rep.prepared_for" | t(lang) }}</label>
                  {#- (the example under the field, not in it: a placeholder was cut off at every width) -#}
                  <input id="xp-rp-for" class="input" type="text" autocomplete="off" maxlength="120" :value="repField('prepared_for')" @change="setReport('prepared_for', $event.target.value)" aria-describedby="xp-rp-for-hint">
                  <p id="xp-rp-for-hint" class="xp-hint">{{ "expenses.rep.prepared_for_hint" | t(lang) }}</p>
                </div>
                <div class="xp-f">
                  <label class="xp-label" for="xp-rp-note">{{ "expenses.rep.note" | t(lang) }}</label>
                  <textarea id="xp-rp-note" class="input xp-textarea" rows="3" maxlength="2000" :value="repField('note')" @change="setReport('note', $event.target.value)" aria-describedby="xp-rp-note-hint"></textarea>
                  <p id="xp-rp-note-hint" class="xp-hint">{{ "expenses.rep.note_hint" | t(lang) }}</p>
                </div>
                <fieldset class="xp-f">
                  <legend class="xp-label">{{ "expenses.req.options" | t(lang) }}</legend>
                  <label class="xp-check-line"><input type="checkbox" x-model="rp.detail"><span>{{ "expenses.rep.detail" | t(lang) }}</span></label>
                  <label class="xp-check-line"><input type="checkbox" x-model="rp.names"><span>{{ "expenses.req.names" | t(lang) }}</span></label>
                  <label class="xp-check-line"><input type="checkbox" x-model="rp.notes"><span>{{ "expenses.rep.notes" | t(lang) }}</span></label>
                  <p class="xp-hint">{{ "expenses.rep.names_hint" | t(lang) }}</p>
                </fieldset>
                <p class="xp-hint" x-show="!profileLine()">{{ "expenses.req.profile_hint" | t(lang) }} <button type="button" class="link" @click="go('settings'); setGo('profile')">{{ "expenses.req.profile_link" | t(lang) }}</button></p>
              </div>

              <div class="xp-rq-out">
                <div class="xp-actions">
                  <button type="button" class="btn-primary btn-sm" :disabled="rpView().empty" @click="rpPrint()">{% icon "printer", "size-4" %} {{ "expenses.rep.print" | t(lang) }}</button>
                  <button type="button" class="btn-secondary btn-sm" :disabled="rpView().empty" @click="rpCsv()">{% icon "file-spreadsheet", "size-4" %} {{ "expenses.req.csv" | t(lang) }}</button>
                </div>
                <article class="xp-doc xp-doc-report" id="xp-report-doc" aria-labelledby="xp-rep-title">
                  <header class="xp-doc-head">
                    <p class="xp-doc-site">{{ site | pick(lang, "title") }} — NETA 65</p>
                    <h5 id="xp-rep-title" class="xp-doc-title" x-text="t('rep.doc_title') + ' — ' + rpPeriodLabel()"></h5>
                    <dl class="xp-doc-meta">
                      <div><dt>{{ "expenses.rep.submitted_by" | t(lang) }}</dt><dd x-text="profileLine() || '—'"></dd></div>
                      <div x-show="repField('prepared_for')"><dt>{{ "expenses.rep.prepared_for" | t(lang) }}</dt><dd x-text="repField('prepared_for')"></dd></div>
                      <div><dt>{{ "expenses.req.period" | t(lang) }}</dt><dd x-text="rpView().period"></dd></div>
                      <div><dt>{{ "expenses.rep.prepared" | t(lang) }}</dt><dd x-text="todayLong()"></dd></div>
                      <div x-show="rpView().rates"><dt>{{ "expenses.field.rate" | t(lang) }}</dt><dd x-text="rpView().rates"></dd></div>
                    </dl>
                  </header>
                  <p class="xp-doc-note" x-show="repField('note')" x-text="repField('note')"></p>
                  <p class="xp-none" x-show="rpView().empty">{{ "expenses.rep.empty" | t(lang) }}</p>
                  <template x-if="!rpView().empty">
                  <div>
                    {#- the summary: a line per category of spending and per service activity, the mileage total and
                        the total cost of service -#}
                    <div class="xp-doc-sec">
                      <h6 class="xp-doc-h" id="xp-rep-sum-h">{{ "expenses.rep.summary" | t(lang) }}</h6>
                      <div class="xp-table-wrap" role="region" x-xp-scroll aria-labelledby="xp-rep-sum-h">
                        <table class="xp-table xp-doc-table xp-rep-sum">
                          <thead><tr><th scope="col">{{ "expenses.rep.col_section" | t(lang) }}</th><th scope="col" class="xp-num xp-wide-col">{{ "expenses.field.miles" | t(lang) }}</th><th scope="col" class="xp-num xp-amt-col">{{ "expenses.field.amount" | t(lang) }}</th></tr></thead>
                          <tbody><template x-for="x in rpView().rows" :key="x.key"><tr :class="'is-' + x.kind"><th scope="row"><span x-text="x.label"></span><span class="xp-rep-sub xp-wide-only" x-show="x.trips" x-text="x.trips"></span><span class="xp-doc-sub" x-text="[x.miles, x.trips].filter(Boolean).join(' · ')"></span><span class="xp-amt-line" x-text="x.amount"></span></th><td class="xp-num xp-wide-col" x-text="x.miles || '—'"></td><td class="xp-num xp-amt-col" x-text="x.amount"></td></tr></template></tbody>
                        </table>
                      </div>
                    </div>

                    {#- every entry: a table per category of spending, then a mileage log per service activity (on a
                        narrow sheet the secondary columns go under the first one, as on a request: expenses.css). A
                        table's box is a Tab stop only while it scrolls sideways (x-xp-scroll) -#}
                    <template x-if="rp.detail">
                    <div>
                      <template x-for="s in rpView().money" :key="'m:' + s.key">
                        <div class="xp-doc-sec">
                          <h6 class="xp-doc-h"><span x-text="s.label"></span><span class="xp-doc-h-sum" x-text="s.total"></span></h6>
                          <div class="xp-table-wrap" role="region" x-xp-scroll :aria-label="s.label">
                            <table class="xp-table xp-doc-table xp-rep-money">
                              <thead><tr><th scope="col" class="xp-wide-col">{{ "expenses.rep.col_dates" | t(lang) }}</th><th scope="col">{{ "expenses.field.description" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.rep.col_where" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.rep.col_paid" | t(lang) }}</th><th scope="col" class="xp-num xp-amt-col">{{ "expenses.field.amount" | t(lang) }}</th></tr></thead>
                              <tbody><template x-for="l in s.lines" :key="l.key"><tr>
                                <td class="xp-wide-col xp-rep-dates" x-text="l.dates"></td>
                                <td><span x-text="l.what"></span><span class="xp-rep-sub" x-show="l.event" x-text="l.event"></span><span class="xp-doc-sub" x-text="[l.dates, l.where, l.paid].filter(Boolean).join(' · ')"></span><span class="xp-rep-sub xp-rep-notes" x-show="l.notes" x-text="l.notes"></span><span class="xp-amt-line" x-text="l.amount"></span></td>
                                <td class="xp-wide-col" x-text="l.where"></td>
                                <td class="xp-wide-col" x-text="l.paid"></td>
                                <td class="xp-num xp-amt-col" x-text="l.amount"></td>
                              </tr></template></tbody>
                            </table>
                          </div>
                        </div>
                      </template>
                      <template x-for="s in rpView().miles" :key="'t:' + s.key">
                        <div class="xp-doc-sec">
                          <h6 class="xp-doc-h"><span x-text="s.label"></span><span class="xp-doc-h-sum" x-text="[s.miles, s.trips, s.total].join(' · ')"></span></h6>
                          <div class="xp-table-wrap" role="region" x-xp-scroll :aria-label="s.label">
                            <table class="xp-table xp-doc-table xp-rep-miles">
                              <thead><tr><th scope="col" class="xp-wide-col">{{ "expenses.rep.col_dates" | t(lang) }}</th><th scope="col">{{ "expenses.field.event" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.req.route" | t(lang) }}</th><th scope="col" class="xp-wide-col">{{ "expenses.field.role" | t(lang) }}</th><th scope="col" class="xp-num xp-wide-col">{{ "expenses.rep.col_trips" | t(lang) }}</th><th scope="col" class="xp-num xp-wide-col">{{ "expenses.rep.col_one_way" | t(lang) }}</th><th scope="col" class="xp-num xp-wide-col">{{ "expenses.field.miles" | t(lang) }}</th><th scope="col" class="xp-num xp-amt-col">{{ "expenses.field.amount" | t(lang) }}</th></tr></thead>
                              <tbody><template x-for="l in s.lines" :key="l.key"><tr>
                                <td class="xp-wide-col xp-rep-dates" x-text="l.dates"></td>
                                <td><span x-text="l.what"></span><span class="xp-doc-sub" x-text="[l.dates, l.route, l.role, l.tripLine, l.milesText].filter(Boolean).join(' · ')"></span><span class="xp-rep-sub xp-rep-notes" x-show="l.notes" x-text="l.notes"></span><span class="xp-amt-line" x-text="l.amount"></span></td>
                                <td class="xp-wide-col" x-text="l.route"></td>
                                <td class="xp-wide-col" x-text="l.role"></td>
                                <td class="xp-num xp-wide-col" x-text="l.trips"></td>
                                <td class="xp-num xp-wide-col" x-text="l.oneWay"></td>
                                <td class="xp-num xp-wide-col" x-text="l.miles"></td>
                                <td class="xp-num xp-amt-col" x-text="l.amount"></td>
                              </tr></template></tbody>
                            </table>
                          </div>
                        </div>
                      </template>
                    </div>
                    </template>

                    {#- what was given away and the subscriptions bought, counted (no names) -#}
                    <div class="xp-doc-cols" x-show="rpView().hasGiven || rpView().hasSubs">
                      <div class="xp-doc-sec" x-show="rpView().hasGiven">
                        <h6 class="xp-doc-h">{{ "expenses.rep.given" | t(lang) }}</h6>
                        <dl class="xp-totals">
                          <div><dt><span>{{ "expenses.give.t_given" | t(lang) }}</span> <span class="text-muted" x-show="rpView().given.split" x-text="'(' + rpView().given.split + ')'"></span></dt><dd x-text="rpView().given.total"></dd></div>
                          <template x-for="g in rpView().given.events" :key="g.key"><div><dt x-text="g.name"></dt><dd x-text="g.n"></dd></div></template>
                        </dl>
                      </div>
                      <div class="xp-doc-sec" x-show="rpView().hasSubs">
                        <h6 class="xp-doc-h">{{ "expenses.rep.subs" | t(lang) }}</h6>
                        <dl class="xp-totals">
                          <div><dt><span>{{ "expenses.rep.subs_all" | t(lang) }}</span> <span class="text-muted" x-show="rpView().subsSplit" x-text="'(' + rpView().subsSplit + ')'"></span></dt><dd x-text="rpView().subsTotal"></dd></div>
                          <template x-for="x in rpView().subs" :key="x.key"><div><dt x-text="x.label"></dt><dd x-text="x.n"></dd></div></template>
                        </dl>
                      </div>
                    </div>

                    {#- who covers it: what you gave yourself, what you asked back, what came back, what is still owed -#}
                    <div class="xp-doc-sec">
                      <h6 class="xp-doc-h">{{ "expenses.rep.who_covers" | t(lang) }}</h6>
                      <dl class="xp-totals"><template x-for="x in rpView().totals" :key="x.key"><div><dt x-text="x.label"></dt><dd x-text="x.value"></dd></div></template></dl>
                    </div>
                  </div>
                  </template>
                  <div class="xp-doc-sign xp-doc-sign-pairs">
                    {%- for k in ["req.sign_submitted", "req.sign_date", "rep.sign_received", "req.sign_date"] %}
                    <p><span class="xp-sign-line"></span>{{ ("expenses." + k) | t(lang) }}</p>
                    {%- endfor %}
                  </div>
                </article>
              </div>
            </div>
          </div>
        </div>
        </template>
      </section>

      {#- ================= 5. Settings: every list editable ================= -#}
      {#- (a tab's word is its panel's heading, expenses.set.<id> — or a shorter one of its own, `tab`: "Activities"
          for "Service activities"; from 1024px the ten tabs sit in two rows of five: expenses.css) -#}
      {%- set setTabs = [
        { id: "data", icon: "hard-drive" }, { id: "profile", icon: "user-round" }, { id: "categories", icon: "tag" },
        { id: "funders", icon: "users" }, { id: "methods", icon: "wallet" }, { id: "activities", icon: "calendar-range", tab: "tab_activities" }, { id: "mileage", icon: "car" },
        { id: "budgets", icon: "piggy-bank" }, { id: "fields", icon: "list-plus" }, { id: "reminders", icon: "bell" }
      ] -%}
      <section role="tabpanel" id="xp-panel-settings" aria-labelledby="xp-tab-settings" class="xp-panel" x-show="view === 'settings'" tabindex="-1">
        <template x-if="view === 'settings'">
        <div class="xp-pad xp-set-pad">
          <div class="chip-row xp-set-nav" role="group" aria-label="{{ 'expenses.set.nav_label' | t(lang) }}">
            {%- for s in setTabs %}
            <button type="button" class="chip" :aria-pressed="setTab === '{{ s.id }}' ? 'true' : 'false'" @click="setGo('{{ s.id }}')">{% icon s.icon, "size-4 shrink-0" %}{{ ("expenses.set." + (s.tab or s.id)) | t(lang) }}</button>
            {%- endfor %}
          </div>

          {#- ---- Data: export, import, examples, erase, storage ---- -#}
          <template x-if="setTab === 'data'">
          <div class="xp-set">
            <h3 class="card-h"><span>{% icon "hard-drive", "size-5" %}</span>{{ "expenses.set.data" | t(lang) }}</h3>
            <p class="xp-set-intro">{{ "expenses.data.intro" | t(lang) }}</p>
            <dl class="xp-facts">
              <div><dt>{{ "expenses.aside.entries" | t(lang) }}</dt><dd x-text="count(E().length)"></dd></div>
              <div><dt>{{ "expenses.data.size" | t(lang) }}</dt><dd x-text="t('data.kb', { n: count(storageKb()) }) + (usageText() ? ' · ' + usageText() : '')"></dd></div>
              <div><dt>{{ "expenses.aside.last_backup" | t(lang) }}</dt><dd x-text="lastBackupText()"></dd></div>
              <div><dt>{{ "expenses.aside.protected" | t(lang) }}</dt><dd x-text="persisted ? t('aside.yes') : t('aside.no')"></dd></div>
            </dl>
            <p class="xp-hint" x-show="!persisted">{{ "expenses.data.protected_hint" | t(lang) }}</p>

            <div class="xp-set-grid">
              {#- export: the CSV; the full backup (.zip: each receipt photo a file of its own) or the ledger alone
                  (.json "without photos") — their sizes worked out first (again after each change while this
                  tab is open: rev), and a big one said so -#}
              <div class="xp-box" x-effect="rev, measureBackup()">
                <h4 class="xp-h4">{{ "expenses.data.export_title" | t(lang) }}</h4>
                <p class="mt-1 text-sm text-muted">{{ "expenses.data.export_text" | t(lang) }}</p>
                <div class="xp-actions mt-3">
                  <button type="button" class="btn-primary btn-sm" @click="exportAll()">{% icon "file-spreadsheet", "size-4" %} {{ "expenses.data.export_csv" | t(lang) }}</button>
                  <button type="button" class="btn-secondary btn-sm" @click="exportBackup()">{% icon "hard-drive-download", "size-4" %} {{ "expenses.data.export_backup" | t(lang) }}</button>
                  <button type="button" class="btn-ghost btn-sm" @click="exportBackup('plain')">{% icon "file-text", "size-4" %} {{ "expenses.data.export_plain" | t(lang) }}</button>
                </div>
                <p class="xp-hint" x-show="bk.ready && E().length" x-text="bkLine()"></p>
                <p class="xp-hint xp-hint-warn" x-show="bkBig()">{{ "expenses.data.big" | t(lang) }}</p>
              </div>

              <div class="xp-box">
                <h4 class="xp-h4" id="xp-imp-title">{{ "expenses.imp.title" | t(lang) }}</h4>
                <p class="mt-1 text-sm text-muted">{{ "expenses.imp.text" | t(lang) }}</p>
                {#- step 1: a file (picker or drop) -#}
                <template x-if="!imp || imp.step === 'pick' || imp.err">
                  <div>
                    <label class="xp-drop" :class="{ 'is-over': dragOver }" @dragover.prevent="dragOver = true" @dragleave="dragOver = false" @drop.prevent="impDrop($event)">
                      {#- several at once: an unpacked backup's backup.json with its photos -#}
                      <input type="file" class="sr-only" multiple accept=".csv,.tsv,.txt,.json,.zip,.xlsx,.jpg,.jpeg,.png,.webp,.gif,text/csv,application/json,application/zip,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" @change="impPick($event)">
                      {% icon "upload", "size-6" %}
                      <span class="font-semibold text-ink">{{ "expenses.imp.choose" | t(lang) }}</span>
                      <span class="text-sm text-muted">{{ "expenses.imp.drop" | t(lang) }}</span>
                    </label>
                    <p class="xp-err mt-2" role="alert" x-show="imp && imp.err"><span x-text="imp && imp.name ? imp.name + ': ' : ''"></span><span x-text="imp ? imp.err : ''"></span></p>
                  </div>
                </template>
                {#- step 2 (a spreadsheet of another shape): which column is which -#}
                <template x-if="imp && imp.step === 'map' && !imp.err">
                  <div class="xp-imp">
                    <p class="text-sm text-ink"><strong x-text="imp.name"></strong> — {{ "expenses.imp.map_intro" | t(lang) }}</p>
                    <div class="xp-imp-map">
                      {%- for m in ["date", "description", "amount", "category", "miles", "notes"] %}
                      <div class="xp-f">
                        <label class="xp-label" for="xp-map-{{ m }}">{{ ("expenses.imp.map_" + m) | t(lang) }}{% if m == "date" %} <span class="text-danger" aria-hidden="true">*</span>{% elif m in ["amount", "miles"] %} <span class="text-danger" aria-hidden="true">†</span>{% endif %}</label>
                        <select id="xp-map-{{ m }}" class="input xp-select" x-model="imp.map.{{ m }}"{% if m == "date" %} aria-required="true"{% elif m in ["amount", "miles"] %} aria-describedby="xp-map-needs"{% endif %}>
                          <option value="">{{ "expenses.imp.map_none" | t(lang) }}</option>
                          <template x-for="h in imp.headers" :key="h.i"><option :value="String(h.i)" :selected="String(h.i) === imp.map.{{ m }}" x-text="h.name"></option></template>
                        </select>
                      </div>
                      {%- endfor %}
                    </div>
                    <p class="xp-hint" id="xp-map-needs">{{ "expenses.imp.map_needs" | t(lang) }}</p>
                    <p class="xp-hint">{{ "expenses.imp.map_rest" | t(lang) }}</p>
                    <div class="xp-table-wrap mt-3" role="region" tabindex="0" aria-label="{{ 'expenses.imp.sample' | t(lang) }}">
                      <table class="xp-table xp-table-sm">
                        <thead><tr><template x-for="h in imp.headers" :key="h.i"><th scope="col" x-text="h.name"></th></template></tr></thead>
                        <tbody><template x-for="(r, ri) in imp.sample" :key="ri"><tr><template x-for="(c, ci) in r" :key="ci"><td x-text="c"></td></template></tr></template></tbody>
                      </table>
                    </div>
                    <div class="xp-actions mt-4">
                      <button type="button" class="btn-primary btn-sm" :disabled="!impMapReady()" @click="impUseMap()">{% icon "arrow-right", "size-4" %} {{ "expenses.imp.map_next" | t(lang) }}</button>
                      <button type="button" class="btn-ghost btn-sm" @click="impReset()">{{ "expenses.imp.cancel" | t(lang) }}</button>
                    </div>
                  </div>
                </template>
                {#- step 3: the preview (nothing is saved yet) -#}
                <template x-if="imp && imp.step === 'preview' && !imp.err">
                  <div class="xp-imp">
                    <p class="text-sm text-ink"><strong x-text="imp.name"></strong></p>
                    <ul class="xp-imp-counts" role="list">
                      <li><strong x-text="count(imp.counts.add)"></strong> {{ "expenses.imp.new" | t(lang) }}</li>
                      <li><strong x-text="count(imp.counts.update)"></strong> {{ "expenses.imp.updated" | t(lang) }}</li>
                      <li><strong x-text="count(imp.counts.dup)"></strong> {{ "expenses.imp.duplicates" | t(lang) }}</li>
                      <li><strong x-text="count(imp.counts.same + imp.counts.older)"></strong> {{ "expenses.imp.unchanged" | t(lang) }}</li>
                      <li :class="imp.counts.errors ? 'text-danger' : ''"><strong x-text="count(imp.counts.errors)"></strong> {{ "expenses.imp.errors" | t(lang) }}</li>
                    </ul>
                    <div class="xp-imp-opts">
                      <div class="xp-f">
                        <label class="xp-label" for="xp-imp-dates">{{ "expenses.imp.date_order" | t(lang) }}</label>
                        <select id="xp-imp-dates" class="input xp-select" x-model="imp.opts.dateOrder" @change="impPlan()">
                          <option value="mdy">{{ "expenses.imp.mdy" | t(lang) }}</option>
                          <option value="dmy">{{ "expenses.imp.dmy" | t(lang) }}</option>
                        </select>
                      </div>
                      <div class="xp-f">
                        <label class="xp-label" for="xp-imp-dec">{{ "expenses.imp.decimal" | t(lang) }}</label>
                        <select id="xp-imp-dec" class="input xp-select" x-model="imp.opts.decimal" @change="impPlan()">
                          <option value="auto">{{ "expenses.imp.dec_auto" | t(lang) }}</option>
                          <option value=".">{{ "expenses.imp.dec_dot" | t(lang) }}</option>
                          <option value=",">{{ "expenses.imp.dec_comma" | t(lang) }}</option>
                        </select>
                      </div>
                      {#- somebody else's sheet: are its amounts with no minus spending (a card statement) or money in (a bank account)? -#}
                      <div class="xp-f" x-show="imp.signs">
                        <label class="xp-label" for="xp-imp-sign">{{ "expenses.imp.positive" | t(lang) }}</label>
                        <select id="xp-imp-sign" class="input xp-select" x-model="imp.opts.positive" @change="impPlan()" aria-describedby="xp-imp-sign-hint">
                          <option value="spent">{{ "expenses.imp.pos_spent" | t(lang) }}</option>
                          <option value="received">{{ "expenses.imp.pos_received" | t(lang) }}</option>
                        </select>
                        <p class="xp-hint" id="xp-imp-sign-hint">{{ "expenses.imp.positive_hint" | t(lang) }}</p>
                      </div>
                    </div>
                    <label class="xp-check-line" x-show="imp.counts.dup"><input type="checkbox" x-model="imp.opts.includeDuplicates" @change="impPlan()"><span>{{ "expenses.imp.include_dups" | t(lang) }}</span></label>
