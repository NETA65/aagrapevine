                        <select class="input xp-select xp-select-sm" :id="'xp-mgm-' + x.id"><template x-for="y in mergeTargets('methods', x.id)" :key="y.id"><option :value="y.id" x-text="lbl(y.name)"></option></template></select>
                        <button type="button" class="btn-secondary btn-sm" @click="merge('methods', x.id, document.getElementById('xp-mgm-' + x.id).value)">{% icon "merge", "size-4" %} {{ "expenses.set.merge" | t(lang) }}</button>
                      </span>
                    </template>
                  </div>
                </li>
              </template>
            </ul>
            <button type="button" class="btn-secondary btn-sm mt-4" @click="addMethod()">{% icon "plus", "size-4" %} {{ "expenses.set.add_method" | t(lang) }}</button>
          </div>
          </template>

          {#- ---- Service activities: the kinds of service an entry is for (the service report's sections) ---- -#}
          <template x-if="setTab === 'activities'">
          <div class="xp-set">
            <h3 class="card-h"><span>{% icon "calendar-range", "size-5" %}</span>{{ "expenses.set.activities" | t(lang) }}</h3>
            <p class="xp-set-intro">{{ "expenses.set.activities_intro" | t(lang) }}</p>
            <ul class="xp-items mt-4" role="list">
              <template x-for="(x, i) in list('activities')" :key="x.id">
                <li class="xp-item" :class="{ 'is-hidden': x.hidden }">
                  <div class="xp-item-row xp-item-row-edit">
                    <div class="xp-f xp-grow">
                      <label class="xp-label" :for="'xp-s-act-' + x.id">{{ "expenses.set.name" | t(lang) }}</label>
                      <input class="input" type="text" maxlength="80" :id="'xp-s-act-' + x.id" :value="lbl(x.name)" @change="setName('activities', x.id, 'name', $event.target.value)">
                    </div>
                    <span class="xp-move">
                      <button type="button" class="xp-icon-btn" data-move="up" :data-id="x.id" :aria-disabled="i === 0 ? 'true' : 'false'" :aria-label="t('set.move_up', { name: lbl(x.name) })" @click="i > 0 && move('activities', x.id, -1)">{% icon "arrow-up", "size-4" %}</button>
                      <button type="button" class="xp-icon-btn" data-move="down" :data-id="x.id" :aria-disabled="i === list('activities').length - 1 ? 'true' : 'false'" :aria-label="t('set.move_down', { name: lbl(x.name) })" @click="move('activities', x.id, 1)">{% icon "arrow-down", "size-4" %}</button>
                    </span>
                  </div>
                  <div class="xp-item-foot">
                    <span class="text-xs text-muted" x-text="plural(usedCount('activity', x.id), 'set.used_one', 'set.used')"></span>
                    <label class="xp-check-line"><input type="checkbox" :checked="!!x.hidden" @change="setField('activities', x.id, 'hidden', $event.target.checked)"><span>{{ "expenses.set.hide" | t(lang) }}</span></label>
                    <button type="button" class="btn-ghost btn-sm xp-danger" x-show="canDelete('activities', x.id)" @click="del('activities', x.id)">{% icon "trash-2", "size-4" %} {{ "expenses.set.delete" | t(lang) }}</button>
                    <template x-if="usedCount('activity', x.id) && mergeTargets('activities', x.id).length">
                      <span class="xp-merge">
                        <label class="xp-merge-l" :for="'xp-mga-' + x.id">{{ "expenses.set.merge_into" | t(lang) }}</label>
                        <select class="input xp-select xp-select-sm" :id="'xp-mga-' + x.id"><template x-for="y in mergeTargets('activities', x.id)" :key="y.id"><option :value="y.id" x-text="lbl(y.name)"></option></template></select>
                        <button type="button" class="btn-secondary btn-sm" @click="merge('activities', x.id, document.getElementById('xp-mga-' + x.id).value)">{% icon "merge", "size-4" %} {{ "expenses.set.merge" | t(lang) }}</button>
                      </span>
                    </template>
                  </div>
                </li>
              </template>
            </ul>
            <button type="button" class="btn-secondary btn-sm mt-4" @click="addActivity()">{% icon "plus", "size-4" %} {{ "expenses.set.add_activity" | t(lang) }}</button>
            <p class="xp-hint mt-2">{{ "expenses.set.activities_note" | t(lang) }}</p>
          </div>
          </template>

          {#- ---- Mileage: rates and saved places ---- -#}
          <template x-if="setTab === 'mileage'">
          <div class="xp-set">
            <h3 class="card-h"><span>{% icon "car", "size-5" %}</span>{{ "expenses.set.mileage" | t(lang) }}</h3>
            <p class="xp-set-intro">{{ "expenses.set.rates_intro" | t(lang) }}</p>
            <ul class="xp-items mt-4" role="list">
              <template x-for="r in list('rates')" :key="r.id">
                <li class="xp-item">
                  <div class="xp-item-row xp-item-row-edit">
                    <div class="xp-f xp-grow">
                      <label class="xp-label" :for="'xp-s-rate-' + r.id">{{ "expenses.set.name" | t(lang) }}</label>
                      <input class="input" type="text" maxlength="80" :id="'xp-s-rate-' + r.id" :value="lbl(r.name)" @change="setName('rates', r.id, 'name', $event.target.value)" :aria-describedby="r.note ? 'xp-s-rn-' + r.id : null">
                      <p class="xp-hint" :id="'xp-s-rn-' + r.id" x-show="r.note" x-text="lbl(r.note)"></p>
                    </div>
                    <div class="xp-f xp-f-rate">
                      <label class="xp-label" :for="'xp-s-rv-' + r.id">{{ "expenses.set.rate_value" | t(lang) }}</label>
                      <span class="xp-money"><span aria-hidden="true">$</span><input class="input" type="text" inputmode="decimal" autocomplete="off" maxlength="6" :id="'xp-s-rv-' + r.id" :value="r.rate" placeholder="0.14" @change="setRate(r.id, $event.target.value)"></span>
                    </div>
                  </div>
                  <div class="xp-item-foot">
                    <label class="xp-check-line"><input type="radio" name="xp-default-rate" :checked="defaultRate().id === r.id" @change="setDefaultRate(r.id)"><span>{{ "expenses.set.default_rate" | t(lang) }}</span></label>
                    <button type="button" class="btn-ghost btn-sm xp-danger" x-show="canDelete('rates', r.id)" @click="del('rates', r.id)">{% icon "trash-2", "size-4" %} {{ "expenses.set.delete" | t(lang) }}</button>
                  </div>
                </li>
              </template>
            </ul>
            <button type="button" class="btn-secondary btn-sm mt-4" @click="addRate()">{% icon "plus", "size-4" %} {{ "expenses.set.add_rate" | t(lang) }}</button>
            <p class="xp-hint mt-2">{{ "expenses.set.rates_note" | t(lang) }}</p>

            <h4 class="xp-h4 mt-8">{{ "expenses.set.places" | t(lang) }}</h4>
            <p class="mt-1 text-sm text-muted">{{ "expenses.set.places_intro" | t(lang) }}</p>
            <ul class="xp-items mt-3" role="list">
              <template x-for="(p, i) in list('places')" :key="i + ':' + p">
                <li class="xp-item">
                  <div class="xp-item-row xp-item-row-edit">
                    <div class="xp-f xp-grow">
                      <label class="sr-only" :for="'xp-pl-' + i" x-text="t('set.place_n', { n: i + 1 })"></label>
                      <input class="input" type="text" maxlength="80" :id="'xp-pl-' + i" :value="p" @change="setPlace(i, $event.target.value)">
                    </div>
                    <span class="xp-move">
                      <button type="button" class="xp-icon-btn" :aria-disabled="i === 0 ? 'true' : 'false'" :aria-label="t('set.move_up', { name: p })" @click="movePlace(i, -1)">{% icon "arrow-up", "size-4" %}</button>
                      <button type="button" class="xp-icon-btn" :aria-disabled="i === list('places').length - 1 ? 'true' : 'false'" :aria-label="t('set.move_down', { name: p })" @click="movePlace(i, 1)">{% icon "arrow-down", "size-4" %}</button>
                      <button type="button" class="xp-icon-btn xp-danger" :aria-label="t('set.remove', { name: p })" @click="delPlace(i)">{% icon "x", "size-4" %}</button>
                    </span>
                  </div>
                </li>
              </template>
            </ul>
            <form class="xp-add-row" @submit.prevent="addPlace()">
              <label class="xp-label" for="xp-new-place">{{ "expenses.set.add_place" | t(lang) }}</label>
              <input id="xp-new-place" class="input" type="text" maxlength="80" autocomplete="off" x-model="newPlace" placeholder="{{ 'expenses.set.place_ph' | t(lang) }}">
              <button type="submit" class="btn-secondary btn-sm">{% icon "plus", "size-4" %} {{ "expenses.set.add" | t(lang) }}</button>
            </form>
          </div>
          </template>

          {#- ---- Budgets ---- -#}
          <template x-if="setTab === 'budgets'">
          <div class="xp-set">
            <h3 class="card-h"><span>{% icon "piggy-bank", "size-5" %}</span>{{ "expenses.set.budgets" | t(lang) }}</h3>
            <p class="xp-set-intro">{{ "expenses.set.budgets_intro" | t(lang) }}</p>
            <ul class="xp-items mt-4" role="list">
              <template x-for="b in list('budgets')" :key="b.id">
                <li class="xp-item">
                  <div class="xp-form-grid">
                    <div class="xp-f">
                      <label class="xp-label" :for="'xp-s-bud-' + b.id">{{ "expenses.set.budget_label" | t(lang) }}</label>
                      <input class="input" type="text" maxlength="80" :id="'xp-s-bud-' + b.id" :value="b.label" @change="setField('budgets', b.id, 'label', $event.target.value.trim())">
                    </div>
                    <div class="xp-f">
                      <label class="xp-label" :for="'xp-s-budf-' + b.id">{{ "expenses.field.funder" | t(lang) }}</label>
                      <select class="input xp-select" :id="'xp-s-budf-' + b.id" @change="setField('budgets', b.id, 'funder', $event.target.value)">
                        <template x-for="x in funders(b.funder)" :key="x.id"><option :value="x.id" :selected="x.id === b.funder" x-text="lbl(x.name)"></option></template>
                      </select>
                    </div>
                    <div class="xp-f">
                      <label class="xp-label" :for="'xp-s-budy-' + b.id">{{ "expenses.set.budget_year" | t(lang) }}</label>
                      <input class="input" type="number" inputmode="numeric" min="2000" max="2100" :id="'xp-s-budy-' + b.id" :value="b.year" @change="setField('budgets', b.id, 'year', Number($event.target.value) || new Date().getFullYear())">
                    </div>
                    <div class="xp-f">
                      <label class="xp-label" :for="'xp-s-buda-' + b.id">{{ "expenses.set.budget_amount" | t(lang) }}</label>
                      <span class="xp-money"><span aria-hidden="true">$</span><input class="input" type="text" inputmode="decimal" autocomplete="off" :id="'xp-s-buda-' + b.id" :value="(b.amount_cents / 100).toFixed(2)" @change="setBudgetAmount(b.id, $event.target.value)"></span>
                    </div>
                  </div>
                  <div class="xp-item-foot"><button type="button" class="btn-ghost btn-sm xp-danger" @click="delBudget(b.id)">{% icon "trash-2", "size-4" %} {{ "expenses.set.delete" | t(lang) }}</button></div>
                </li>
              </template>
            </ul>
            <button type="button" class="btn-secondary btn-sm mt-4" @click="addBudget()">{% icon "plus", "size-4" %} {{ "expenses.set.add_budget" | t(lang) }}</button>
          </div>
          </template>

          {#- ---- Custom fields ---- -#}
          <template x-if="setTab === 'fields'">
          <div class="xp-set">
            <h3 class="card-h"><span>{% icon "list-plus", "size-5" %}</span>{{ "expenses.set.fields" | t(lang) }}</h3>
            <p class="xp-set-intro">{{ "expenses.set.fields_intro" | t(lang) }}</p>
            <ul class="xp-items mt-4" role="list">
              <template x-for="c in list('custom_fields')" :key="c.id">
                <li class="xp-item">
                  <div class="xp-form-grid">
                    <div class="xp-f">
                      <label class="xp-label" :for="'xp-s-cf-' + c.id">{{ "expenses.set.label" | t(lang) }}</label>
                      <input class="input" type="text" maxlength="60" :id="'xp-s-cf-' + c.id" :value="c.label" @change="setName('custom_fields', c.id, 'label', $event.target.value)">
                    </div>
                    <div class="xp-f">
                      <label class="xp-label" :for="'xp-s-cft-' + c.id">{{ "expenses.set.field_type" | t(lang) }}</label>
                      <select class="input xp-select" :id="'xp-s-cft-' + c.id" @change="setField('custom_fields', c.id, 'type', $event.target.value)">
                        {%- for k in ["text", "number", "date", "yesno", "choice"] %}<option value="{{ k }}" :selected="c.type === '{{ k }}'">{{ ("expenses.cf_type." + k) | t(lang) }}</option>{% endfor %}
                      </select>
                    </div>
                    <div class="xp-f" x-show="c.type === 'choice'">
                      <label class="xp-label" :for="'xp-s-cfo-' + c.id">{{ "expenses.set.field_options" | t(lang) }}</label>
                      <input class="input" type="text" :id="'xp-s-cfo-' + c.id" :value="(c.options || []).join(', ')" @change="setOptions(c.id, $event.target.value)" :aria-describedby="'xp-s-cfo-h-' + c.id">
                      <p class="xp-hint" :id="'xp-s-cfo-h-' + c.id">{{ "expenses.set.field_options_hint" | t(lang) }}</p>
                    </div>
                  </div>
                  <fieldset class="xp-f mt-3">
                    <legend class="xp-label">{{ "expenses.set.field_types" | t(lang) }}</legend>
                    <div class="xp-checks">
                      {%- for ty in typeList %}
                      <label class="xp-check-line"><input type="checkbox" :checked="(c.types || []).indexOf('{{ ty.id }}') !== -1" @change="toggleCfType(c.id, '{{ ty.id }}')"><span>{{ ("expenses.type." + ty.id) | t(lang) }}</span></label>
                      {%- endfor %}
                    </div>
                  </fieldset>
                  <div class="xp-item-foot"><button type="button" class="btn-ghost btn-sm xp-danger" @click="delCustom(c.id)">{% icon "trash-2", "size-4" %} {{ "expenses.set.delete" | t(lang) }}</button></div>
                </li>
              </template>
            </ul>
            <button type="button" class="btn-secondary btn-sm mt-4" @click="addCustom()">{% icon "plus", "size-4" %} {{ "expenses.set.add_field" | t(lang) }}</button>
            <p class="xp-hint mt-2">{{ "expenses.set.fields_examples" | t(lang) }}</p>
          </div>
          </template>

          {#- ---- Reminders ---- -#}
          <template x-if="setTab === 'reminders'">
          <div class="xp-set">
            <h3 class="card-h"><span>{% icon "bell", "size-5" %}</span>{{ "expenses.set.reminders" | t(lang) }}</h3>
            <p class="xp-set-intro">{{ "expenses.set.reminders_intro" | t(lang) }}</p>
            <div class="xp-form-grid mt-4">
              {%- for k in ["renewal_days", "backup_reminder_days"] %}
              <div class="xp-f">
                <label class="xp-label" for="xp-s-{{ k }}">{{ ("expenses.set." + k) | t(lang) }}</label>
                <input id="xp-s-{{ k }}" class="input" type="number" inputmode="numeric" min="1" max="365" :value="st().{{ k }}" @change="setDays('{{ k }}', $event.target.value)" aria-describedby="xp-s-{{ k }}-h">
                <p id="xp-s-{{ k }}-h" class="xp-hint">{{ ("expenses.set." + k + "_hint") | t(lang) }}</p>
              </div>
              {%- endfor %}
            </div>
          </div>
          </template>
        </div>
        </template>
      </section>

      {#- the same facts as the hero's aside, where that aside is not shown (phones, larger text) -#}
      <p class="xp-device">
        {% icon "lock", "size-4 shrink-0" %}
        <span>{{ "expenses.device.saved_here" | t(lang) }}</span>
        <span x-text="t('device.line', { n: count(E().length), when: lastBackupText() })"></span>
        <button type="button" class="link" @click="exportBackup()">{{ "expenses.aside.backup_now" | t(lang) }}</button>
      </p>
    </div>
    </template>
  </div>
</section>

{#- ============ The add / edit dialog ============ -#}
{%- macro fi(name, labelKey, lang, o) -%}
{%- set o = o or {} -%}
<div class="xp-f{{ (' ' ~ o.cls) if o.cls }}"{% if o.show %} x-show="{{ o.show }}"{% endif %}>
  <label class="xp-label" for="xp-f-{{ name }}">{{ labelKey | t(lang) }}{% if o.req %} <span class="xp-req" aria-hidden="true">*</span>{% endif %}</label>
  {%- if o.money %}<span class="xp-money"><span aria-hidden="true">$</span>{% endif %}
  <input id="xp-f-{{ name }}" class="input" type="{{ o.type or 'text' }}"{% if o.im %} inputmode="{{ o.im }}"{% endif %}{% if o.list %} list="{{ o.list }}"{% endif %} autocomplete="off"{% if o.max %} maxlength="{{ o.max }}"{% endif %}{% if o.min %} min="{{ o.min }}"{% endif %}{% if o.ph %} placeholder="{{ o.ph | t(lang) }}"{% endif %}{% if o.req %} aria-required="true"{% endif %} x-model="form.{{ name }}" :aria-invalid="errText('{{ name }}') ? 'true' : null" aria-describedby="xp-e-{{ name }}{{ (' xp-h-' ~ name) if o.hint }}">
  {%- if o.money %}</span>{% endif %}
  {%- if o.hint %}<p id="xp-h-{{ name }}" class="xp-hint">{{ o.hint | t(lang) }}</p>{% endif %}
  <p id="xp-e-{{ name }}" class="xp-err" x-show="errText('{{ name }}')" x-text="errText('{{ name }}')"></p>
</div>
{%- endmacro -%}
{%- set typeTone = { expense: "gv", mileage: "grape", received: "vine", giveaway: "rose", stock: "teal" } -%}
<dialog x-ref="dlg" class="xp-dialog" aria-labelledby="xp-dlg-title" @cancel.prevent="tryClose()" @close="formClosed()">
  <template x-if="form">
  <div class="xp-dlg">
    <header class="xp-dlg-head">
      <button type="button" class="xp-icon-btn" x-show="formStep === 2 && formMode === 'add'" @click="backToTypes()" :aria-label="t('form.back')">{% icon "arrow-left", "size-5" %}</button>
      <h2 id="xp-dlg-title" class="xp-dlg-title" x-text="formTitle()"></h2>
      <button type="button" class="xp-icon-btn" @click="tryClose()" :aria-label="t('form.close')">{% icon "x", "size-5" %}</button>
    </header>
    <p class="xp-dlg-msg" role="status" x-text="dlgMsg"></p>

    {#- step 1: what are you recording? -#}
    <div class="xp-dlg-body" x-show="formStep === 1">
      <fieldset>
        <legend class="xp-lead">{{ "expenses.form.what_intro" | t(lang) }}</legend>
        <div class="xp-types">
          {%- for ty in typeList %}
          <button type="button" class="xp-type"{% if loop.first %} data-type-btn{% endif %} @click="chooseType('{{ ty.id }}')">
            <span class="xp-type-i xp-tone-{{ typeTone[ty.id] }}">{% icon ty.icon, "size-6" %}</span>
            <span class="min-w-0"><span class="xp-type-t">{{ ("expenses.type_add." + ty.id) | t(lang) }}</span><span class="xp-type-h">{{ ("expenses.type_hint." + ty.id) | t(lang) }}</span></span>
          </button>
          {%- endfor %}
        </div>
      </fieldset>
    </div>

    {#- step 2: the fields of the category's template -#}
    {#- (every input and change: closing the tab asks first while something is unsaved — armLeave) -#}
    <form id="xp-form" class="xp-dlg-body" x-show="formStep === 2" novalidate @submit.prevent="saveForm(false)" @input="armLeave()" @change="armLeave()">
      <div id="xp-form-errors" class="xp-errsum" tabindex="-1" x-show="formErrs.length" role="alert">
        <p class="font-semibold">{% icon "triangle-alert", "size-4 inline -mt-0.5" %} {{ "expenses.form.errors_title" | t(lang) }}</p>
        <ul role="list"><template x-for="e in formErrs" :key="e.field"><li><button type="button" class="link" @click="errFocus(e.field)" x-text="e.text"></button></li></template></ul>
      </div>
      <p class="xp-banner xp-banner-sm" x-show="form.example">{% icon "sparkles", "size-4 shrink-0" %}<span>{{ "expenses.form.is_example" | t(lang) }}</span></p>

      <div class="xp-form-grid">
        {#- category (when the type has more than one) -#}
        <div class="xp-f xp-span" x-show="cats(form.type, form.category).length > 1">
          <label class="xp-label" for="xp-f-category">{{ "expenses.field.category" | t(lang) }}</label>
          <select id="xp-f-category" class="input xp-select" @change="form.category = $event.target.value; onCat()" :aria-invalid="errText('category') ? 'true' : null" aria-describedby="xp-e-category">
            <template x-for="c in cats(form.type, form.category)" :key="c.id"><option :value="c.id" :selected="c.id === form.category" x-text="lbl(c.label)"></option></template>
          </select>
          <p id="xp-e-category" class="xp-err" x-show="errText('category')" x-text="errText('category')"></p>
        </div>

        {#- dates (a hotel: check-in / check-out, and the nights; a trip over several days: its last day) -#}
        <div class="xp-f">
          <label class="xp-label" for="xp-f-date" x-text="has('lodging') ? t('field.check_in') : t('field.date')"></label>
          <input id="xp-f-date" class="input" type="date" x-model="form.date" aria-required="true" :aria-invalid="errText('date') ? 'true' : null" aria-describedby="xp-e-date">
          <p id="xp-e-date" class="xp-err" x-show="errText('date')" x-text="errText('date')"></p>
        </div>
        <div class="xp-f" x-show="has('end_date')">
          <label class="xp-label" for="xp-f-end_date" x-text="has('lodging') ? t('field.check_out') : t('field.last_day')"></label>
          <input id="xp-f-end_date" class="input" type="date" x-model="form.end_date" :min="form.date" :aria-invalid="errText('end_date') ? 'true' : null" aria-describedby="xp-e-end_date xp-h-nights">
          <p id="xp-h-nights" class="xp-hint" x-text="has('lodging') ? nights() : t('form.last_day_hint')"></p>
          <p id="xp-e-end_date" class="xp-err" x-show="errText('end_date')" x-text="errText('end_date')"></p>
        </div>

        {#- miles driven — or "I didn't drive" (rode with someone): the event and your role on record, no
            miles and nothing to ask back -#}
        <template x-if="tpl() === 'mileage'">
        <div class="xp-span xp-form-grid">
          <div class="xp-f xp-span">
            <label class="xp-check-line"><input id="xp-f-no_miles" type="checkbox" x-model="form.no_miles" aria-describedby="xp-h-no_miles"><span>{{ "expenses.field.no_miles" | t(lang) }}</span></label>
            <p id="xp-h-no_miles" class="xp-hint" x-text="form.no_miles ? t('form.no_miles_hint') : ''"></p>
          </div>
          <template x-if="form.no_miles">
            <div class="xp-f xp-span">
              <label class="xp-label" for="xp-f-person">{{ "expenses.field.rode_with" | t(lang) }}</label>
              <input id="xp-f-person" class="input" type="text" list="xp-dl-person" autocomplete="off" maxlength="60" x-model="form.person" aria-describedby="xp-h-person">
              <p id="xp-h-person" class="xp-hint">{{ "expenses.form.rode_hint" | t(lang) }}</p>
            </div>
          </template>
          <template x-if="!form.no_miles">
          <div class="xp-span xp-form-grid">
            {{ fi("from", "expenses.field.from", lang, { list: "xp-dl-place", max: 120, ph: "expenses.form.from_ph" }) }}
            {{ fi("to", "expenses.field.to", lang, { list: "xp-dl-place", max: 120, ph: "expenses.form.to_ph" }) }}
            <div class="xp-f">
              <label class="xp-label" for="xp-f-miles">{{ "expenses.field.miles_one_way" | t(lang) }}</label>
              <input id="xp-f-miles" class="input" type="text" inputmode="decimal" autocomplete="off" x-model="form.miles" :disabled="odo()" :aria-invalid="errText('miles') ? 'true' : null" aria-describedby="xp-e-miles">
              <p id="xp-e-miles" class="xp-err" x-show="errText('miles')" x-text="errText('miles')"></p>
            </div>
            <div class="xp-f xp-f-end">
              <label class="xp-check-line"><input type="checkbox" x-model="form.round_trip" :disabled="odo()"><span>{{ "expenses.field.round_trip" | t(lang) }}</span></label>
            </div>
            {#- the same trip made several times (3 days at a convention, 7 CityWide Saturdays): one entry -#}
            {{ fi("trips", "expenses.field.trips", lang, { type: "number", im: "numeric", min: 1, hint: "expenses.form.trips_hint", show: "has('trips')" }) }}
            <details class="xp-span xp-odo">
              <summary>{{ "expenses.form.odometer" | t(lang) }}</summary>
              <div class="xp-form-grid mt-3">
                {{ fi("odometer_start", "expenses.field.odometer_start", lang, { im: "decimal" }) }}
                {{ fi("odometer_end", "expenses.field.odometer_end", lang, { im: "decimal" }) }}
              </div>
              <p class="xp-hint">{{ "expenses.form.odometer_hint" | t(lang) }}</p>
            </details>
            <div class="xp-f xp-span">
              <label class="xp-label" for="xp-f-rate_id">{{ "expenses.field.rate" | t(lang) }}</label>
              <select id="xp-f-rate_id" class="input xp-select" @change="form.rate_id = $event.target.value; onRate()" aria-describedby="xp-h-rate">
                <template x-for="r in rateOptions()" :key="r.id"><option :value="r.id" :selected="r.id === form.rate_id" x-text="lbl(r.name) + ' · ' + rateText(r.rate)"></option></template>
              </select>
              <p id="xp-h-rate" class="xp-hint" x-text="form.rate === '' ? t('form.rate_missing') : rateText(form.rate)"></p>
            </div>
            <p class="xp-f xp-span xp-preview" aria-live="polite" x-text="mileagePreview()"></p>
          </div>
          </template>
        </div>
        </template>

        {#- a magazine subscription: how it was paid, for whom -#}
        <template x-if="has('subscription')">
        <div class="xp-span xp-form-grid">
          <fieldset class="xp-f xp-span">
            <legend class="xp-label">{{ "expenses.field.sub_kind" | t(lang) }}</legend>
            <div class="xp-seg xp-seg-4">
              {%- for k in ["gift", "helped", "group", "self"] %}
              <label class="xp-seg-opt"><input type="radio" name="xp-subkind" value="{{ k }}" :checked="form.sub_kind === '{{ k }}'" @change="form.sub_kind = '{{ k }}'; onSubKind()"><span>{{ ("expenses.sub_kind." + k) | t(lang) }}</span></label>
              {%- endfor %}
            </div>
            <p class="xp-hint" x-text="t('sub_kind_hint.' + (form.sub_kind || 'gift'))"></p>
          </fieldset>
          <div class="xp-f" x-show="form.sub_kind === 'helped'">
            <label class="xp-label" for="xp-f-person_name">{{ "expenses.field.person_owes" | t(lang) }} <span class="xp-req" aria-hidden="true">*</span></label>
            <input id="xp-f-person_name" class="input" type="text" list="xp-dl-people" autocomplete="off" maxlength="60" x-model="form.person_name" aria-describedby="xp-h-person_name xp-e-person_name" :aria-invalid="errText('person_name') ? 'true' : null">
            <p id="xp-h-person_name" class="xp-hint">{{ "expenses.form.person_hint" | t(lang) }}</p>
            <p id="xp-e-person_name" class="xp-err" x-show="errText('person_name')" x-text="errText('person_name')"></p>
          </div>
          <div class="xp-f" x-show="form.sub_kind !== 'helped'">
            <label class="xp-label" for="xp-f-person">{{ "expenses.field.person" | t(lang) }}</label>
            <input id="xp-f-person" class="input" type="text" list="xp-dl-person" autocomplete="off" maxlength="60" x-model="form.person" aria-describedby="xp-h-person">
            <p id="xp-h-person" class="xp-hint">{{ "expenses.form.person_hint" | t(lang) }}</p>
          </div>
          <div class="xp-f">
            <label class="xp-label" for="xp-f-sub_product">{{ "expenses.field.sub_product" | t(lang) }}</label>
            <select id="xp-f-sub_product" class="input xp-select" x-model="form.sub_product">
              <option value="">{{ "expenses.form.choose" | t(lang) }}</option>
              {%- for p in (["lv_print", "lv_online", "lv_complete", "gv_print", "gv_online", "gv_complete", "other"] if lang == "es" else ["gv_print", "gv_online", "gv_complete", "lv_print", "lv_online", "lv_complete", "other"]) %}
              <option value="{{ p }}">{{ ("expenses.sub_product." + p) | t(lang) }}</option>
              {%- endfor %}
            </select>
          </div>
          {{ fi("sub_term", "expenses.field.sub_term", lang, { type: "number", im: "numeric", min: 1 }) }}
          {{ fi("sub_start", "expenses.field.sub_start", lang, { type: "date", hint: "expenses.form.sub_start_hint" }) }}
          {#- several bought at once (10 gift subscriptions for a jail): the amount is what they all cost -#}
          {{ fi("quantity", "expenses.field.quantity_subscription", lang, { type: "number", im: "numeric", min: 1, hint: "expenses.form.sub_qty_hint" }) }}
        </div>
        </template>

        {#- books, printing, giveaways, items received: what and how many -#}
        <template x-if="has('item')">
        <div class="xp-span xp-form-grid">
          <div class="xp-f xp-span">
            <label class="xp-label" for="xp-f-item" x-text="tpl() === 'printing' ? t('field.item_printed') : t('field.item')"></label>
            <input id="xp-f-item" class="input" type="text" list="xp-dl-item" autocomplete="off" maxlength="120" x-model="form.item" :placeholder="tpl() === 'printing' ? t('form.item_printed_ph') : t('form.item_ph')" :aria-invalid="errText('item') ? 'true' : null" aria-describedby="xp-e-item">
            <p id="xp-e-item" class="xp-err" x-show="errText('item')" x-text="errText('item')"></p>
          </div>
          <fieldset class="xp-f xp-span" x-show="has('format')">
            <legend class="xp-label">{{ "expenses.field.format" | t(lang) }}</legend>
            <div class="xp-seg xp-seg-4">
              {%- for k in (["lv", "gv", "other", ""] if lang == "es" else ["gv", "lv", "other", ""]) %}
              <label class="xp-seg-opt"><input type="radio" name="xp-format" value="{{ k }}" :checked="form.format === '{{ k }}'" @change="form.format = '{{ k }}'"><span>{{ ("expenses.format." + (k or "none")) | t(lang) }}</span></label>
              {%- endfor %}
            </div>
          </fieldset>
          <div class="xp-f" x-show="has('quantity')">
            <label class="xp-label" for="xp-f-quantity" x-text="t('field.quantity_' + tpl())"></label>
            <input id="xp-f-quantity" class="input" type="text" inputmode="decimal" autocomplete="off" x-model="form.quantity" :aria-invalid="errText('quantity') ? 'true' : null" aria-describedby="xp-e-quantity">
            <p id="xp-e-quantity" class="xp-err" x-show="errText('quantity')" x-text="errText('quantity')"></p>
          </div>
          {{ fi("unit_cost", "expenses.field.unit_cost", lang, { im: "decimal", money: true, show: "has('unit_cost')" }) }}
          <p class="xp-f xp-span xp-preview" x-show="booksAuto()" aria-live="polite" x-text="booksTotal()"></p>
          <div class="xp-f xp-span" x-show="has('giveaway')">
            <label class="xp-check-line"><input type="checkbox" x-model="form.giveaway"><span>{{ "expenses.field.giveaway" | t(lang) }}</span></label>
          </div>
        </div>
        </template>

        {{ fi("attendees", "expenses.field.attendees", lang, { type: "number", im: "numeric", min: 1, show: "has('attendees')" }) }}

        {#- a hotel: its name, city and confirmation number (other templates keep these under "More details") -#}
        <template x-if="has('lodging')">
        <div class="xp-span xp-form-grid">
          {{ fi("vendor", "expenses.field.hotel", lang, { list: "xp-dl-vendor", max: 120 }) }}
          {{ fi("place", "expenses.field.city", lang, { list: "xp-dl-place", max: 120 }) }}
          {{ fi("ref", "expenses.field.ref_lodging", lang, { max: 80, ph: "expenses.form.ref_lodging_ph", cls: "xp-span" }) }}
        </div>
        </template>

        {#- what it was for -#}
        <div class="xp-f xp-span">
          <label class="xp-label" for="xp-f-description"><span x-text="t('field.description_' + form.type)"></span> <span class="xp-req" aria-hidden="true" x-show="form.type === 'expense' || form.type === 'received'">*</span></label>
          <input id="xp-f-description" class="input" type="text" autocomplete="off" maxlength="200" x-model="form.description" :placeholder="t('form.description_ph_' + form.type)" :aria-required="form.type === 'expense' || form.type === 'received' ? 'true' : null" :aria-invalid="errText('description') ? 'true' : null" aria-describedby="xp-e-description">
          <p id="xp-e-description" class="xp-err" x-show="errText('description')" x-text="errText('description')"></p>
        </div>

        {#- how much -#}
        <div class="xp-f" x-show="has('money') && !booksAuto()">
          <label class="xp-label" for="xp-f-amount"><span x-text="form.type === 'received' ? t('field.amount_received') : t('field.amount')"></span> <span class="xp-req" aria-hidden="true">*</span></label>
          <span class="xp-money"><span aria-hidden="true">$</span><input id="xp-f-amount" class="input" type="text" inputmode="decimal" autocomplete="off" x-model="form.amount" placeholder="0.00" aria-required="true" :aria-invalid="errText('amount') || errText('amount_cents') ? 'true' : null" aria-describedby="xp-e-amount"></span>
          <p id="xp-e-amount" class="xp-err" x-show="errText('amount') || errText('amount_cents')" x-text="errText('amount') || errText('amount_cents')"></p>
        </div>

        {#- who pays for it in the end (money received / items received: who it came from) -#}
        <div class="xp-f" x-show="has('funder')">
          <label class="xp-label" for="xp-f-funder" x-text="funderLabel()"></label>
          <select id="xp-f-funder" class="input xp-select" @change="form.funder = $event.target.value; onFunder()" aria-describedby="xp-h-funder xp-e-funder">
            <template x-for="x in funders(form.funder)" :key="x.id"><option :value="x.id" :selected="x.id === form.funder" x-text="lbl(x.name)"></option></template>
          </select>
          <p id="xp-h-funder" class="xp-hint" x-show="(form.type === 'expense' || form.type === 'mileage') && isSelf(form.funder)">{{ "expenses.form.self_hint" | t(lang) }}</p>
          <p id="xp-e-funder" class="xp-err" x-show="errText('funder')" x-text="errText('funder')"></p>
        </div>
        <div class="xp-f" x-show="has('status')">
          <label class="xp-label" for="xp-f-claim_status">{{ "expenses.field.status" | t(lang) }}</label>
          <select id="xp-f-claim_status" class="input xp-select" x-model="form.claim_status">
            {%- for s in ["to_request", "submitted", "paid", "denied"] %}<option value="{{ s }}">{{ ("expenses.status." + s) | t(lang) }}</option>{% endfor %}
          </select>
        </div>

        {{ fi("event", "expenses.field.event", lang, { list: "xp-dl-event", max: 120, ph: "expenses.form.event_ph", cls: "xp-span" }) }}

        {#- the kind of service it was for (the service report's sections) and, on a trip, what you did there -#}
        <div class="xp-f" x-show="has('activity')">
          <label class="xp-label" for="xp-f-activity">{{ "expenses.field.activity" | t(lang) }}</label>
          <select id="xp-f-activity" class="input xp-select" @change="form.activity = $event.target.value" :aria-invalid="errText('activity') ? 'true' : null" aria-describedby="xp-h-activity xp-e-activity">
            <option value="" :selected="!form.activity">{{ "expenses.form.no_activity" | t(lang) }}</option>
            <template x-for="a in activities(form.activity)" :key="a.id"><option :value="a.id" :selected="a.id === form.activity" x-text="lbl(a.name)"></option></template>
          </select>
          <p id="xp-h-activity" class="xp-hint">{{ "expenses.form.activity_hint" | t(lang) }}</p>
          <p id="xp-e-activity" class="xp-err" x-show="errText('activity')" x-text="errText('activity')"></p>
        </div>
        {{ fi("role", "expenses.field.role", lang, { list: "xp-dl-role", max: 80, ph: "expenses.form.role_ph", show: "has('role')" }) }}

        {#- the receipt: kept on paper, a photo on this device, or somewhere else -#}
        <div class="xp-f xp-span" x-show="has('receipt')">
          <label class="xp-label" for="xp-f-receipt">{{ "expenses.field.receipt" | t(lang) }}</label>
          <div class="xp-receipt-row">
            <select id="xp-f-receipt" class="input xp-select" x-model="form.receipt">
              {%- for r in ["none", "paper", "photo", "file"] %}<option value="{{ r }}">{{ ("expenses.receipt." + r) | t(lang) }}</option>{% endfor %}
            </select>
            <label class="btn-secondary btn-sm xp-photo-btn" x-show="form.receipt === 'photo' && !photoUrl">
              <input type="file" class="sr-only" accept="image/*" @change="onPhoto($event)">
              {% icon "camera", "size-4" %} <span x-text="photoBusy ? t('form.photo_busy') : t('form.photo_take')"></span>
            </label>
          </div>
          <div class="xp-photo" x-show="photoUrl && form.receipt === 'photo'">
            <img :src="photoUrl || null" alt="{{ 'expenses.form.photo_alt' | t(lang) }}">
            <button type="button" class="btn-ghost btn-sm xp-danger" @click="removePhoto()">{% icon "trash-2", "size-4" %} {{ "expenses.form.photo_remove" | t(lang) }}</button>
          </div>
          <p class="xp-hint" x-show="form.receipt === 'photo'">{{ "expenses.form.photo_hint" | t(lang) }}</p>
          <div class="xp-f mt-2" x-show="form.receipt === 'file'">
            <label class="xp-label" for="xp-f-receipt_ref">{{ "expenses.field.receipt_ref" | t(lang) }}</label>
            <input id="xp-f-receipt_ref" class="input" type="text" autocomplete="off" maxlength="120" x-model="form.receipt_ref" placeholder="{{ 'expenses.form.receipt_ref_ph' | t(lang) }}">
          </div>
        </div>
      </div>

      {#- the rest, folded -#}
      <details class="xp-moredet" :open="formMore" @toggle="formMore = $event.target.open">
        <summary>{% icon "chevron-down", "size-4 shrink-0 xp-chev" %} {{ "expenses.form.more" | t(lang) }}</summary>
        <div class="xp-form-grid mt-3">
          <div class="xp-f" x-show="has('method')">
            <label class="xp-label" for="xp-f-method" x-text="form.type === 'received' ? t('field.method_received') : t('field.method')"></label>
            <select id="xp-f-method" class="input xp-select" @change="form.method = $event.target.value" aria-describedby="xp-h-method">
              <option value="" :selected="!form.method">{{ "expenses.form.choose" | t(lang) }}</option>
              <template x-for="m in methods(form.method)" :key="m.id"><option :value="m.id" :selected="m.id === form.method" x-text="lbl(m.name)"></option></template>
            </select>
            <p id="xp-h-method" class="xp-hint" x-show="form.method === 'direct'">{{ "expenses.form.direct_hint" | t(lang) }}</p>
          </div>
          <template x-if="!has('lodging') && form.type !== 'giveaway' && form.type !== 'stock'">
            {{ fi("vendor", "expenses.field.vendor", lang, { list: "xp-dl-vendor", max: 120, ph: "expenses.form.vendor_ph" }) }}
          </template>
          <template x-if="!has('lodging') && tpl() !== 'mileage'">
            {{ fi("place", "expenses.field.place", lang, { list: "xp-dl-place", max: 120 }) }}
          </template>
          {#- the store's own number for it: an order, a confirmation, the check you wrote (a hotel's is above) -#}
          <template x-if="has('ref') && !has('lodging')">
            {{ fi("ref", "expenses.field.ref", lang, { max: 80, ph: "expenses.form.ref_ph" }) }}
          </template>
          <template x-if="form.claim_status === 'submitted' || form.claim_status === 'paid' || form.claim_status === 'denied' || form.type === 'received'">
            {{ fi("claim_ref", "expenses.field.claim_ref", lang, { max: 60, ph: "expenses.form.claim_ref_ph" }) }}
          </template>
          <template x-if="form.claim_status === 'submitted' || form.claim_status === 'paid' || form.claim_status === 'denied'">
            {{ fi("claim_date", "expenses.field.claim_date", lang, { type: "date" }) }}
          </template>
          <template x-if="form.claim_status === 'paid'">
            {{ fi("paid_date", "expenses.field.paid_date", lang, { type: "date" }) }}
          </template>
          <div class="xp-f" x-show="form.sub_kind === 'helped'">
            <label class="xp-label" for="xp-f-repaid">{{ "expenses.field.repaid" | t(lang) }}</label>
            <select id="xp-f-repaid" class="input xp-select" x-model="form.repaid">
              {%- for r in ["owed", "repaid", "forgiven"] %}<option value="{{ r }}">{{ ("expenses.repaid." + r) | t(lang) }}</option>{% endfor %}
            </select>
          </div>
          {{ fi("tags", "expenses.field.tags", lang, { max: 200, hint: "expenses.form.tags_hint", cls: "xp-span" }) }}
          <div class="xp-f xp-span">
            <label class="xp-label" for="xp-f-notes">{{ "expenses.field.notes" | t(lang) }}</label>
            <textarea id="xp-f-notes" class="input xp-textarea" rows="3" maxlength="5000" x-model="form.notes"></textarea>
          </div>
          <template x-for="c in customFields()" :key="c.id">
            <div class="xp-f">
              <template x-if="c.type === 'yesno'">
                <label class="xp-check-line xp-mt-label"><input type="checkbox" :id="'xp-f-cf-' + c.id" :checked="!!form.custom[c.id]" @change="form.custom[c.id] = $event.target.checked"><span x-text="c.label"></span></label>
              </template>
              <template x-if="c.type !== 'yesno'">
                <div>
                  <label class="xp-label" :for="'xp-f-cf-' + c.id" x-text="c.label"></label>
                  <template x-if="c.type === 'choice'">
                    <select class="input xp-select" :id="'xp-f-cf-' + c.id" @change="form.custom[c.id] = $event.target.value">
                      <option value="">{{ "expenses.form.choose" | t(lang) }}</option>
                      <template x-for="o in (c.options || [])" :key="o"><option :value="o" :selected="form.custom[c.id] === o" x-text="o"></option></template>
                    </select>
                  </template>
                  <template x-if="c.type !== 'choice'">
                    <input class="input" :type="c.type === 'date' ? 'date' : 'text'" :inputmode="c.type === 'number' ? 'decimal' : null" autocomplete="off" :id="'xp-f-cf-' + c.id" :value="form.custom[c.id] == null ? '' : form.custom[c.id]" @input="form.custom[c.id] = $event.target.value">
                  </template>
                </div>
              </template>
            </div>
          </template>
        </div>
      </details>

      {#- suggestions from what was typed before (and the site's events) -#}
      <datalist id="xp-dl-event"><template x-for="v in suggest('event')" :key="v"><option :value="v"></option></template></datalist>
      <datalist id="xp-dl-place"><template x-for="v in suggest('place')" :key="v"><option :value="v"></option></template></datalist>
      <datalist id="xp-dl-item"><template x-for="v in itemSuggest()" :key="v"><option :value="v"></option></template></datalist>
      <datalist id="xp-dl-vendor"><template x-for="v in suggest('vendor')" :key="v"><option :value="v"></option></template></datalist>
      <datalist id="xp-dl-person"><template x-for="v in suggest('person')" :key="v"><option :value="v"></option></template></datalist>
      <datalist id="xp-dl-people"><template x-for="x in people()" :key="x.id"><option :value="lbl(x.name)"></option></template></datalist>
      <datalist id="xp-dl-role"><template x-for="v in roleSuggest()" :key="v"><option :value="v"></option></template></datalist>
    </form>

    <footer class="xp-dlg-foot" x-show="formStep === 2">
      <button type="submit" form="xp-form" class="btn-primary">{% icon "check", "size-4" %} {{ "expenses.form.save" | t(lang) }}</button>
      <button type="button" class="btn-secondary xp-save-next" x-show="formMode === 'add'" title="{{ 'expenses.form.save_another' | t(lang) }}" @click="saveForm(true)">{% icon "plus", "size-4" %} <span>{{ "expenses.form.save_another" | t(lang) }}</span></button>
      <button type="button" class="btn-ghost" @click="tryClose()">{{ "expenses.form.cancel" | t(lang) }}</button>
    </footer>
  </div>
  </template>
</dialog>

{#- "Are you sure?" -#}
<dialog x-ref="ask" class="xp-ask" aria-labelledby="xp-ask-msg" @close="askDone(false)">
  <p id="xp-ask-msg" class="text-ink" x-text="ask.msg"></p>
  <div class="xp-ask-acts">
    <button type="button" class="btn-secondary" data-ask-no @click="askDone(false)">{{ "expenses.form.cancel" | t(lang) }}</button>
    {#- a third choice, when there is one ("Without photos") -#}
    <button type="button" class="btn-secondary" x-show="ask.alt" @click="askDone('alt')" x-text="ask.alt"></button>
    <button type="button" :class="ask.danger ? 'btn-primary xp-btn-danger' : 'btn-primary'" @click="askDone(true)" x-text="ask.ok"></button>
  </div>
</dialog>

{#- short messages ("Saved", "Deleted — Undo"): role=status, 10 s with Undo -#}
<div class="xp-toast" :class="{ 'is-on': toastMsg }" role="status" aria-live="polite" aria-atomic="true">
  <template x-if="toastMsg">
    <div class="xp-toast-in" @focusin="toastHold(true)" @focusout="$el.contains($event.relatedTarget) || toastHold(false)" @mouseenter="toastHold(true)" @mouseleave="$el.contains(document.activeElement) || toastHold(false)">
      <span x-text="toastMsg"></span>
      <button type="button" class="xp-toast-btn" data-xp-undo x-show="toastUndo" @click="undoToast()">{{ "expenses.toast.undo" | t(lang) }}</button>
      <button type="button" class="xp-icon-btn xp-toast-x" @click="closeToast()" aria-label="{{ 'common.close' | t(lang) }}">{% icon "x", "size-4" %}</button>
    </div>
  </template>
</div>

{#- the icons the app draws by name (x-xp-icon): drawn once here at build time (the categories' icons, the
    entry types, the request statuses, the subscriptions' statuses and the tiles' icons) -#}
<div id="xp-icons" hidden aria-hidden="true">
  {%- for n in expenses.icons %}<span data-i="{{ n }}">{% icon n, "size-4 shrink-0" %}</span>{% endfor -%}
  {%- for n in ["receipt", "car", "banknote", "heart-handshake", "package", "hand-heart", "clock", "send", "circle-check", "circle-x", "shapes",
                "repeat", "calendar-x", "bell", "gift", "newspaper", "calendar", "library"] %}{% if not (n in expenses.icons) %}<span data-i="{{ n }}">{% icon n, "size-4 shrink-0" %}</span>{% endif %}{% endfor -%}
</div>

{#- ============ Privacy, in plain words (every promise here is true: see expenses.js) ============ -#}
<section id="privacy" class="section container-page pt-10 sm:pt-12" aria-labelledby="xp-privacy-title">
  {{ ui.sectionHead("expenses.privacy.title" | t(lang), "expenses.privacy.sub" | t(lang), "", "", "lock", { eyebrow: "expenses.privacy.eyebrow" | t(lang), tone: "text-vine", id: "xp-privacy-title", lang: lang }) }}
  <ul class="grid-cards-4" role="list">
    {%- for p in [["hard-drive", "p1", "bg-gv-soft text-gv"], ["hard-drive-download", "p2", "bg-lv-soft text-lv"], ["eye-off", "p3", "bg-grape-soft text-grape"], ["hand-heart", "p4", "bg-vine-soft text-vine"]] %}
    <li class="card card-pad">
      <span class="grid size-11 place-items-center rounded-xl {{ p[2] }}">{% icon p[0], "size-5" %}</span>
      <h3 class="h-card mt-3">{{ ("expenses.privacy." + p[1] + "_t") | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ ("expenses.privacy." + p[1]) | t(lang) }}</p>
    </li>
    {%- endfor %}
  </ul>
  <p class="mt-6 flex max-w-3xl items-start gap-2 text-sm leading-relaxed text-muted">{% icon "info", "mt-0.5 size-4 shrink-0" %}<span>{{ "expenses.privacy.tax" | t(lang) }}</span></p>
</section>

{#- the app's words (this page's language), its defaults and the site's events (suggestions) -#}
{%- set evTitles = [] -%}
{%- for e in ((db.events.items if db.events) or []) %}{% set tt = (e.i18n.title[lang] if (e.i18n and e.i18n.title and e.i18n.title[lang]) else e.title) %}{% if tt and not (tt in evTitles) %}{% set _n = evTitles.push(tt) %}{% endif %}{% endfor -%}
<script type="application/json" id="xp-config">{{ expenses.config | jsonScript | safe }}</script>
<script type="application/json" id="xp-ui">{{ expenses.ui[lang] | jsonScript | safe }}</script>
<script type="application/json" id="xp-events">{{ evTitles | jsonScript | safe }}</script>
</div>
