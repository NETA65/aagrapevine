---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}tracker/index.html"
layout: layouts/base.njk
pageKey: expenses
titleKey: nav.expenses
descKey: expenses.meta_desc
bodyClass: xp-page
pageScripts: ["/assets/js/expenses-core.js", "/assets/js/expenses-files.js", "/assets/js/expenses.js", "/assets/js/committee.js"]
pageStyles: ["/assets/css/expenses.css"]
---
{#- /tracker/ — the TRACKER (the service expense tracker; it was /expenses/, and expenses-redirect.njk
    keeps that address working): a GVR / RLV's (or any service member's) miles, purchases,
    gift subscriptions, giveaways and reimbursements, kept ONLY in this browser (nothing is uploaded).
    Flow (docs: ui.njk): hero (+ the "On this device" aside) → the committee sub-nav (page-overlap, as on
    every Committee page) → the app (card: Entries · Summary · Giveaways · Requests · Settings, in the
    address as #entries …) → privacy, in plain words.
    The logic: src/assets/js/expenses-core.js (window.GVX); the .zip backup and Excel import:
    src/assets/js/expenses-files.js (window.GVF); the screen: src/assets/js/expenses.js
    ("xpApp"); the defaults: config/expenses.yml (src/_data/expenses.js); the words:
    src/_i18n/expenses.json (handed to the app as #xp-ui); the look: areas/expenses.css.
    One Alpine component wraps the hero AND the app (the hero's buttons and aside use its data).
    Without JavaScript the page says what the tracker is and that it needs JavaScript.
    Its home is the Committee menu (nav.js) and the committee sub-nav; the GVR corner has one card
    linking here. Nothing else on the site repeats this page. Internal names (files, the expenses.* keys,
    pageKey "expenses", the storage keys) keep the old word: renaming them would only churn. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set bulk = (db.shop or {}) | shopBulk(lang) -%}
{%- set carryHref = ('/shop/' | lurl(lang)) + ('#bulk' if bulk.rows.length else '#carry') -%}
{%- set views = [
  { id: "entries", icon: "list" },
  { id: "summary", icon: "chart-column" },
  { id: "giveaways", icon: "gift" },
  { id: "requests", icon: "file-text" },
  { id: "settings", icon: "settings-2" }
] -%}
{%- set typeList = [
  { id: "expense", icon: "receipt" },
  { id: "mileage", icon: "car" },
  { id: "received", icon: "banknote" },
  { id: "giveaway", icon: "heart-handshake" },
  { id: "stock", icon: "package" }
] -%}
<div class="xp-root" x-data="xpApp('{{ lang }}')">

{#- The hero's right-hand card: what is on THIS device (entries, the last backup, whether the browser
    protects it from automatic clean-up) + "Back up now" (the full backup, photos included). It is in
    the hero only from 1024px at 100 % text ("hide"); anywhere else the same facts sit at the foot of
    the app card (.xp-device) — never two copies at once (areas/expenses.css). -#}
{% call(slot) ui.pageHero(lang, "nav.expenses" | t(lang), "expenses.hero_sub" | t(lang), "receipt", "expenses.eyebrow" | t(lang), { side: "hide" }) %}
{%- if slot == "side" %}
  {% call ui.heroAside("expenses.aside.title" | t(lang), lang, { id: "xp-aside-title", icon: "hard-drive" }) %}
    <p class="hero-aside-text" data-nojs-only>{{ "expenses.aside.nojs" | t(lang) }}</p>
    <p class="hero-aside-text" x-show="broken" x-cloak>{{ "expenses.aside.nojs" | t(lang) }}</p>
    <div x-show="ready" x-cloak>
      <dl class="xp-aside-facts">
        <div><dt class="hero-aside-note">{{ "expenses.aside.entries" | t(lang) }}</dt><dd class="hero-aside-title" x-text="count(E().length)"></dd></div>
        <div><dt class="hero-aside-note">{{ "expenses.aside.last_backup" | t(lang) }}</dt><dd class="hero-aside-title" x-text="lastBackupText()"></dd></div>
        <div class="col-span-2"><dt class="hero-aside-note">{{ "expenses.aside.protected" | t(lang) }}</dt><dd class="hero-aside-title" x-text="persisted ? t('aside.yes') : t('aside.no')"></dd></div>
      </dl>
      <div class="hero-aside-foot">
        <button type="button" class="hero-aside-cta" @click="exportBackup()">{% icon "hard-drive-download", "size-4" %} {{ "expenses.aside.backup_now" | t(lang) }}</button>
      </div>
    </div>
  {% endcall %}
{%- else %}
  <div class="hero-actions">
    <button type="button" class="btn-light" data-js-only data-xp-add @click="ready && openAdd()">{% icon "plus", "size-4" %} {{ "expenses.add" | t(lang) }}</button>
    <button type="button" class="btn-on-dark" data-js-only @click="ready && exportAll()">{% icon "download", "size-4" %} {{ "expenses.export_csv" | t(lang) }}</button>
  </div>
{%- endif %}
{% endcall %}

{% committeeNav lang, "tracker", db %}

{#- ============ The app: a card under the committee sub-nav ============ -#}
<section id="app" class="container-page pt-10 sm:pt-12" aria-labelledby="xp-app-title">
  <div class="card xp-app">
    <h2 id="xp-app-title" class="sr-only">{{ "expenses.app_title" | t(lang) }}</h2>

    {#- without JavaScript / when the app can't start -#}
    <div class="xp-pad xp-nojs" data-nojs-only>
      <p class="card-h"><span>{% icon "info", "size-5" %}</span>{{ "expenses.nojs_title" | t(lang) }}</p>
      <p class="mt-2 max-w-2xl leading-relaxed text-muted">{{ "expenses.nojs_text" | t(lang) }}</p>
    </div>
    <div class="xp-pad" x-show="broken" x-cloak role="alert">
      <p class="card-h"><span>{% icon "triangle-alert", "size-5" %}</span>{{ "expenses.broken_title" | t(lang) }}</p>
      <p class="mt-2 max-w-2xl leading-relaxed text-muted">{{ "expenses.broken_text" | t(lang) }}</p>
      <button type="button" class="btn-secondary btn-sm mt-4" onclick="location.reload()">{% icon "rotate-ccw", "size-4" %} {{ "expenses.reload" | t(lang) }}</button>
    </div>

    <template x-if="ready">
    <div>
      {#- storage is not working (private window, blocked, full): the app works in memory -#}
      <p class="xp-alert" x-show="!storageOk" role="alert">{% icon "triangle-alert", "size-5 shrink-0" %}<span>{{ "expenses.storage_off" | t(lang) }}</span></p>
      {#- the data stored on this device could not be read: kept as it was (never written over), offered as a file -#}
      <div class="xp-alert" x-show="damaged" role="alert">{% icon "triangle-alert", "size-5 shrink-0" %}
        <div class="xp-alert-body">
          <p x-text="lock === 'unreadable' ? t('data.damaged_locked') : t('data.damaged')"></p>
          <div class="xp-actions">
            <button type="button" class="btn-secondary btn-sm" @click="damagedDownload()">{% icon "download", "size-4" %} {{ "expenses.data.damaged_download" | t(lang) }}</button>
            <button type="button" class="btn-ghost btn-sm" @click="damagedRemove()">{% icon "trash-2", "size-4" %} {{ "expenses.data.damaged_remove" | t(lang) }}</button>
          </div>
        </div>
      </div>
      {#- …or a newer version of the page saved it: shown, never saved over, until the page is reloaded -#}
      <div class="xp-alert" x-show="lock === 'newer'" role="alert">{% icon "triangle-alert", "size-5 shrink-0" %}
        <div class="xp-alert-body">
          <p>{{ "expenses.data.newer" | t(lang) }}</p>
          <div class="xp-actions"><button type="button" class="btn-secondary btn-sm" onclick="location.reload()">{% icon "rotate-ccw", "size-4" %} {{ "expenses.reload" | t(lang) }}</button></div>
        </div>
      </div>

      {#- the tab bar: one row of chips that scrolls sideways on phones, never wraps -#}
      <div class="xp-bar">
        <div class="chip-row-nowrap xp-tabs" role="tablist" aria-label="{{ 'expenses.tabs_label' | t(lang) }}" @keydown="tabKey($event)">
          {%- for v in views %}
          <button type="button" role="tab" class="xp-tab" id="xp-tab-{{ v.id }}" aria-controls="xp-panel-{{ v.id }}"
                  :aria-selected="view === '{{ v.id }}' ? 'true' : 'false'" :tabindex="view === '{{ v.id }}' ? 0 : -1" @click="go('{{ v.id }}')">
            {% icon v.icon, "size-4 shrink-0" %}<span>{{ ("expenses.tab." + v.id) | t(lang) }}</span>
            {%- if v.id == "summary" %}<span class="xp-tab-n" x-show="reminderCount()" x-text="reminderCount()" aria-hidden="true"></span><span class="sr-only" x-show="reminderCount()" x-text="'(' + t('sum.reminders_n', { n: reminderCount() }) + ')'"></span>{% endif %}
          </button>
          {%- endfor %}
        </div>
        <button type="button" class="btn-primary btn-sm xp-bar-add" data-xp-add @click="openAdd()">{% icon "plus", "size-4" %} <span>{{ "expenses.add_short" | t(lang) }}</span></button>
      </div>

      {#- ================= 1. Entries ================= -#}
      <section role="tabpanel" id="xp-panel-entries" aria-labelledby="xp-tab-entries" class="xp-panel" x-show="view === 'entries'" tabindex="-1">
        <template x-if="view === 'entries'">
        <div class="xp-pad">
          <p class="xp-banner" x-show="hasExamples()">{% icon "sparkles", "size-4 shrink-0" %}<span>{{ "expenses.list.examples_banner" | t(lang) }}</span>
            <button type="button" class="btn-secondary btn-sm" @click="removeExamples()">{% icon "eraser", "size-4" %} {{ "expenses.list.remove_examples" | t(lang) }}</button></p>

          <template x-if="!E().length">
            <div class="xp-empty">
              <span class="page-empty-icon" aria-hidden="true">{% icon "receipt", "size-8" %}</span>
              <h3 class="h-section mt-6 text-balance">{{ "expenses.list.empty_title" | t(lang) }}</h3>
              <p class="mx-auto mt-3 max-w-xl leading-relaxed text-muted">{{ "expenses.list.empty_text" | t(lang) }}</p>
              <div class="xp-empty-actions">
                <button type="button" class="btn-primary" @click="openAdd()">{% icon "plus", "size-4" %} {{ "expenses.list.add_first" | t(lang) }}</button>
                <button type="button" class="btn-secondary" @click="addExamples()">{% icon "sparkles", "size-4" %} {{ "expenses.list.try_examples" | t(lang) }}</button>
              </div>
              <p class="mx-auto mt-5 max-w-xl text-sm text-muted">{{ "expenses.list.empty_import" | t(lang) }} <button type="button" class="link" @click="go('settings'); setGo('data')">{{ "expenses.list.empty_import_link" | t(lang) }}</button></p>
            </div>
          </template>

          <template x-if="E().length">
          <div>
            {#- the toolbar: search · period · sort; the type chips; "More filters" -#}
            <div class="xp-toolbar">
              <div class="xp-f xp-f-q">
                <label class="xp-label" for="xp-q">{{ "expenses.f.search" | t(lang) }}</label>
                <span class="xp-search">{% icon "search", "size-4" %}<input id="xp-q" class="input" type="search" autocomplete="off" x-model.debounce.250ms="f.q" placeholder="{{ 'expenses.f.search_ph' | t(lang) }}"></span>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-period">{{ "expenses.f.period" | t(lang) }}</label>
                <select id="xp-period" class="input xp-select" @change="setPeriod($event.target.value)">
                  <template x-for="p in periods()" :key="p.id"><option :value="p.id" :selected="p.id === f.period" x-text="p.label"></option></template>
                </select>
              </div>
              <div class="xp-f" x-show="f.period === 'custom'">
                <label class="xp-label" for="xp-from">{{ "expenses.f.from" | t(lang) }}</label>
                <input id="xp-from" class="input" type="date" x-model="f.from" @change="saveUi()">
              </div>
              <div class="xp-f" x-show="f.period === 'custom'">
                <label class="xp-label" for="xp-to">{{ "expenses.f.to" | t(lang) }}</label>
                <input id="xp-to" class="input" type="date" x-model="f.to" @change="saveUi()">
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-sort">{{ "expenses.f.sort" | t(lang) }}</label>
                <select id="xp-sort" class="input xp-select" x-model="sort" @change="saveUi()">
                  {%- for s in ["date_desc", "date_asc", "amount_desc", "amount_asc", "category", "updated"] %}
                  <option value="{{ s }}">{{ ("expenses.sort." + s) | t(lang) }}</option>
                  {%- endfor %}
                </select>
              </div>
            </div>
            <div class="xp-chips">
              <div class="chip-row" role="group" aria-label="{{ 'expenses.f.types' | t(lang) }}">
                <button type="button" class="chip" :aria-pressed="f.types.length ? 'false' : 'true'" @click="f.types = []">{{ "common.all" | t(lang) }}</button>
                {%- for ty in typeList %}
                <button type="button" class="chip" :aria-pressed="typeOn('{{ ty.id }}') ? 'true' : 'false'" @click="toggleType('{{ ty.id }}')">{% icon ty.icon, "size-4 shrink-0" %}{{ ("expenses.type." + ty.id) | t(lang) }}</button>
                {%- endfor %}
              </div>
              <button type="button" class="btn-ghost btn-sm xp-more-btn" aria-controls="xp-more" :aria-expanded="moreFilters ? 'true' : 'false'" @click="moreFilters = !moreFilters">
                {% icon "sliders-horizontal", "size-4" %} {{ "expenses.f.more" | t(lang) }}<span class="xp-pill" x-show="moreCount()" x-text="moreCount()"></span>
              </button>
            </div>
            <div id="xp-more" class="xp-more" x-show="moreFilters">
              <div class="xp-f">
                <label class="xp-label" for="xp-f-cat">{{ "expenses.field.category" | t(lang) }}</label>
                <select id="xp-f-cat" class="input xp-select" x-model="f.category">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  {%- for ty in typeList %}
                  <optgroup label="{{ ('expenses.type_add.' + ty.id) | t(lang) }}">
                    <template x-for="c in cats('{{ ty.id }}', f.category)" :key="c.id"><option :value="c.id" :selected="c.id === f.category" x-text="lbl(c.label)"></option></template>
                  </optgroup>
                  {%- endfor %}
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-f-fun">{{ "expenses.field.funder" | t(lang) }}</label>
                <select id="xp-f-fun" class="input xp-select" x-model="f.funder">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  <template x-for="x in funders(f.funder)" :key="x.id"><option :value="x.id" :selected="x.id === f.funder" x-text="lbl(x.name)"></option></template>
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-f-st">{{ "expenses.field.status" | t(lang) }}</label>
                <select id="xp-f-st" class="input xp-select" x-model="f.status">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  {%- for s in ["none", "to_request", "submitted", "paid", "denied"] %}<option value="{{ s }}">{{ ("expenses.status." + s) | t(lang) }}</option>{% endfor %}
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-f-act">{{ "expenses.field.activity" | t(lang) }}</label>
                <select id="xp-f-act" class="input xp-select" x-model="f.activity">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  <template x-for="a in activities(f.activity)" :key="a.id"><option :value="a.id" :selected="a.id === f.activity" x-text="lbl(a.name)"></option></template>
                  <option value="-">{{ "expenses.f.no_activity" | t(lang) }}</option>
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-f-ev">{{ "expenses.field.event" | t(lang) }}</label>
                <select id="xp-f-ev" class="input xp-select" x-model="f.event">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  <template x-for="v in usedEvents()" :key="v"><option :value="v" :selected="v === f.event" x-text="v"></option></template>
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-f-tag">{{ "expenses.field.tags" | t(lang) }}</label>
                <select id="xp-f-tag" class="input xp-select" x-model="f.tag">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  <template x-for="v in usedTags()" :key="v"><option :value="v" :selected="v === f.tag" x-text="v"></option></template>
                </select>
              </div>
              <div class="xp-f">
                <label class="xp-label" for="xp-f-rc">{{ "expenses.field.receipt" | t(lang) }}</label>
                <select id="xp-f-rc" class="input xp-select" x-model="f.receipt">
                  <option value="">{{ "common.all" | t(lang) }}</option>
                  <option value="yes">{{ "expenses.f.receipt_yes" | t(lang) }}</option>
                  <option value="no">{{ "expenses.f.receipt_no" | t(lang) }}</option>
                </select>
              </div>
              <div class="xp-more-foot">
                <button type="button" class="btn-ghost btn-sm" x-show="anyFilter()" @click="clearFilters()">{% icon "x", "size-4" %} {{ "expenses.f.clear" | t(lang) }}</button>
              </div>
            </div>

            <p class="xp-count" role="status" aria-live="polite" aria-atomic="true" x-text="countLine()"></p>

            {#- bulk changes to the selected entries -#}
            <div class="xp-bulk" x-show="selCount()" role="region" aria-label="{{ 'expenses.bulk.label' | t(lang) }}">
              <div class="xp-bulk-row">
                <p class="font-semibold text-ink" x-text="plural(selCount(), 'bulk.selected_one', 'bulk.selected')"></p>
                <button type="button" class="btn-ghost btn-sm" x-show="selCount() < filtered().length" @click="selectAllMatching()">{{ "expenses.bulk.select_all" | t(lang) }}</button>
                <button type="button" class="btn-ghost btn-sm" @click="clearSel()">{% icon "x", "size-4" %} {{ "expenses.bulk.clear" | t(lang) }}</button>
              </div>
              <div class="xp-bulk-row">
                <button type="button" class="btn-secondary btn-sm" @click="bulkStatus('submitted')">{% icon "send", "size-4" %} {{ "expenses.bulk.submitted" | t(lang) }}</button>
                <button type="button" class="btn-secondary btn-sm" @click="bulkStatus('paid')">{% icon "circle-check", "size-4" %} {{ "expenses.bulk.paid" | t(lang) }}</button>
                <button type="button" class="btn-secondary btn-sm" @click="bulkExport()">{% icon "download", "size-4" %} {{ "expenses.bulk.export" | t(lang) }}</button>
                <button type="button" class="btn-secondary btn-sm xp-danger" @click="remove(selIds())">{% icon "trash-2", "size-4" %} {{ "expenses.bulk.delete" | t(lang) }}</button>
              </div>
              <div class="xp-bulk-row">
                <label class="sr-only" for="xp-bulk-fun">{{ "expenses.bulk.funder" | t(lang) }}</label>
                <select id="xp-bulk-fun" class="input xp-select xp-bulk-sel" x-model="bulkFunder">
                  <option value="">{{ "expenses.bulk.funder" | t(lang) }}</option>
                  <template x-for="x in funders()" :key="x.id"><option :value="x.id" x-text="lbl(x.name)"></option></template>
                </select>
                <button type="button" class="btn-secondary btn-sm" :disabled="!bulkFunder" @click="bulkSetFunder()">{{ "expenses.bulk.apply" | t(lang) }}</button>
                <label class="sr-only" for="xp-bulk-cat">{{ "expenses.bulk.category" | t(lang) }}</label>
                <select id="xp-bulk-cat" class="input xp-select xp-bulk-sel" x-model="bulkCat">
                  <option value="">{{ "expenses.bulk.category" | t(lang) }}</option>
                  <template x-for="c in bulkCats()" :key="c.id"><option :value="c.id" x-text="lbl(c.label)"></option></template>
                </select>
                <button type="button" class="btn-secondary btn-sm" :disabled="!bulkCat" @click="bulkSetCat()">{{ "expenses.bulk.apply" | t(lang) }}</button>
              </div>
            </div>

            {#- nothing matches -#}
            <template x-if="!filtered().length">
              <div class="empty-state mt-4">
                <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-surface-2 text-faint">{% icon "search-x", "size-6" %}</span>
                <p class="font-semibold text-ink">{{ "expenses.list.none_title" | t(lang) }}</p>
                <p class="mx-auto mt-1 max-w-md text-sm" x-show="f.period !== 'all'">{{ "expenses.list.none_period" | t(lang) }}</p>
                <div class="mt-4 flex flex-wrap justify-center gap-2">
                  <button type="button" class="btn-secondary btn-sm" x-show="anyFilter()" @click="clearFilters()">{{ "expenses.f.clear" | t(lang) }}</button>
                  <button type="button" class="btn-secondary btn-sm" x-show="f.period !== 'all'" @click="setPeriod('all')">{{ "expenses.list.show_all_periods" | t(lang) }}</button>
                </div>
              </div>
            </template>

            {#- wide screens: a table -#}
            <template x-if="wide && filtered().length">
              <div class="xp-table-wrap" role="region" tabindex="0" aria-labelledby="xp-list-cap">
                <table class="xp-table xp-list">
                  <caption id="xp-list-cap" class="sr-only">{{ "expenses.list.caption" | t(lang) }}</caption>
                  <thead>
                    <tr>
                      <th scope="col" class="xp-c-sel"><label class="xp-check"><input type="checkbox" :checked="allShownSel()" @change="toggleAllShown()"><span class="sr-only">{{ "expenses.list.select_shown" | t(lang) }}</span></label></th>
                      <th scope="col" class="xp-c-date">{{ "expenses.field.date" | t(lang) }}</th>
                      <th scope="col">{{ "expenses.field.description" | t(lang) }}</th>
                      <th scope="col" class="xp-c-cat">{{ "expenses.field.category" | t(lang) }}</th>
                      <th scope="col" class="xp-c-fun">{{ "expenses.field.funder" | t(lang) }}</th>
                      <th scope="col" class="xp-c-st">{{ "expenses.field.status" | t(lang) }}</th>
                      <th scope="col" class="xp-c-amt">{{ "expenses.field.amount" | t(lang) }}</th>
                      <th scope="col" class="xp-c-act"><span class="sr-only">{{ "expenses.list.actions" | t(lang) }}</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    <template x-for="r in rows()" :key="r.id">
                      <tr :class="{ 'is-flash': flashId === r.id, 'is-sel': isSel(r.id) }">
                        <td class="xp-c-sel"><label class="xp-check"><input type="checkbox" :checked="isSel(r.id)" @change="toggleSel(r.id)"><span class="sr-only" x-text="t('list.select', { what: r.desc })"></span></label></td>
                        <td class="xp-c-date" x-text="r.date"></td>
                        <td class="xp-c-desc">
                          <span class="xp-desc"><span x-text="r.desc"></span><span class="xp-flags"><span class="xp-rc" x-show="r.receipt !== 'none'" :title="t('receipt.' + r.receipt)">{% icon "paperclip", "size-3.5" %}<span class="sr-only" x-text="t('receipt.' + r.receipt)"></span></span><span class="badge-muted" x-show="r.direct">{{ "expenses.list.direct" | t(lang) }}</span><span class="badge-muted" x-show="r.example">{{ "expenses.list.example" | t(lang) }}</span></span></span>
                          <span class="xp-sub meta-row"><span class="xp-sub-cat" x-text="r.cat"></span><span class="xp-sub-fun" x-show="r.funder" x-text="r.funder"></span><span x-show="r.miles" x-text="r.miles"></span><span x-show="r.sub" x-text="r.sub"></span></span>
                        </td>
                        <td class="xp-c-cat"><span class="xp-cat" :class="r.tone"><span class="xp-cat-i" x-xp-icon="r.icon"></span><span x-text="r.cat"></span></span></td>
                        <td class="xp-c-fun" x-text="r.funder"></td>
                        <td class="xp-c-st"><span class="xp-status" x-show="r.status" :class="'is-' + r.status"><span x-xp-icon="r.statusIcon"></span><span x-text="r.statusText"></span></span></td>
                        <td class="xp-c-amt"><span class="xp-amt" :class="'is-' + r.flow"><span x-show="r.flow === 'in'" aria-hidden="true">{% icon "arrow-down-left", "size-3.5" %}</span><span x-text="r.amount"></span></span></td>
                        <td class="xp-c-act">
                          <div class="xp-acts">
