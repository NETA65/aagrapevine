---js
// (JavaScript front matter: the pagination's `before` and the page's data are functions. The imports are read from
// the project's top folder, where every build runs — not from this file's folder. Every name here is page data.)
import { eventPageData } from "./eleventy/event-page-model.js";

// the event pages kept OUT of search results, in each language (eventPagePlan's tier "date": a date of a monthly
// series, an event from Grapevine's or La Viña's own calendar, an event that is over while events.json keeps it) —
// a full page all the same, for whoever follows a shared link or the card's title
const pagination = {
  data: "db.events.items", size: 1, alias: "share",
  before: (items, full) => eventPageData(full).pages.filter((p) => !p.index),
};
const permalink = (data) => data.share.path + "index.html";
const layout = "layouts/base.njk";
const pageKey = "events";
const pageScripts = ["/assets/js/committee.js"];
// noindex (base.njk: robots noindex, its own canonical, no hreflang, no structured data), out of the sitemap and of
// the collections (src/pages/sitemap.11ty.js lists a pagination's every page: this template is all noindex)
const noindex = true;
const sitemap = false;
const eleventyExcludeFromCollections = true;
const eleventyComputed = {
  lang: (data) => data.share.lang,
  title: (data) => data.share.head.title,
  titleTail: (data) => data.share.head.titleTail,
  description: (data) => data.share.head.description,
  ogImage: (data) => data.share.head.ogImage,
};
---
