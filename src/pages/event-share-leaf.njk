---js
// (JavaScript front matter: the pagination's `before` and the page's data are functions. The imports are read from
// the project's top folder, where every build runs — not from this file's folder. Every name here is page data: the
// pages' plan is eleventy/event-pages.js, what they say eleventy/event-page-model.js.)
import { eventPageData } from "./eleventy/event-page-model.js";

// the INDEXABLE event pages, in each language (eventPagePlan's p.index: an event still to come, not a date of a
// monthly series, not from Grapevine's or La Viña's own calendars) — the noindex ones are event-share-date.njk's, the
// series' pages event-share-series.njk's, a cancelled event's notice event-share-cancelled.njk's: one plan for all
// four, so no address is written twice
const pagination = {
  data: "db.events.items", size: 1, alias: "share",
  before: (items, full) => eventPageData(full).pages.filter((p) => p.index),
};
const permalink = (data) => data.share.path + "index.html";
const layout = "layouts/base.njk";
// under Events in the menu and the breadcrumb (base.njk: Home → Events → the event)
const pageKey = "events";
// the "Add to calendar" menu, its .ics file and the flyer's viewer (src/assets/js/committee.js)
const pageScripts = ["/assets/js/committee.js"];
// its title (with its day — " — <its city>" when another page of the language has that title), the tail of the tab's
// title, its description (≤ 160 characters, never how to join) and its share picture (the flyer): eventPageHead
const eleventyComputed = {
  lang: (data) => data.share.lang,
  title: (data) => data.share.head.title,
  titleTail: (data) => data.share.head.titleTail,
  description: (data) => data.share.head.description,
  ogImage: (data) => data.share.head.ogImage,
};
---
{#- An event's own page, INDEXABLE (since round 35 for the "leaves"; since round 37 for every event still to come):
    /events/<its card's anchor>/ (/es/events/…/) — eventPagePlan's tier "leaf" (held at a place with a real address in
    both languages, no page of its own elsewhere: its Event's structured data on the page — Google's event results take
    only "a unique URL (a leaf page) and markup on that URL") or "page" (a place to be announced, online only, its own
    page on neta65.org …: no Event markup). A page of the site like the others (base.njk): the header and footer, the
    site's graph with its breadcrumb (Home → Events → the event), its own address as canonical, its twin in the other
    language (hreflang — the plan pairs the languages), indexable and in the sitemap (the [seo] check: its <title> names
    its day). Once the event is over, the next build writes its page with event-share-date.njk (noindex), and it leaves
    the sitemap. What the page says: src/_includes/partials/event-page.njk. -#}
