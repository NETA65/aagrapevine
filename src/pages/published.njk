---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}published/index.html"
layout: layouts/base.njk
pageKey: published
titleKey: nav.published
descKey: published.meta_desc
pageScripts: ["/assets/js/published.js", "/assets/js/published-archive.js"]
---
{#- PUBLISHED WRITERS — Grapevine / La Viña stories by writers from Area 65 (Northeast Texas),
    the rest of Texas and everywhere else, from db.spotlight (data/site/spotlight.json, built
    daily by scripts/sync/build_data.py; see docs/DATA_SCHEMA.md "spotlight.json").
    View model: eleventy/filters/published.js → pwView. EVERY story of the longest window is
    rendered here; the DEFAULT view (config/site.yml spotlight.default_scope + the first
    list_days window, both magazines, no search) is visible without JavaScript and the rest
    carry `hidden`. Each group shows its 12 most recent stories (V.limit) and then "see more";
    the default view's stories past the 12 carry data-pw-over (shown without JavaScript, hidden
    from the first paint with it, published.css). /assets/js/published.js then filters these same cards in place:
    scope / period / magazine / search, counts, empty states, URL state ?scope=&days=&pub=&q=,
    recounting the windows from the browser's own today (America/Chicago) with data-date.
    Below them, the Texas writers archive (#archive — every year; db.writers_archive → pwArchive): the
    same filter card drives it (scope, magazine, search) and it adds the decade; its Area 65 rows are
    rendered here, the rest of Texas comes from /published/texas-archive.json when the scope asks for it
    (/assets/js/published-archive.js, ?dec=1990s). No archive file → no archive section. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set V = db | pwView(lang) -%}
{%- set A = db | pwArchive(lang) -%}
{%- set D = V.defDays -%}
{%- set SC = V.defScope -%}
{%- set scopeIcon = { neta65: "map-pin", texas: "map-pin", other: "globe", unknown: "user-round" } -%}
{%- set groupIcon = { neta65: "map-pinned", texas: "map", other: "globe", unknown: "feather" } -%}
{%- set pubName = { gv: "Grapevine", lv: "La Viña" } -%}
{%- set nShown = V.counts[D][SC].all -%}

{#- ---------- one story card (published.js only shows / hides these) ----------
    Icons come from the sprite below ({{ name | pwIcon }} → <use href="#pw-i-name">): the
    card repeats 150+ times, so each icon is defined once. Add a new card icon to CARD_ICONS. -#}
{%- set CARD_ICONS = "quote,map-pin,globe,user-round,feather,grapes,lock,lock-open,sparkles,languages,headphones,mail" -%}
{% macro pwCard(it, lang) -%}
<article class="pw-card" data-scope="{{ it.scope }}" data-pub="{{ it.pub }}" data-date="{{ it.date }}" data-s="{{ it.search }}"{% if it.over %} data-pw-over{% elif not it.visible %} hidden{% endif %}><div class="pw-card-in">
<div class="pw-media" data-pub="{{ it.pub }}">
<div class="pw-tile" aria-hidden="true"><span class="pw-tile-mark">{{ "quote" | pwIcon("size-6") | safe }}</span><span class="pw-tile-pub">{{ pubName[it.pub] }}</span>{% if it.issue %}<span class="pw-tile-issue">{{ it.issue }}</span>{% endif %}</div>
{%- if it.image %}<img src="{{ it.image }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}
<span class="pw-scope" data-scope="{{ it.scope }}">{{ scopeIcon[it.scope] | pwIcon("size-3.5") | safe }}{{ ("published.badge." + it.scope) | t(lang) }}</span>
</div>
<div class="pw-body">
<div class="pw-byline"><span class="pw-avatar" data-scope="{{ it.scope }}" aria-hidden="true">{% if it.initials %}{{ it.initials }}{% else %}{{ "feather" | pwIcon("size-4") | safe }}{% endif %}</span>
<div class="min-w-0"><p class="pw-writer"><span class="sr-only">{{ "published.writer" | t(lang) }}: </span>{{ it.author }}</p>
<p class="pw-place">{% if it.place %}{{ it.place }}{% if it.county %}<span class="pw-county"> · {{ it.county }}</span>{% endif %}{% else %}{{ "published.place_unknown" | t(lang) }}{% endif %}</p></div></div>
<h3 class="pw-title"{% if it.titleLang and it.titleLang != lang %} lang="{{ it.titleLang }}"{% endif %}><a class="pw-link" href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}{% if it.host %}<span class="sr-only"> {{ "published.opens_on" | t(lang, {host: it.host}) }}</span>{% endif %}</a></h3>
{%- if it.origTitle %}
<p class="pw-orig"><span class="sr-only">{{ "published.original_title" | t(lang) }}: </span><span lang="{{ it.origLang }}">{{ it.origTitle }}</span></p>
{%- endif %}
<p class="pw-issue"><span class="{{ 'badge-lv' if it.pub == 'lv' else 'badge-gv' }}">{{ "grapes" | pwIcon("size-3") | safe }} {{ pubName[it.pub] }}</span>{% if it.issue %}<span>{{ it.issue }}</span>{% endif %}</p>
{%- if it.meta.length %}
<p class="pw-meta">{{ it.meta | join(" · ") }}</p>
{%- endif %}
<div class="pw-foot"><time datetime="{{ it.date }}">{{ "published.published_on" | t(lang, {date: it.date | fmtDate(lang, "medium")}) }}</time>
{%- if it.free === false %}<span class="pw-flag" title="{{ 'published.subscribers_help' | t(lang) }}">{{ "lock" | pwIcon("size-3") | safe }}{{ "published.subscribers" | t(lang) }}</span>
{%- elif it.free === true %}<span class="pw-flag">{{ "lock-open" | pwIcon("size-3") | safe }}{{ "published.free" | t(lang) }}</span>{% endif %}
{%- if it.exclusive %}<span class="pw-flag">{{ "sparkles" | pwIcon("size-3") | safe }}{{ "published.online_exclusive" | t(lang) }}</span>{% endif %}
{%- if it.isNew %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
{%- if it.machine %}<span class="auto-note" title="{{ 'common.auto_translated_help' | t(lang) }}">{{ "languages" | pwIcon("size-3") | safe }} {{ "common.auto_translated" | t(lang) }}</span>{% endif %}</div>
</div>
</div></article>
{%- endmacro %}

{#- ---------- one filter choice: a native radio inside a chip (arrow keys move between them) ---------- -#}
{% macro pwChip(name, value, label, n, checked, dot="") -%}
<label class="pw-chip{{ ' is-zero' if not n }}"><input type="radio" class="sr-only" name="{{ name }}" value="{{ value }}"{% if checked %} checked{% endif %} disabled data-pw-ctl>
  {%- if dot %}<span class="pw-dot" data-pub="{{ dot }}" aria-hidden="true"></span>{% endif -%}
  <span>{{ label }}</span><span class="pw-n" data-n>{{ n }}</span></label>
{%- endmacro %}

{#- ---------- one archive story: a compact row (published-archive.js → buildRow() writes the same markup
    for the rest of Texas; keep them in sync). One link (the title, stretched over the row); the byline as
    the magazine printed it (a meta-row: writer · place · county); a meta-row of magazine · issue · theme ·
    audio / online exclusive / letter flags; the magazine's own subtitle. The Area 65 badge after the title
    shows when other rows are listed with it. lang on any text in the other language.
    A machine translation: the translated title says so inside its link (sr-only "(Auto-translated)") and its
    "Original title:" line carries the languages icon; a translated subtitle under a title without that mark
    carries it itself (briefMachine). data-mt = the row holds one — the list's note (#pw-arc-mt) explains the icon.
    The row repeats ~400 times: the tile's icon is the short <use> form (its span is aria-hidden already). -#}
{% macro arcRow(r, lang) -%}
<li class="pw-arc-row" data-scope="{{ r.scope }}" data-pub="{{ r.pub }}" data-dec="{{ r.dec }}" data-y="{{ r.year or '' }}" data-o="{{ r.o }}" data-s="{{ r.search }}"{% if r.machine or r.briefMachine %} data-mt{% endif %}{% if r.over %} data-pw-over{% endif %}>
<span class="pw-arc-tile" data-pub="{{ r.pub }}" aria-hidden="true"><svg class="icon size-4"><use href="#pw-i-grapes"/></svg></span>
<div class="pw-arc-body">
<p class="pw-arc-title"><a class="pw-arc-link" href="{{ r.url }}" target="_blank" rel="noopener">{% if r.titleLang != lang %}<span lang="{{ r.titleLang }}">{{ r.title }}</span>{% else %}{{ r.title }}{% endif %}{% if r.machine %}<span class="sr-only"> ({{ "common.auto_translated" | t(lang) }})</span>{% endif %}<span class="sr-only"> {{ "published.opens_on" | t(lang, {host: r.host}) }}</span></a>{% if r.scope == "neta65" %} <span class="badge-vine pw-arc-a65">{{ "published.badge.neta65" | t(lang) }}</span>{% endif %}</p>
{%- if r.origTitle %}
<p class="pw-arc-orig">{% if r.machine %}{{ "languages" | pwIcon("size-3") | safe }}{% endif %}<span class="sr-only">{{ "published.original_title" | t(lang) }}: </span><span lang="{{ r.origLang }}">{{ r.origTitle }}</span></p>
{%- endif %}
{%- if r.by.length %}
<p class="pw-arc-by meta-row"{% if r.multi %} data-w{% endif %}>{% for b in r.by %}<span>{% if loop.first %}<span class="sr-only">{{ ("published.archive.writers" if r.multi else "published.writer") | t(lang) }}: </span>{% endif %}{{ b }}</span>{% endfor %}{% if r.county %}<span class="pw-county">{{ r.county }}</span>{% endif %}</p>
{%- endif %}
<p class="pw-arc-meta meta-row"><span class="pw-arc-pub">{{ pubName[r.pub] }}</span>
  {%- if r.issue %}<span>{{ r.issue }}</span>{% endif %}
  {%- if r.theme %}<span class="pw-arc-theme"{% if r.themeLang != lang %} lang="{{ r.themeLang }}"{% endif %}>{{ r.theme }}</span>{% endif %}
  {%- if r.audio %}<span class="pw-arc-flag">{{ "headphones" | pwIcon("size-3") | safe }}{{ "published.archive.audio" | t(lang) }}</span>{% endif %}
  {%- if r.exclusive %}<span class="pw-arc-flag">{{ "sparkles" | pwIcon("size-3") | safe }}{{ "published.online_exclusive" | t(lang) }}</span>{% endif %}
  {%- if r.column %}<span class="pw-arc-flag">{{ "mail" | pwIcon("size-3") | safe }}{{ "published.archive.column" | t(lang) }}</span>{% endif -%}
</p>
{%- if r.brief %}
<p class="pw-arc-brief"{% if r.briefLang != lang %} lang="{{ r.briefLang }}"{% endif %}>{% if r.briefMachine %}{{ "languages" | pwIcon("size-3") | safe }}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}: </span>{% endif %}{{ r.brief }}</p>
{%- endif %}
</div></li>
{%- endmacro %}

{#- ---------- one decade choice of the archive: a native radio inside a chip, like pwChip
    (published-archive.js switches it on: data-arc-ctl) ---------- -#}
{% macro arcChip(value, label, n, checked) -%}
<label class="pw-chip{{ ' is-zero' if not n }}"><input type="radio" class="sr-only" name="pw-dec" value="{{ value }}"{% if checked %} checked{% endif %} disabled data-arc-ctl><span>{{ label }}</span><span class="pw-n" data-n>{{ n }}</span></label>
{%- endmacro %}

{#- ---------- hero ----------
    Its right-hand card (the shared hero aside, from 1024px): "Your story could be next" — the next
    Grapevine story deadline (db.editorial, the same row /contribute/ shows — its date and theme only, no
    countdown here) with "How to send" → /contribute/#deadlines, its one home. The writers' counts and newest stories are right below (filters + list), so the card does not
    repeat them. No dated deadline → no card. "hide": smaller screens keep the filters first. -#}
{%- set pwNext = ((db.editorial.items | readEditorial("gv", lang)).upcoming | selectattr("isNext") | first) -%}
{% call(slot) ui.pageHero(lang, "nav.published" | t(lang), "published.hero_sub" | t(lang), "award", "published.eyebrow" | t(lang), { side: "hide" }) %}
{%- if slot == "side" %}
  {%- if pwNext %}
  {% call ui.heroAside("published.aside_title" | t(lang), lang, { id: "pw-aside-title", icon: "pen-line", href: ('/contribute/' | lurl(lang)) + "#deadlines", linkLabel: "published.aside_link" | t(lang) }) %}
    <p class="hero-aside-note">{{ "read.contrib.next_deadline" | t(lang) }}</p>
    <p class="hero-aside-stat">
      <span class="hero-aside-value"><time datetime="{{ pwNext.deadline }}">{% if lang == "es" %}{{ pwNext.deadline | fmtDate(lang, "day") }} {{ pwNext.deadline | fmtDate(lang, "monthShort") }}{% else %}{{ pwNext.deadline | fmtDate(lang, "monthShort") }} {{ pwNext.deadline | fmtDate(lang, "day") }}{% endif %}</time></span>
    </p>
    <p class="hero-aside-title mt-2"><span lang="{{ pwNext.themeLang }}">{{ pwNext.theme }}</span>{% if pwNext.machine %} <span title="{{ 'common.auto_translated' | t(lang) }}">{% icon "languages", "inline size-3.5 align-[-0.1em] opacity-80" %}<span class="sr-only">({{ "common.auto_translated" | t(lang) }})</span></span>{% endif %}</p>
    <p class="hero-aside-note">{% if pwNext.issueLabel %}{{ "read.contrib.for_issue" | t(lang, { issue: pwNext.issueLabel }) }} · {% endif %}{{ "read.contrib.aside_gv" | t(lang) }}</p>
    {% if lang == "es" %}<p class="hero-aside-note">{{ "read.contrib.aside_lv" | t(lang) }}</p>{% endif %}
  {% endcall %}
  {%- endif %}
{%- else %}
  {#- With the archive: Contribute · the archive · How (the third button hidden below 768px, ui.njk) -#}
  <div class="hero-actions">
    <a class="btn-light" href="{{ '/contribute/' | lurl(lang) }}">{% icon "pen-line", "size-4" %} {{ "nav.contribute" | t(lang) }}</a>
    {%- if A.total and A.since.all %}
    <a class="btn-on-dark" href="#archive">{% icon "library-big", "size-4" %} {{ "published.cta_archive" | t(lang, {since: A.since.all}) }}</a>
    {%- endif %}
    <a class="btn-on-dark {{ 'max-md:hidden' if (A.total and A.since.all) else 'max-sm:hidden' }}" href="#pw-how">{% icon "info", "size-4" %} {{ "published.cta_how" | t(lang) }}</a>
  </div>
{%- endif %}
{% endcall %}

{#- ---------- filters (tucked into the hero's faded edge) ---------- -#}
<section class="container-page page-overlap" aria-labelledby="pw-filters-title">
  <form id="pw-form" class="card card-pad pw-filters" role="search" aria-labelledby="pw-filters-title" action="{{ '/published/' | lurl(lang) }}" method="get" autocomplete="off">
    <h2 id="pw-filters-title" class="sr-only">{{ "published.filters_title" | t(lang) }}</h2>
    {#- The controls are enabled by published.js (data-pw-ctl); without JavaScript the default
        list below is the whole page and the <noscript> note says so. -#}
    <div class="pw-filter-row">
      <fieldset class="pw-group-fs">
        <legend class="pw-legend">{{ "published.scope_legend" | t(lang) }}</legend>
        <div class="pw-chips">
          {%- for s in ["neta65", "texas", "all"] %}
          {{ pwChip("scope", s, ("published.scope." + s) | t(lang), V.counts[D][s].all, s == SC) }}
          {%- endfor %}
        </div>
      </fieldset>
      <fieldset class="pw-group-fs">
        <legend class="pw-legend">{{ "published.days_legend" | t(lang) }}</legend>
        <div class="pw-chips">
          {%- for d in V.listDays %}
          {{ pwChip("days", d, "published.days" | t(lang, {n: d}), V.counts[d][SC].all, d == D) }}
          {%- endfor %}
        </div>
      </fieldset>
      <fieldset class="pw-group-fs">
        <legend class="pw-legend">{{ "published.pub_legend" | t(lang) }}</legend>
        <div class="pw-chips">
          {{ pwChip("pub", "all", "published.pub.all" | t(lang), V.counts[D][SC].all, true) }}
          {{ pwChip("pub", "gv", "Grapevine", V.counts[D][SC].gv, false, "gv") }}
          {{ pwChip("pub", "lv", "La Viña", V.counts[D][SC].lv, false, "lv") }}
        </div>
      </fieldset>
    </div>
    <div class="pw-find-row">
      <div class="pw-search">
        <label for="pw-q" class="pw-legend">{{ "published.search_label" | t(lang) }}</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-faint">{% icon "search", "size-4" %}</span>
          <input id="pw-q" name="q" type="search" class="input pw-q pl-10 pr-12" placeholder="{{ 'published.search_ph' | t(lang) }}" maxlength="100" spellcheck="false" autocapitalize="off" enterkeyhint="search" aria-describedby="pw-status" disabled data-pw-ctl>
          <button type="button" id="pw-q-clear" class="absolute right-1 top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full text-muted transition hover:bg-surface-2 hover:text-ink" aria-label="{{ 'published.search_clear' | t(lang) }}" hidden>{% icon "x", "size-4" %}</button>
        </div>
      </div>
      <div class="pw-status-row">
        <p id="pw-status" class="pw-status" role="status" aria-live="polite">
          {%- if nShown %}{{ ("published.status." + SC + (".one" if nShown == 1 else ".other")) | t(lang, {n: nShown, days: D}) }}
          {%- else %}{{ ("published.empty." + SC) | t(lang, {days: D}) }}{% endif -%}
        </p>
        <button type="button" id="pw-reset" class="pw-reset" hidden>{% icon "rotate-ccw", "size-3.5" %} {{ "published.reset" | t(lang) }}</button>
      </div>
    </div>
    <noscript><p class="pw-noscript">{% icon "info", "size-4 shrink-0" %}<span>{{ "published.noscript" | t(lang) }}</span></p></noscript>
  </form>
</section>

{#- ---------- results ---------- -#}
<section class="section container-page pt-10 sm:pt-12" aria-label="{{ 'published.results_label' | t(lang) }}">
  <div id="pw-results" class="pw-results">
      {{ CARD_ICONS | pwSprite | safe }}
      {%- for g in V.groups %}
      <section class="pw-group" data-group="{{ g.key }}" aria-labelledby="pw-g-{{ g.key }}"{% if not g.matchCount %} hidden{% endif %}>
        <div class="pw-group-head">
          <span class="pw-group-icon" data-scope="{{ g.key }}" aria-hidden="true">{% icon groupIcon[g.key], "size-5" %}</span>
          <div class="min-w-0">
            <h2 id="pw-g-{{ g.key }}" class="pw-group-title">{{ ("published.group." + g.key) | t(lang) }} <span class="pw-group-n" data-group-n>{{ g.matchCount | pwStories(lang) }}</span></h2>
            <p class="pw-group-desc">{{ ("published.group_desc." + g.key) | t(lang, {n: V.countyCount}) }}</p>
          </div>
        </div>
        <div class="grid-cards pw-grid">
          {%- for it in g.items %}
          {{ pwCard(it, lang) }}
          {%- endfor %}
        </div>
        {#- "see more": Area 65 → "Show all N from our Area" (every story of the window, or — when all
            are shown and a longer window holds more — that window); other groups → "Show 12 more",
            then "Show all N stories". JavaScript only: without it every story of the view shows. -#}
        {%- if g.hiddenByLimit and g.key == "neta65" %}{% set moreLabel = "published.show_all_area" | t(lang, {n: g.matchCount}) %}
        {%- elif g.hiddenByLimit and g.hiddenByLimit <= V.limit %}{% set moreLabel = "published.show_all" | t(lang, {n: g.matchCount}) %}
        {%- elif g.hiddenByLimit %}{% set moreLabel = "published.show_more" | t(lang, {k: V.limit}) %}
        {%- elif g.widen %}{% set moreLabel = "published.show_all_area" | t(lang, {n: g.widen.n}) %}
        {%- else %}{% set moreLabel = "" %}{% endif %}
        <div class="pw-showall" data-js-only{% if not moreLabel %} hidden{% endif %}>
          <button type="button" class="btn-secondary" data-pw-showall="{{ g.key }}" data-mode="{{ 'widen' if (g.widen and not g.hiddenByLimit) else 'more' }}"{% if g.widen %} data-v="{{ g.widen.days }}"{% endif %} aria-describedby="pw-more-{{ g.key }}">{% icon "chevron-down", "size-4" %}<span data-label>{{ moreLabel }}</span></button>
          <p id="pw-more-{{ g.key }}" class="pw-showall-note" data-note>
            {%- if g.hiddenByLimit %}{{ "published.shown_of" | t(lang, {shown: g.shownCount, n: g.matchCount}) }}
            {%- elif g.widen %}{{ "published.widen_note" | t(lang, {days: g.widen.days}) }}{% endif -%}
          </p>
        </div>
      </section>
      {%- endfor %}

      {#- nothing in this view: say so, and offer wider views + Share Your Story -#}
      <div id="pw-empty" class="pw-empty"{% if nShown %} hidden{% endif %}>
        <span class="pw-empty-icon" aria-hidden="true">{% icon "feather", "size-6" %}</span>
        <h2 id="pw-empty-title" class="pw-empty-title">{{ ("published.empty." + SC) | t(lang, {days: D}) }}</h2>
        <p class="pw-empty-text">{{ "published.empty.text" | t(lang) }}</p>
        <div class="pw-empty-actions">
          {%- for d in V.listDays %}
          <button type="button" class="btn-secondary btn-sm" data-pw-set="days" data-v="{{ d }}"{% if d <= D or not V.counts[d][SC].all %} hidden{% endif %}>{% icon "calendar-range", "size-4" %}<span>{{ "published.btn.days" | t(lang, {n: d}) }}</span><span class="pw-n" data-n>{{ V.counts[d][SC].all }}</span></button>
          {%- endfor %}
          <button type="button" class="btn-secondary btn-sm" data-pw-set="scope" data-v="texas"{% if SC != "neta65" or not V.counts[D].texas.all %} hidden{% endif %}>{% icon "map", "size-4" %}<span>{{ "published.btn.texas" | t(lang) }}</span><span class="pw-n" data-n>{{ V.counts[D].texas.all }}</span></button>
          <button type="button" class="btn-secondary btn-sm" data-pw-set="scope" data-v="all"{% if SC == "all" or not V.counts[D].all.all %} hidden{% endif %}>{% icon "globe", "size-4" %}<span>{{ "published.btn.all" | t(lang) }}</span><span class="pw-n" data-n>{{ V.counts[D].all.all }}</span></button>
          <button type="button" class="btn-secondary btn-sm" data-pw-clear hidden>{% icon "x", "size-4" %}<span>{{ "published.btn.clear" | t(lang) }}</span></button>
          {%- if A.total %}
          <a class="btn-secondary btn-sm" href="#archive">{% icon "library-big", "size-4" %}<span>{{ "published.btn.archive" | t(lang) }}</span></a>
          {%- endif %}
          <a class="btn-primary btn-sm" href="{{ '/contribute/' | lurl(lang) }}">{% icon "pen-line", "size-4" %} {{ "nav.contribute" | t(lang) }}</a>
        </div>
      </div>

      {#- there are more Texas writers (or writers elsewhere) than this view shows -#}
      <div id="pw-nudge" class="pw-nudge"{% if not (V.nextScope and V.moreCount > 0 and nShown > 0) %} hidden{% endif %}>
        <span class="pw-nudge-icon" aria-hidden="true">{% icon "map", "size-5" %}</span>
        <p id="pw-nudge-text" class="pw-nudge-text">{% if V.nextScope %}{{ ("published.more." + V.nextScope) | t(lang, {days: D, stories: V.moreCount | pwStories(lang)}) }}{% endif %}</p>
        <button type="button" class="btn-secondary btn-sm shrink-0" data-pw-nudge data-v="{{ V.nextScope }}">
          <span data-label>{% if V.nextScope %}{{ ("published.btn." + V.nextScope) | t(lang) }}{% endif %}</span>{% icon "arrow-right", "size-4" %}
        </button>
      </div>

  </div>
</section>

{#- ---------- the Texas writers archive: every year (db.writers_archive → pwArchive) ----------
    Rows, not cards (≈1,300 stories). The filter card above drives it too — scope (Area 65 → the Area 65
    rows; All of Texas / Everyone → all of Texas, Area 65 marked), magazine and search; the archive adds the
    decade and the Area 65 hometown chips. The Area 65 rows are rendered here, grouped by decade, newest
    first: without JavaScript all of them show; with it the first A.page (data-pw-over: hidden from the first
    paint, published.css), then "Show 40 more" / "Show all N". The rest of Texas comes from
    /published/texas-archive.json (A.json) when the scope asks for it; a decade with no Area 65 story starts
    hidden and empty. -#}
{%- if A.total %}
{%- set arcNums = { n: A.total | pwNum(lang), area: A.area | pwNum(lang), gv: A.since.gv, lv: A.since.lv } -%}
{%- set arcSub = ("published.archive.sub" if (A.since.gv and A.since.lv) else "published.archive.sub_plain") | t(lang, arcNums) -%}
<section id="archive" class="section container-page pt-0" aria-labelledby="pw-arc-title">
  {{ ui.sectionHead("published.archive.title" | t(lang), arcSub | escape, "", "", "library-big", { eyebrow: ("published.archive.eyebrow" | t(lang, {since: A.since.all})) if A.since.all else ("nav.published" | t(lang)), tone: "text-vine", id: "pw-arc-title", lang: lang }) }}
  <div id="pw-arc" class="pw-arc" data-scope="neta65">
    <div class="card card-pad pw-arc-panel">
      {%- if A.top.length %}
      {#- the Area 65 hometowns with the most stories: a tap puts the name into the page's search box -#}
      <div class="pw-arc-places" role="group" aria-labelledby="pw-arc-places-label" data-js-only>
        <p id="pw-arc-places-label" class="pw-legend">{{ "published.archive.places" | t(lang) }}</p>
        <div class="chip-row">
          {%- for p in A.top %}
          <button type="button" class="pw-chip pw-arc-place{{ ' is-zero' if not p.n }}" data-arc-place="{{ p.label }}" disabled data-arc-ctl>{{ "map-pin" | pwIcon("size-3.5") | safe }}<span>{{ p.label }}</span><span class="pw-n" data-n>{{ p.n }}</span></button>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}
      <fieldset class="pw-group-fs pw-arc-decades">
        <legend class="pw-legend">{{ "published.archive.decade_legend" | t(lang) }}</legend>
        <div class="chip-row">
          {{ arcChip("all", "published.archive.dec_all" | t(lang), A.counts.neta65.all.all, true) }}
          {%- for d in A.decades %}
          {{ arcChip(d.key, d.label, A.counts.neta65.all[d.key], false) }}
          {%- endfor %}
        </div>
      </fieldset>
      <div class="pw-arc-status-row">
        <p id="pw-arc-status" class="pw-status" role="status" aria-live="polite">
          {%- if A.area %}{{ ("published.archive.status.neta65" + (".one" if A.area == 1 else ".other")) | t(lang, {n: A.area | pwNum(lang), when: ("published.archive.when.since" | t(lang, {year: A.since.all})) if A.since.all else ""}) | trim }}
          {%- else %}{{ "published.archive.empty_title" | t(lang) }}{% endif -%}
        </p>
        <button type="button" class="pw-reset" data-arc-retry hidden>{% icon "rotate-cw", "size-3.5" %} {{ "published.archive.retry" | t(lang) }}</button>
      </div>
      <p id="pw-arc-note" class="pw-arc-note" hidden>{% icon "info", "size-4 shrink-0" %}<span>{{ "published.archive.texas_only" | t(lang) }}</span></p>
      <noscript><p class="pw-noscript">{% icon "info", "size-4 shrink-0" %}<span>{{ "published.archive.noscript" | t(lang, {n: A.total | pwNum(lang)}) }}</span></p></noscript>
    </div>

    {#- a machine translation in the list (a title or a subtitle — its row has data-mt): one note for the list,
        like /read/'s; published-archive.js shows it while such a row is shown -#}
    <p id="pw-arc-mt" class="auto-note pw-arc-mt"{% if not A.mt %} hidden{% endif %}>{{ "languages" | pwIcon("size-3") | safe }} {{ ("read.mt_note_en" if lang == "es" else "read.mt_note_es") | t(lang) }}</p>

    <div id="pw-arc-list" class="pw-arc-list">
      {%- for d in A.decades %}
      <div class="pw-arc-dec" data-dec="{{ d.key }}"{% if not d.n %} hidden{% elif d.over %} data-pw-over{% endif %}>
        <h3 id="pw-arc-d-{{ d.key }}" class="pw-arc-dec-title">{{ d.label }} <span class="pw-group-n" data-arc-n>{{ d.n | pwStories(lang) }}</span></h3>
        <ol class="pw-arc-rows card" role="list" aria-labelledby="pw-arc-d-{{ d.key }}">
          {%- for r in d.rows %}
          {{ arcRow(r, lang) }}
          {%- endfor %}
        </ol>
      </div>
      {%- endfor %}
    </div>

    {#- nothing matches: say so, and offer the ways out. The help line follows the cause (published-archive.js):
        a search → another spelling or a nearby town; no search → the decade and magazine chosen. -#}
    <div id="pw-arc-empty" class="pw-empty pw-arc-empty"{% if A.area %} hidden{% endif %}>
      <span class="pw-empty-icon" aria-hidden="true">{% icon "search-x", "size-6" %}</span>
      <h3 class="pw-empty-title">{{ "published.archive.empty_title" | t(lang) }}</h3>
      <p class="pw-empty-text" data-arc-empty-text hidden></p>
      <div class="pw-empty-actions">
        <button type="button" class="btn-secondary btn-sm" data-arc-clear hidden>{% icon "x", "size-4" %}<span>{{ "published.search_clear" | t(lang) }}</span></button>
        <button type="button" class="btn-secondary btn-sm" data-arc-alldec hidden>{% icon "calendar-range", "size-4" %}<span>{{ "published.archive.btn_all_dec" | t(lang) }}</span></button>
        <button type="button" class="btn-secondary btn-sm" data-arc-allpub hidden>{% icon "grapes", "size-4" %}<span>{{ "published.archive.btn_all_pub" | t(lang) }}</span></button>
        <button type="button" class="btn-secondary btn-sm" data-arc-texas hidden>{% icon "map", "size-4" %}<span>{{ "published.btn.texas" | t(lang) }}</span></button>
      </div>
    </div>

    {#- "Show 40 more" / "Show all N" with "Showing 40 of N" (JavaScript only: without it every row shows) -#}
    <div id="pw-arc-more" class="pw-showall" data-js-only hidden>
      <div class="pw-arc-more-btns">
        <button type="button" class="btn-secondary" data-arc-more="page" aria-describedby="pw-arc-shown">{% icon "chevron-down", "size-4" %}<span data-label>{{ "published.show_more" | t(lang, {k: A.page}) }}</span></button>
        <button type="button" class="btn-secondary" data-arc-more="all" aria-describedby="pw-arc-shown">{% icon "list-plus", "size-4" %}<span data-label>{{ "published.show_all" | t(lang, {n: A.area | pwNum(lang)}) }}</span></button>
      </div>
      <p id="pw-arc-shown" class="pw-showall-note"></p>
    </div>
  </div>
</section>
{%- endif %}

{#- ---------- how this list is made (under the results: an explanation, not sidebar material) ---------- -#}
<section id="pw-how" class="section container-page pt-0" aria-labelledby="pw-how-title">
  {% call ui.sectionHead("published.how.title" | t(lang), "", "", "", "info", { eyebrow: "published.aside_label" | t(lang), id: "pw-how-title", lang: lang }) %}{{ ui.freshness(V.updated, lang) }}{% endcall %}
  <div class="panel-muted">
    <ul class="pw-how" role="list">
      <li>{% icon "newspaper", "size-4" %}<span>{{ "published.how.printed" | t(lang) }}</span></li>
      <li>{% icon "refresh-cw", "size-4" %}<span>{{ "published.how.daily" | t(lang) }}</span></li>
      {#- a <div>, not a <span>: it holds the <details> county list (block content) -#}
      <li>{% icon "map", "size-4" %}<div>{{ "published.how.area" | t(lang, {n: V.countyCount}) }}
        {%- if V.counties.length %}
        <details class="pw-counties">
          <summary>{{ "published.how.counties" | t(lang, {n: V.countyCount}) }}</summary>
          <ul class="pw-county-list">
            {%- for c in V.counties %}<li>{{ c }}</li>{% endfor %}
          </ul>
        </details>
        {%- endif %}</div></li>
      <li>{% icon "landmark", "size-4" %}<span>{{ "published.how.census" | t(lang) }}</span></li>
      <li>{% icon "venetian-mask", "size-4" %}<span>{{ "published.how.unmatched" | t(lang) }}</span></li>
      <li>{% icon "calendar-range", "size-4" %}<span>{{ "published.how.window" | t(lang) }}</span></li>
      {%- if A.total and A.since.gv and A.since.lv %}
      <li>{% icon "library-big", "size-4" %}<span>{{ "published.how.archive" | t(lang, {gv: A.since.gv, lv: A.since.lv}) }}</span></li>
      {%- endif %}
    </ul>
  </div>
</section>

{#- ---------- closing: were you published? / write one ---------- -#}
<section class="section container-page pt-0" aria-labelledby="pw-tell-title">
  <div class="pw-tell">
    <span class="pw-tell-icon" aria-hidden="true">{% icon "award", "size-6" %}</span>
        <div class="pw-tell-copy">
          <h2 id="pw-tell-title" class="pw-tell-title">{{ "published.tell.title" | t(lang) }}</h2>
          <p class="pw-tell-text">{{ "published.tell.text" | t(lang) }}</p>
          <p class="pw-tell-text">{{ "published.tell.write" | t(lang) }}</p>
        </div>
        <div class="pw-tell-actions">
          {%- if site.contact_email %}
          <a class="btn-primary" href="{{ site.contact_email | pwMailto('published.tell.subject' | t(lang), 'published.tell.body' | t(lang)) }}">{% icon "mail", "size-4" %} {{ "published.tell.btn" | t(lang) }}</a>
          {%- endif %}
          <a class="btn-secondary" href="{{ '/contribute/' | lurl(lang) }}">{% icon "pen-line", "size-4" %} {{ "nav.contribute" | t(lang) }}</a>
          {%- if site.contact_email %}
          <p class="pw-tell-mail">{{ site.contact_email }}</p>
          {%- endif %}
        </div>
  </div>
</section>

{#- settings + strings for published.js -#}
<script type="application/json" id="pw-config">{{ {
  lang: lang,
  tz: site.timezone or "America/Chicago",
  today: V.today,
  listDays: V.listDays,
  defDays: D,
  defScope: SC,
  limit: V.limit,
  pubs: pubName,
  s: lang | pwStrings
} | pwJson | safe }}</script>
{%- if A.total %}
{#- settings + strings for published-archive.js: the JSON of the rest of Texas (site-relative: the script adds
    the base path; ?v= = the file's fingerprint, a new address whenever its rows change), the page size, the
    archive's first years and the counts for the chips before it is in -#}
<script type="application/json" id="pw-arc-config">{{ {
  lang: lang,
  json: ("/published/texas-archive.json" | lurl(lang)) + "?v=" + A.version,
  rest: A.restRows.length,
  page: A.page,
  since: A.since,
  counts: A.counts,
  pubs: pubName,
  s: lang | pwArcStrings
} | pwJson | safe }}</script>
{%- endif %}
