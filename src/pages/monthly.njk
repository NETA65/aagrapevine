---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}monthly/index.html"
layout: layouts/base.njk
pageKey: monthly
titleKey: monthly.title
ldType: CollectionPage
descKey: monthly.meta_desc
bodyClass: mp-hub
pageScripts: ["/assets/js/monthly.js", "/assets/js/report.js"]
pageStyles: ["/assets/css/monthly.css", "/assets/css/report.css"]
---
{#- /monthly/ — the "Monthly toolkit" (posters included). Flow (docs: ui.njk): hero → page nav → this month
    (a teaser with a one-line link to next month; the full toolkit lives on the month's own page,
    monthly-month.njk) → the GV/LV report → all posters (band) → the 10 ways (its header links the full
    editorial calendar when the committee has it on Drive). Prices stay in the shop.
    "This month" is live (monthly.js mpNow): its date chips are only the ones still to come — a chip whose
    time passes while the page is open hides itself (data-mp-chip / data-mp-over, src/assets/js/monthly.js)
    — plus the next committee meeting once this month's is over; a notice points to next month's page
    when the visitor's month has changed before the site was rebuilt (data-mp-newmonth); and it links to
    the month as a message for a group chat (the month page's #mp-message).
    #report is the one home of the GV/LV report a GVR / RLV tailors for the district meeting
    (eleventy/filters/report.js + src/assets/js/report.js; the old /districts/ page redirects here);
    its intro points to this month as a message and to last month's Monthly digest (/digest/: for a
    group chat or e-mail), which point back.
    This page is the canonical home of the district guide
    "how each month's magazine can be useful in carrying the message" (config/carry.yml).
    The months' pictures here are posters in miniature (macros/monthly.njk posterMini: the design and the
    theme, a few KB each), each linking to its month's page — the poster itself is there, never on this page.
    A machine-translated theme carries the site's mark (the icon, "Auto-translated" for screen readers; under
    a magazine box, its own words in italics, as /read/ shows them). -#}
{% import "macros/ui.njk" as ui with context %}
{% import "macros/monthly.njk" as mp with context %}
{%- set months = db | mpMonths(carry, site, lang) -%}
{%- set m = months[0] -%}
{%- set nm = months[1] -%}
{#- what is live this month: the next committee meeting (mpNow) -#}
{%- set nx = db | mpNow(site, lang) -%}
{%- set monthUrl = ('/monthly/' + m.key + '/') | lurl(lang) -%}

{#- the site's mark after a machine-translated theme (contribute.njk's): an icon, its words for screen readers -#}
{%- set mtMark -%}<span class="auto-note align-middle" title="{{ 'common.auto_translated' | t(lang) }} — {{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}</span></span>{%- endset -%}
{#- The hero's right-hand card (the shared hero aside): this month's poster, linking to its month page.
    It MOVES there from the "This month" card: while the card is in the hero (≥1024px at 100 % text)
    monthly.css hides the card's own poster column (.mp-now-poster) — never two copies; on smaller
    screens and at larger text the aside is hidden ("hide") and the card keeps its poster. -#}
{% call(slot) ui.pageHero(lang, "monthly.title" | t(lang), "monthly.hero_sub" | t(lang), "calendar-heart", "monthly.eyebrow" | t(lang), { side: "hide" }) %}
{%- if slot == "side" %}
  {% call ui.heroAside("monthly.hero_poster" | t(lang, { month: m.label }), lang, { id: "mp-aside-title", icon: "image", href: monthUrl, linkLabel: "monthly.hero_open" | t(lang), class: "mp-hero-aside" }) %}
    {#- the poster is a second way to the same page for the pointer (the heading's link is the one tab stop) -#}
    <a class="mp-hero-poster" href="{{ monthUrl }}" tabindex="-1" aria-hidden="true"><span class="mp-stage mp-stage--thumb" inert><span class="mp-fit">{{ mp.posterMini(m, lang) }}</span></span></a>
  {% endcall %}
{%- else %}
<div class="hero-actions">
  <a class="btn-light" href="{{ monthUrl }}">{% icon "image", "size-4" %} {{ "monthly.see_poster" | t(lang) }}</a>
</div>
{%- endif %}
{% endcall %}

<div class="container-page page-overlap">{{ ui.pageNav([
  { href: "#now", label: "monthly.this_month" | t(lang), icon: "calendar-heart" },
  { href: "#report", label: "monthly.nav_report" | t(lang), icon: "clipboard-list" },
  { href: "#posters", label: "monthly.nav_posters" | t(lang), icon: "image" },
  { href: "#ways" if carry.ways.length else "", label: "monthly.ways_link" | t(lang), icon: "list-checks" }
], lang) }}</div>

{#- ============ This month (a teaser: the full toolkit lives on the month's own page) ============ -#}
<section id="now" class="section container-page pt-10 sm:pt-12" aria-labelledby="mp-now-title">
  <div class="card overflow-hidden">
    <div class="mp-now">
      {#- (.mp-now-body / .mp-now-mag: less padding at large text on a phone — areas/monthly.css) -#}
      <div class="mp-now-body flex flex-col p-6 sm:p-8">
        <div class="md:my-auto">
          {#- shown by the browser once the visitor's month (Central time) is the next one while this build is
              still last month's (src/assets/js/monthly.js): that month's toolkit is the one to open -#}
          {% if nm %}
          <p class="mb-5 rounded-xl border border-lv bg-lv-soft px-4 py-3 text-sm" data-mp-newmonth="{{ nm.key }}" data-mp-newmonth-text="{{ 'monthly.newmonth' | t(lang) }}" role="status" hidden>
            <a class="tap-link inline-flex items-start gap-2 font-semibold text-lv-strong underline-offset-2 hover:underline" href="{{ ('/monthly/' + nm.key + '/') | lurl(lang) }}">{% icon "calendar-heart", "mt-0.5 size-4 shrink-0" %}<span><span data-mp-newmonth-label>{{ "monthly.newmonth" | t(lang, { month: nm.monthName }) }}</span> <span aria-hidden="true">→</span></span></a>
          </p>
          {% endif %}
          {{ ui.sectionHead(m.title, "", "", "", "calendar-heart", { eyebrow: "monthly.this_month" | t(lang), id: "mp-now-title", class: "mb-5! sm:mb-6!", lang: lang }) }}
          <div class="grid gap-4 sm:grid-cols-2">
            {% set gvBox %}
            <div class="mp-now-mag rounded-xl bg-gv-soft p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-gv-strong">{{ "monthly.in_gv" | t(lang, { month: m.monthName }) }}</p>
              <p class="mt-1 font-display text-xl font-semibold text-ink">{{ m.gv.theme if m.gv else ("monthly.no_issue" | t(lang)) }}</p>
              {{ mp.orig(m.gv, lang, "en") }}
            </div>
            {% endset %}
            {% set lvBox %}
            {% if m.lv %}
            <div class="mp-now-mag rounded-xl bg-lv-soft p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-lv-strong">{{ "monthly.in_lv" | t(lang) }} · {{ m.lv.label }}</p>
              <p class="mt-1 font-display text-xl font-semibold text-ink"{% if m.lv.themeLang and m.lv.themeLang != lang %} lang="{{ m.lv.themeLang }}"{% endif %}>{{ m.lv.theme }}</p>
              {{ mp.orig(m.lv, lang, "es") }}
            </div>
            {% endif %}
            {% endset %}
            {% if lang == "es" %}{{ lvBox | safe }}{{ gvBox | safe }}{% else %}{{ gvBox | safe }}{{ lvBox | safe }}{% endif %}
          </div>

          {#- this month's dates still to come, as chips: a story deadline due THIS month (Grapevine's and La
              Viña's — the page language's magazine first; La Viña's theme in its own Spanish words, lang="es"),
              the committee / booth dates not over yet, and — once this month's meeting is over — the next one.
              Each chip hides itself when its time passes (data-mp-over, an instant; monthly.js), and the list
              with it. -#}
          {%- set chips = [] -%}
          {%- set dlPubs = [[m.lvDeadlines, "badge-lv"], [m.deadlines, "badge-gv"]] if lang == "es" else [[m.deadlines, "badge-gv"], [m.lvDeadlines, "badge-lv"]] -%}
          {%- for p in dlPubs %}{% for d in p[0] %}{% if d.due and d.due.startsWith(m.key) %}{% set _n = chips.push({ cls: p[1], icon: "pen-line", text: d.theme, lang: d.themeLang or "", mt: d.machine, tail: " · " + d.dueLabel, over: d.overAt }) %}{% endif %}{% endfor %}{% endfor -%}
          {%- for d in m.dates %}{% if d.kind != "event" and not d.past %}{% set _n = chips.push({ cls: "badge ev-badge ev-tone-" + (d | eventTone), icon: ("video" if d.kind == "committee" else "repeat"), text: (("monthly.committee" | t(lang)) if d.kind == "committee" else d.title) + " · " + d.dayLabel, over: d.overAt }) %}{% endif %}{% endfor -%}
          {%- if nx.nextCommittee and not nx.nextCommittee.thisMonth %}{% set _n = chips.push({ cls: "badge ev-badge ev-tone-committee", icon: "video", text: ("monthly.next_meeting" | t(lang)) + " · " + nx.nextCommittee.dayLabel, over: nx.nextCommittee.overAt }) %}{% endif -%}
          {% if chips.length %}
          <ul class="mt-5 flex flex-wrap gap-2" role="list" aria-label="{{ 'monthly.dates' | t(lang) }}" data-mp-chips>
            {% for c in chips %}<li class="{{ c.cls }}" data-mp-chip data-mp-over="{{ c.over }}">{% icon c.icon, "size-3" %} {% if c.lang and c.lang != lang %}<span lang="{{ c.lang }}">{{ c.text }}</span>{% else %}{{ c.text }}{% endif %}{% if c.mt %} {{ mtMark | safe }}{% endif %}{{ c.tail }}</li>{% endfor %}
          </ul>
          {% endif %}

          {% if m.tips.length %}
          <h3 class="eyebrow mt-6">{{ "monthly.put_to_work" | t(lang) }}</h3>
          <ul class="mp-tiplist mt-3" role="list">
            {% for tp in m.tips | limit(2) %}
            <li><span class="mp-tipicon">{% icon tp.icon, "size-5" %}</span><span><strong class="block text-ink">{{ tp.title }}</strong><span class="text-sm text-muted">{{ tp.text }}</span></span></li>
            {% endfor %}
          </ul>
          {% endif %}

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
            <a class="btn-primary" href="{{ monthUrl }}">{% icon "calendar-heart", "size-4" %} {{ "monthly.open_toolkit" | t(lang, { month: m.monthName }) }}</a>
            <a class="tap-link inline-flex items-center gap-1.5 text-sm font-semibold text-gv no-underline hover:underline" href="{{ monthUrl }}#mp-message">{% icon "message-circle", "size-4 shrink-0" %} {{ "monthly.msg_link" | t(lang) }}</a>
            {% if nm %}<a class="tap-link inline-flex items-center gap-1.5 text-sm font-semibold text-gv no-underline hover:underline" href="{{ ('/monthly/' + nm.key + '/') | lurl(lang) }}">{{ "monthly.next_link" | t(lang, { theme: (nm.gv.theme if nm.gv else nm.title) }) }}{% if nm.gv and nm.gv.machine %} {{ mtMark | safe }}{% endif %} {% icon "arrow-right", "size-4 shrink-0" %}</a>{% endif %}
          </div>
        </div>
      </div>
      <a class="mp-now-poster group" href="{{ monthUrl }}">
        <span class="mp-stage mp-stage--thumb" aria-hidden="true" inert><span class="mp-fit">{{ mp.posterMini(m, lang) }}</span></span>
        <span class="mt-3 inline-flex min-h-11 items-center gap-1.5 font-semibold text-gv group-hover:underline">{{ "monthly.open_month" | t(lang, { month: m.label }) }} {% icon "arrow-right", "size-4" %}</span>
      </a>
    </div>
  </div>
</section>

{#- ============ Your district report (the one home of the GV/LV report) ============ -#}
{#- An editor each GVR / RLV tailors for the district meeting (src/assets/js/report.js). Its 12
    sections are written at build time from the site's data, in English AND Spanish
    (eleventy/filters/report.js → #rp-data); the editor's own words come from #rp-ui (page language).
    Layout (areas/report.css .rp-grid): "Your details" across the top, then the section list (left)
    and the live preview with the copy / share / save buttons (right; pinned while the list scrolls
    when the window is tall enough). From 1800px three columns: details · sections · preview.
    Phones: one column in that order, the preview folded to a readable height. Without JavaScript:
    the whole report as text in the page language (.rp-nojs). Printing prints only the report.
    "For: District meeting | Area" (the top of "Your details"): Area is the chair's report to an assembly or an
    Area committee meeting for the dates the chair picks (eleventy/filters/report.js areaModel → #rp-area; the
    editor joins its pieces for the period) — one document, the English part then the Spanish one; the language
    switch picks the part being edited. #rp-area's "today", "min" and "max" move with the clock, not with what the
    page says: data-lastmod leaves them out of the page's sitemap date (eleventy/lastmod.js). -#}
{%- set rp = db | rpModel(meeting, carry, site) -%}
{%- set rpa = db | rpArea(site) -%}
<section id="report" class="section container-page pt-0" aria-labelledby="report-title">
  {#- one job each: this report is for the district meeting; a group chat or e-mail gets this month as a
      message (the month page's #mp-message) or last month's Monthly digest — a one-line pointer to both
      (and they point back here) -#}
  {%- set reportSub -%}
  {{ "community.report.sub" | t(lang) }}<span class="mt-2 flex items-start gap-2 text-sm"><span class="mt-0.5 shrink-0 text-gv">{% icon "mail-open", "size-4" %}</span><span>{{ "monthly.report_digest_hint" | t(lang) }} <a class="link font-semibold" href="{{ monthUrl }}#mp-message">{{ "monthly.msg_link_month" | t(lang, { month: m.label }) }}</a> · <a class="link font-semibold" href="{{ '/digest/' | lurl(lang) }}">{{ "monthly.digest_last" | t(lang) }}<span aria-hidden="true"> →</span></a></span></span>
  {%- endset %}
  {{ ui.sectionHead("community.report.title" | t(lang), reportSub, "", "", "clipboard-list", { eyebrow: "community.report.eyebrow" | t(lang), id: "report-title", lang: lang }) }}

  <div class="rp-nojs card overflow-hidden">
    <p class="flex items-center gap-2 border-b border-line bg-surface-2/60 px-4 py-3 text-sm text-muted sm:px-6">{% icon "info", "size-4 shrink-0" %} {{ "report.nojs_note" | t(lang) }}</p>
    <pre class="rp-nojs-text" lang="{{ lang }}">{{ rp | rpText(lang) }}</pre>
  </div>

  <div class="rp-app" data-js-only x-data="rpEditor('{{ lang }}')">
    <script type="application/json" id="rp-data">{{ rp | rpJson | safe }}</script>
    <script type="application/json" id="rp-ui">{{ lang | rpUi | rpJson | safe }}</script>
    <script type="application/json" id="rp-area" data-lastmod="skip:today,min,max">{{ rpa | rpJson | safe }}</script>
    <template x-if="d">
    <div class="rp-grid">

      {#- ---- Your details: they fill the [blanks]; the report language ---- -#}
      <div class="rp-settings card card-pad">
        <div class="rp-settings-head">
          <h3 class="card-h"><span>{% icon "user-round", "size-5" %}</span>{{ "report.settings_title" | t(lang) }}</h3>
          <p class="rp-saved" :class="{ 'is-failed': saveState === 'failed' }">
            <span class="rp-saved-icon" x-show="saveState !== 'failed'">{% icon "circle-check", "size-4" %}</span><span class="rp-saved-icon" x-show="saveState === 'failed'">{% icon "triangle-alert", "size-4" %}</span>
            <span role="status" x-text="savedText()"></span><span aria-hidden="true" x-show="savedAt && saveState === 'saved'" x-text="'· ' + savedAt"></span>
          </p>
        </div>
        {#- For: a district meeting (the GVR's / RLV's monthly report) or the Area (the chair's report to an assembly
            or an Area committee meeting: report.js setMode) -#}
        <fieldset class="rp-for" x-show="A">
          <legend class="rp-label">{{ "report.ar_for" | t(lang) }}</legend>
          <div class="grid grid-cols-2 gap-1 rounded-full border border-line bg-surface-2 p-1">
            <label class="cm-seg"><input type="radio" name="rp-for" value="district" class="sr-only" :checked="mode === 'district'" @change="setMode('district')"><span>{{ "report.ar_for_district" | t(lang) }}</span></label>
            <label class="cm-seg"><input type="radio" name="rp-for" value="area" class="sr-only" :checked="mode === 'area'" @change="setMode('area')"><span>{{ "report.ar_for_area" | t(lang) }}</span></label>
          </div>
          <p class="rp-hint">{{ "report.ar_for_hint" | t(lang) }}</p>
        </fieldset>
        <div class="rp-fields">
          <div class="rp-f rp-f-district" x-show="mode !== 'area'">
            <label class="rp-label" for="rp-district">{{ "report.f_district" | t(lang) }}</label>
            <input id="rp-district" class="input" type="text" autocomplete="off" maxlength="12" :value="prof.district" @input="setProf('district', $event.target.value)">
          </div>
          {#- the Area report: its meeting (fills the title's blank) and its period (the pieces it keeps: report.js
              areaSections) — dates that can't be a period stay in the fields as typed, and why is said under them
              (rangeErr: the start after the end, or a day out of reach) -#}
          <div class="rp-f rp-f-ameet" x-show="mode === 'area'">
            <label class="rp-label" for="rp-ameet">{{ "report.ar_meeting" | t(lang) }}</label>
            <select id="rp-ameet" class="input rp-select" x-effect="$el.value = prof.ameet" @change="setProf('ameet', $event.target.value)">
              <option value="">{{ "report.f_role_none" | t(lang) }}</option>
              <option value="assembly">{{ "report.ar_meeting_assembly" | t(lang) }}</option>
              <option value="acm">{{ "report.ar_meeting_acm" | t(lang) }}</option>
            </select>
          </div>
          <div class="rp-f rp-f-date" x-show="mode === 'area'">
            <label class="rp-label" for="rp-from">{{ "report.ar_from" | t(lang) }}</label>
            <input id="rp-from" class="input" type="date" :min="A && A.min" :max="A && A.max" :value="rangeIn.from" :aria-describedby="rangeErr ? 'rp-range-hint rp-range-err' : 'rp-range-hint'" @change="setRange('from', $event.target.value)">
          </div>
          <div class="rp-f rp-f-date" x-show="mode === 'area'">
            <label class="rp-label" for="rp-to">{{ "report.ar_to" | t(lang) }}</label>
            <input id="rp-to" class="input" type="date" :min="A && A.min" :max="A && A.max" :value="rangeIn.to" :aria-describedby="rangeErr ? 'rp-range-hint rp-range-err' : 'rp-range-hint'" @change="setRange('to', $event.target.value)">
          </div>
          <div class="rp-f rp-f-range" x-show="mode === 'area'">
            <p id="rp-range-hint" class="rp-hint mt-0!">{{ "report.ar_range_hint" | t(lang) }}</p>
            <p id="rp-range-err" class="rp-hint rp-err" x-show="rangeErr" x-text="rangeErrText()"></p>
            {#- (a To that follows today: report.js follows) -#}
            <p class="rp-hint" x-show="follows()">{{ "report.ar_open_hint" | t(lang) }}</p>
            <p class="rp-hint rp-older" x-show="olderText()">{% icon "info", "size-3.5 shrink-0" %} <span x-text="olderText()"></span></p>
            {#- "Next report" (once a To picked by hand is before today: report.js newPeriod files this one under
                "Earlier reports") and the earlier reports, folded: Word, print, delete — never edited -#}
            <button type="button" class="btn-ghost btn-sm mt-1 text-gv" data-rp-next x-show="newPeriodText()" @click="newPeriod()">{% icon "calendar-plus", "size-4" %} <span x-text="newPeriodText()"></span></button>
            <details class="rp-done" x-show="done.length" x-cloak>
              <summary class="rp-done-sum">{% icon "archive", "size-4 shrink-0" %} <span x-text="doneTitle()"></span>{% icon "chevron-down", "size-4 shrink-0 rp-done-chev" %}</summary>
              {#- (Safari's 7-day rule — a Safari tab, any browser on an iPhone or iPad: report.js sevenKind; the same line in
                  the saving note below) -#}
              <p class="rp-hint">{{ "report.ar_done_hint" | t(lang) }}<span x-show="sevenDays === 'safari'" x-cloak> {{ "report.ar_keep_safari" | t(lang) }}</span><span x-show="sevenDays === 'browser'" x-cloak> {{ "report.ar_keep_browser" | t(lang) }}</span><span x-show="sevenDays === 'mac'" x-cloak> {{ "report.ar_keep_mac" | t(lang) }}</span></p>
              <ul class="rp-done-list" role="list">
                <template x-for="(r, i) in done" :key="r.from + ':' + r.to + ':' + i">
                  <li class="rp-done-item" data-rp-done>
                    <span class="rp-done-dates" x-text="doneLabel(r)"></span>
                    <span class="rp-done-acts">
                      <button type="button" class="btn-ghost btn-sm" data-rp-done-word @click="doneDownload(i)">{% icon "file-text", "size-4" %}<span><span class="sr-only">{{ "report.download_sr" | t(lang) }} </span>{{ "report.download_doc" | t(lang) }}<span class="sr-only" x-text="', ' + doneLabel(r)"></span></span></button>
                      <button type="button" class="btn-ghost btn-sm" data-rp-done-print @click="donePrint(i)">{% icon "printer", "size-4" %}<span>{{ "report.print" | t(lang) }}<span class="sr-only" x-text="', ' + doneLabel(r)"></span></span></button>
                      <button type="button" class="btn-ghost btn-sm text-danger" data-rp-done-delete @click="doneDelete(i)">{% icon "trash-2", "size-4" %}<span>{{ "report.ar_done_delete" | t(lang) }}<span class="sr-only" x-text="', ' + doneLabel(r)"></span></span></button>
                    </span>
                  </li>
                </template>
              </ul>
            </details>
          </div>
          <div class="rp-f rp-f-role" x-show="mode !== 'area'">
            <label class="rp-label" for="rp-role">{{ "report.f_role" | t(lang) }}</label>
            <select id="rp-role" class="input rp-select" x-effect="$el.value = prof.role" @change="setProf('role', $event.target.value)">
              <option value="">{{ "report.f_role_none" | t(lang) }}</option>
              {#- La Viña first on Spanish pages -#}
              {%- if lang == "es" %}
              <option value="rlv">{{ "report.role_rlv" | t(lang) }}</option>
              <option value="gvr">{{ "report.role_gvr" | t(lang) }}</option>
              {%- else %}
              <option value="gvr">{{ "report.role_gvr" | t(lang) }}</option>
              <option value="rlv">{{ "report.role_rlv" | t(lang) }}</option>
              {%- endif %}
              <option value="both">{{ "report.role_both" | t(lang) }}</option>
              <option value="chair">{{ "report.role_chair_label" | t(lang) }}</option>
              <option value="dcm">{{ "report.role_dcm" | t(lang) }}</option>
            </select>
          </div>
          <div class="rp-f rp-f-name">
            <label class="rp-label" for="rp-name">{{ "report.f_name" | t(lang) }}</label>
            <input id="rp-name" class="input" type="text" autocomplete="off" maxlength="40" aria-describedby="rp-name-hint" :value="prof.name" @input="setProf('name', $event.target.value)">
            <p id="rp-name-hint" class="rp-hint">{{ "report.f_name_hint" | t(lang) }}</p>
          </div>
          <div class="rp-f rp-f-group" x-show="mode !== 'area'">
            <label class="rp-label" for="rp-group">{{ "report.f_group" | t(lang) }}</label>
            <input id="rp-group" class="input" type="text" autocomplete="off" maxlength="60" :value="prof.group" @input="setProf('group', $event.target.value)">
          </div>
          {#- (the Area report holds both languages: the switch picks the part being edited) -#}
          <fieldset class="rp-f rp-f-lang">
            <legend class="rp-label"><span x-show="mode !== 'area'">{{ "report.f_lang" | t(lang) }}</span><span x-show="mode === 'area'">{{ "report.ar_part" | t(lang) }}</span></legend>
            <div class="grid grid-cols-2 gap-1 rounded-full border border-line bg-surface-2 p-1">
              {%- for l in (["es", "en"] if lang == "es" else ["en", "es"]) %}
              <label class="cm-seg"><input type="radio" name="rp-lang" value="{{ l }}" class="sr-only" :checked="rl === '{{ l }}'" @change="setLang('{{ l }}')"><span lang="{{ l }}">{{ ("community.lang_name_" + l) | t(lang) }}</span></label>
              {%- endfor %}
            </div>
          </fieldset>
        </div>
        <p class="rp-note" x-show="mode !== 'area'">{{ "report.settings_note" | t(lang, { month: rp.langs[lang].month }) }}</p>
        <p class="rp-note" x-show="mode === 'area'">{{ "report.ar_settings_note" | t(lang) }}<span x-show="sevenDays === 'safari'" x-cloak> {{ "report.ar_keep_safari" | t(lang) }}</span><span x-show="sevenDays === 'browser'" x-cloak> {{ "report.ar_keep_browser" | t(lang) }}</span><span x-show="sevenDays === 'mac'" x-cloak> {{ "report.ar_keep_mac" | t(lang) }}</span></p>
        {#- A new month with no draft yet: last month's draft on this device as the starting point (report.js findPrev /
            startFromPrev — the visitor's own sections, choices and words; the data sections are this month's) -#}
        <div class="rp-prev" x-show="prev" x-cloak role="group" aria-labelledby="rp-prev-title">
          {#- (the title names the draft's month when it is older than last month: report.js prevTitle) -#}
          <p id="rp-prev-title" class="rp-prev-title">{% icon "history", "size-4 shrink-0" %} <span x-text="prevTitle()">{{ "report.prev_title" | t(lang) }}</span></p>
          <p class="rp-prev-text" x-text="prevText()"></p>
          <button type="button" class="btn-secondary btn-sm" data-rp-prev @click="startFromPrev()">{% icon "copy-plus", "size-4" %} <span x-text="prevBtn()"></span></button>
        </div>
      </div>

      {#- ---- The sections: include, reorder, edit, add your own ---- -#}
      <div class="rp-side">
        <div class="rp-list card">
          <div class="rp-list-head">
            <h3 id="rp-secs-title" class="card-h"><span>{% icon "list-ordered", "size-5" %}</span>{{ "report.sections_title" | t(lang) }}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{{ "report.sections_hint" | t(lang) }}</p>
          </div>
          <ol class="rp-secs" role="list" aria-labelledby="rp-secs-title">
            <template x-for="s in list()" :key="s.id">
              <li class="rp-sec" :class="{ 'is-off': !s.on, 'is-empty': s.empty, 'is-open': open[s.id], 'is-active': active === s.id }">
                <div class="rp-sec-row">
                  <label class="rp-check"><input type="checkbox" :checked="s.on" @change="toggle(s.id)" :aria-label="say('include', s.title)"></label>
                  <button type="button" class="rp-sec-btn" :data-rp-edit="s.id" :aria-expanded="open[s.id] ? 'true' : 'false'" :aria-controls="'rp-ed-' + s.id" @click="toggleOpen(s.id)">
                    <span class="rp-num" aria-hidden="true"><span x-show="s.header">{% icon "heading", "size-3.5" %}</span><span x-show="!s.header" x-text="s.num || '–'"></span></span>
                    <span class="rp-sec-name">
                      <span class="sr-only">{{ "report.edit" | t(lang) }}: </span><span :id="'rp-t-' + s.id" :lang="rl" x-text="s.title"></span>
                      <span class="rp-badges"><span class="badge-lv" x-show="s.edited">{{ "report.edited" | t(lang) }}</span><span class="badge-muted" x-show="s.empty">{{ "report.empty" | t(lang) }}</span></span>
                    </span>
                    <span class="rp-sec-edit" aria-hidden="true">{% icon "pencil", "size-4" %}<span class="rp-sec-edit-label">{{ "report.edit" | t(lang) }}</span></span>
                  </button>
                  <div class="rp-move">
                    <template x-if="!s.header">
                      <div class="flex">
                        <button type="button" class="rp-icon-btn" data-rp-move="up" :data-rp-id="s.id" :aria-disabled="s.first ? 'true' : 'false'" :aria-label="say('move_up', s.title)" @click="move(s.id, -1)">{% icon "arrow-up", "size-4" %}</button>
                        <button type="button" class="rp-icon-btn" data-rp-move="down" :data-rp-id="s.id" :aria-disabled="s.last ? 'true' : 'false'" :aria-label="say('move_down', s.title)" @click="move(s.id, 1)">{% icon "arrow-down", "size-4" %}</button>
                      </div>
                    </template>
                  </div>
                </div>
                <div class="rp-sec-ed" :id="'rp-ed-' + s.id" x-show="open[s.id]" role="group" :aria-labelledby="'rp-t-' + s.id">
                  <template x-if="!s.header">
                    <div class="rp-field">
                      <label class="rp-label" :for="'rp-title-' + s.id">{{ "report.f_title" | t(lang) }}</label>
                      <input class="input" type="text" maxlength="120" :id="'rp-title-' + s.id" :lang="rl" :placeholder="s.custom ? lm().custom : ''" x-effect="if ($el.value !== titleValue(s.id)) $el.value = titleValue(s.id)" @input="setTitle(s.id, $event.target.value)" @focus="focusSec(s.id)">
                    </div>
                  </template>
                  <template x-if="s.id === 'meetings'">
                    <fieldset class="rp-pick">
                      <legend class="rp-label">{{ "report.meet_pick" | t(lang) }}</legend>
                      <p class="rp-hint -mt-1 mb-2">{{ "report.meet_pick_hint" | t(lang) }}</p>
                      {%- for g in [["area", "report.meet_area"], ["near", "report.meet_near"]] %}
                      <template x-if="meetOpts('{{ g[0] }}').length">
                        <div class="rp-pick-group">
                          <p class="rp-pick-head">{{ g[1] | t(lang) }}</p>
                          <div class="rp-pick-list">
                            <template x-for="o in meetOpts('{{ g[0] }}')" :key="o.id">
                              <label class="rp-pick-item"><input type="checkbox" :checked="picked(o.id)" @change="togglePick(o.id)"><span x-text="o.label[L]"></span><span class="rp-pick-n" x-text="o.count"></span></label>
                            </template>
                          </div>
                        </div>
                      </template>
                      {%- endfor %}
                      <button type="button" class="btn-ghost btn-sm mt-1" x-show="d.meet.length" @click="clearPicks()">{% icon "x", "size-4" %} {{ "report.meet_clear" | t(lang) }}</button>
                    </fieldset>
                  </template>
                  <div class="rp-field">
                    <label class="rp-label" :for="'rp-text-' + s.id">{{ "report.f_text" | t(lang) }}</label>
                    <textarea class="input rp-text" rows="6" spellcheck="true" :id="'rp-text-' + s.id" :lang="rl" :aria-describedby="'rp-hint-' + s.id" :placeholder="s.id === 'notes' ? ui[mode === 'area' ? 'ar_n_placeholder' : 'n_placeholder'] : ''" x-effect="if ($el.value !== textOf(s.id)) { $el.value = textOf(s.id); grow($el) }" @input="setText(s.id, $event.target.value); grow($event.target)" @focus="focusSec(s.id)"></textarea>
                    <p class="rp-hint" :id="'rp-hint-' + s.id" x-text="s.header ? ui.header_hint : ui.text_hint"></p>
                  </div>
                  <div class="rp-ed-actions">
                    <button type="button" class="btn-ghost btn-sm" x-show="s.edited" @click="resetSection(s.id)">{% icon "rotate-ccw", "size-4" %} {{ "report.reset_section" | t(lang) }}</button>
                    <button type="button" class="btn-ghost btn-sm text-danger" x-show="s.custom" @click="removeCustom(s.id)">{% icon "trash-2", "size-4" %} {{ "report.remove_section" | t(lang) }}</button>
                    <button type="button" class="btn-secondary btn-sm ml-auto" @click="closeEditor(s.id)">{% icon "check", "size-4" %} {{ "report.done" | t(lang) }}</button>
                  </div>
                </div>
              </li>
            </template>
          </ol>
          <div class="rp-list-foot">
            <button type="button" class="btn-secondary btn-sm" x-ref="add" @click="addCustom()">{% icon "plus", "size-4" %} {{ "report.add_section" | t(lang) }}</button>
            {#- (the Area report: this part only — report.js resetAll) -#}
            <button type="button" class="btn-ghost btn-sm" data-rp-reset @click="resetAll()">{% icon "rotate-ccw", "size-4" %} <span x-show="mode !== 'area'">{{ "report.reset_all" | t(lang) }}</span><span x-show="mode === 'area'" x-cloak>{{ "report.ar_reset_part" | t(lang) }}</span></button>
          </div>
        </div>

        <details class="rp-tips card group" x-show="mode !== 'area'">
          <summary class="rp-tips-sum">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-lv-soft text-lv">{% icon "lightbulb", "size-5" %}</span>
            <span class="min-w-0 flex-1 font-semibold text-ink">{{ "report.tips_more" | t(lang) }}</span>
            {% icon "chevron-down", "size-5 shrink-0 text-muted transition group-open:rotate-180" %}
          </summary>
          <ul class="space-y-3 border-t border-line px-5 py-4 text-sm leading-relaxed text-muted" role="list">
            {% for k in ["tip1", "tip2", "tip3", "tip4", "tip5"] %}
            <li class="flex gap-2.5">{% icon "check", "size-4 mt-0.5 shrink-0 text-vine" %}<span>{{ ("community.report." + k) | t(lang) }}</span></li>
            {% endfor %}
          </ul>
        </details>
      </div>

      {#- ---- The live preview + copy / share / save ---- -#}
      <div class="rp-main">
        <div class="rp-out card">
          <div class="rp-out-head">
            <div class="rp-out-top">
              <h3 id="rp-out-title" class="card-h"><span>{% icon "file-text", "size-5" %}</span>{{ "report.preview_title" | t(lang) }}</h3>
              <p class="rp-stats"><span :class="{ 'is-blanks': blanks() }" x-text="blanksText()"></span><span x-text="readText()"></span></p>
            </div>
            <div class="rp-actions" role="group" aria-label="{{ 'report.actions_label' | t(lang) }}">
              <div class="rp-act-row">
                <button type="button" class="btn-primary btn-sm rp-a-main" @click="copyText($el)">{% icon "copy", "size-4" %} {{ "report.copy_text" | t(lang) }}</button>
                <button type="button" class="btn-secondary btn-sm" data-rp-wa @click="whatsapp()">{% icon "message-circle", "size-4" %}<span><span class="sr-only">{{ "report.send_sr" | t(lang) }} </span>{{ "report.whatsapp" | t(lang) }}</span></button>
                <button type="button" class="btn-secondary btn-sm" @click="email()">{% icon "mail", "size-4" %}<span><span class="sr-only">{{ "report.send_sr" | t(lang) }} </span>{{ "report.email" | t(lang) }}</span></button>
                <button type="button" class="btn-secondary btn-sm rp-a-wide" @click="copyHtml($el)">{% icon "clipboard-copy", "size-4" %} {{ "report.copy_html" | t(lang) }}</button>
              </div>
              <div class="rp-act-row">
                <button type="button" class="btn-secondary btn-sm" @click="download('docx')">{% icon "file-text", "size-4" %}<span><span class="sr-only">{{ "report.download_sr" | t(lang) }} </span>{{ "report.download_doc" | t(lang) }}</span></button>
                <button type="button" class="btn-secondary btn-sm" @click="download('txt')">{% icon "download", "size-4" %}<span><span class="sr-only">{{ "report.download_sr" | t(lang) }} </span>{{ "report.download_txt" | t(lang) }}</span></button>
                <button type="button" class="btn-secondary btn-sm" @click="print()">{% icon "printer", "size-4" %} {{ "report.print" | t(lang) }}</button>
              </div>
            </div>
            {#- the Area report's dated file name, for the committee's Drive (its "reports" folder) -#}
            <p class="rp-hint mt-0! flex items-start gap-1.5" x-show="mode === 'area'">{% icon "folder-open", "size-3.5 mt-0.5 shrink-0" %}<span x-text="fileHint()"></span></p>
            <p class="rp-msg" x-show="msg" x-cloak>{% icon "circle-check", "size-4 shrink-0" %}<span x-text="msg"></span></p>
            <div class="rp-wa" x-show="waLong" x-cloak>
              <h4 id="rp-wa-title" class="flex items-center gap-2 font-semibold text-ink" tabindex="-1">{% icon "triangle-alert", "size-4 shrink-0 text-lv" %} {{ "report.wa_long_title" | t(lang) }}</h4>
              <p class="mt-1 text-sm leading-relaxed text-muted">{{ "report.wa_long_text" | t(lang) }}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" class="btn-secondary btn-sm" @click="copyText($el)">{% icon "copy", "size-4" %} {{ "report.copy_text" | t(lang) }}</button>
                <button type="button" class="btn-secondary btn-sm" @click="waOpen()">{% icon "message-circle", "size-4" %} {{ "report.wa_open" | t(lang) }}<span class="sr-only"> ({{ 'common.external' | t(lang) }})</span></button>
                <button type="button" class="btn-secondary btn-sm" x-show="canShare" @click="shareNative()">{% icon "share-2", "size-4" %} {{ "report.share_other" | t(lang) }}</button>
                <button type="button" class="btn-ghost btn-sm" @click="closeWa()">{% icon "x", "size-4" %} {{ "common.close" | t(lang) }}</button>
              </div>
            </div>
          </div>
          <div id="rp-doc-wrap" class="rp-doc-wrap" data-tts-skip x-ref="doc" :class="{ 'is-open': full }" tabindex="0" role="region" aria-label="{{ 'report.preview_label' | t(lang) }}">
            <div class="rp-doc" :lang="docLang()" x-html="preview()"></div>
          </div>
          <div class="rp-fold">
            <button type="button" class="btn-ghost btn-sm text-gv" @click="full = !full" :aria-expanded="full ? 'true' : 'false'" aria-controls="rp-doc-wrap">
              <span x-show="!full">{{ "community.report.show_full" | t(lang) }}</span><span x-show="full">{{ "common.show_less" | t(lang) }}</span>
              {% icon "chevron-down", "size-4 transition" %}
            </button>
          </div>
        </div>
      </div>

    </div>
    </template>
  </div>
</section>

{#- ============ All posters (a band) ============ -#}
<section id="posters" class="section section-band" aria-labelledby="mp-all-title">
  <div class="container-page">
    {{ ui.sectionHead("monthly.all_posters" | t(lang), "monthly.all_posters_sub" | t(lang), "", "", "image", { eyebrow: "monthly.posters_eyebrow" | t(lang), tone: "text-grape", id: "mp-all-title", lang: lang }) }}
    <ul class="mp-grid" role="list">
      {#- this month is featured above; the grid holds the coming months, each in miniature (posterMini) -#}
      {% for pm in months %}{% if not pm.isCurrent %}
      <li>
        <a class="mp-thumb group" href="{{ ('/monthly/' + pm.key + '/') | lurl(lang) }}">
          <span class="mp-stage mp-stage--thumb" aria-hidden="true" inert><span class="mp-fit">{{ mp.posterMini(pm, lang) }}</span></span>
          <span class="mp-thumb-label">
            <span class="font-semibold text-ink group-hover:text-gv group-hover:underline">{{ pm.title }}</span>
          </span>
          {% if pm.gv %}<span class="block text-sm text-muted">{{ pm.gv.theme }}{% if pm.gv.machine %} {{ mtMark | safe }}{% endif %}</span>{% endif %}
        </a>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>

{#- ============ The 10 ways (canonical home of the guide) ============ -#}
{% if carry.ways.length %}
{#- the header's link: the full editorial calendar, when the committee has it on Drive (driveMatch;
    the Portfolio stays its home) -#}
{%- set edCal = db.drive.items | driveMatch("editorial calendar|calendario editorial") -%}
<section id="ways" class="section container-page" aria-labelledby="ways-title">
  {{ ui.sectionHead("monthly.ways_title" | t(lang), (carry.intro[lang] | escape) if carry.intro else "", (edCal.extra.view_url or edCal.url) if edCal else "", "monthly.editorial_calendar" | t(lang), "list-checks", { eyebrow: "monthly.put_to_work" | t(lang), id: "ways-title", lang: lang }) }}
  <ol class="mp-ways" role="list">
    {% for w in carry.ways %}
    <li class="card card-pad">
      <span class="mp-way-n" aria-hidden="true">{{ loop.index }}</span>
      <span class="mp-tipicon">{% icon w.icon, "size-5" %}</span>
      <h3 class="h-card mt-3 pr-8 text-lg"><span class="sr-only">{{ loop.index }}. </span>{{ w.title[lang] }}</h3>
      <p class="mt-1.5 text-sm text-muted">{{ w.text[lang] }}</p>
    </li>
    {% endfor %}
  </ol>
  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {% if carry.story_note %}
    <div class="card card-pad flex gap-4">
      <span class="mp-tipicon">{% icon "pen-line", "size-5" %}</span>
      <p class="text-ink">{{ carry.story_note[lang] }} <a class="link font-semibold" href="{{ '/contribute/' | lurl(lang) }}">{{ "nav.contribute" | t(lang) }}</a></p>
    </div>
    {% endif %}
    {#- The representatives' official guides: a pointer in our own words + the documents (never quoted)
        + the official GVR / RLV resource pages (config/site.yml links.gvr_resources / rlv_resources) -#}
    {%- set guides = db.pdfs | mpGuides(lang) if carry.guides else [] -%}
    {%- set repLinks = [[site.links.gvr_resources, "read.subs.all_gvr", "en"], [site.links.rlv_resources, "read.subs.all_rlv", "es"]] if carry.guides else [] -%}
    {% if guides.length or (repLinks | length and site.links.gvr_resources) %}
    <div class="card card-pad flex gap-4">
      <span class="mp-tipicon">{% icon "notebook-pen", "size-5" %}</span>
      <div class="min-w-0">
        <p class="text-ink">{{ carry.guides[lang] }}</p>
        <ul class="mt-1 space-y-0.5" role="list">
          {% for g in guides %}
          <li><a class="link tap-link inline-flex flex-wrap items-baseline gap-x-1.5 font-semibold" href="{{ g.url }}" target="_blank" rel="noopener" hreflang="{{ g.lang }}"><span{% if g.lang != lang %} lang="{{ g.lang }}"{% endif %}>{{ g.title }}</span><span class="text-sm font-normal text-muted">({{ ("monthly.guide_doc" if g.lang == lang else ("monthly.guide_doc_" + g.lang)) | t(lang) }})</span><span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></li>
          {% endfor %}
          {% for r in repLinks %}{% if r[0] %}
          <li><a class="link tap-link inline-flex items-center gap-1.5 font-semibold" href="{{ r[0] }}" target="_blank" rel="noopener" hreflang="{{ r[2] }}">{{ r[1] | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span>{% icon "arrow-up-right", "size-4 shrink-0" %}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
  </div>
  {% if carry.source %}<p class="mt-6 max-w-3xl text-xs text-muted"><strong>{{ "monthly.source" | t(lang) }}:</strong> {{ carry.source[lang] }}</p>{% endif %}
  {#- One-line pointer to GVR / RLV 101 (/orientation/), whose sessions include this toolkit -#}
  {%- set o101Link %}<a class="link font-semibold" href="{{ '/orientation/' | lurl(lang) }}">{{ "nav.orientation" | t(lang) }}</a>{% endset %}
  <p class="mt-4 flex max-w-3xl items-start gap-2 text-sm leading-relaxed text-muted">{% icon "sprout", "mt-0.5 size-4 shrink-0 text-grape" %}<span>{{ "orientation.monthly_pointer" | t(lang, { link: o101Link }) | safe }}</span></p>
</section>
{% endif %}
