{%- set cfg %}{"lang": {{ lang | dump | safe }}, "base": {{ ('/' | url) | dump | safe }}, "json": {{ ('/about/booth.json' | url) | dump | safe }},
"build": {{ ('/build.json' | url) | dump | safe }}, "pages": [{{ ('/about/' | url) | dump | safe }}, {{ ('/es/about/' | url) | dump | safe }}],
"site": {"url": {{ ('/' | siteUrl(site)) | dump | safe }}, "url_es": {{ ('/es/' | siteUrl(site)) | dump | safe }}, "host": {{ (site.url | replace("https://", "") | replace("http://", "")) | dump | safe }},
"committee_en": {{ (site.committee or "") | dump | safe }}, "committee_es": {{ (site.committee_es or site.committee or "") | dump | safe }}},
"howto": {{ ((site.repository or "https://github.com/NETA65/aagrapevine") ~ "/blob/main/how-to/booth.md") | dump | safe }},
"t": { {%- for k in pageKeys %}{{ ("booth." + k) | dump | safe }}: {{ (("booth." + k) | t(lang)) | dump | safe }}{{ "," if not loop.last }}{% endfor %}},
"screen": {
  {%- for sl in ["en", "es"] %}{{ sl | dump | safe }}: { {%- for k in screenKeys %}{{ ("booth.screen." + k) | dump | safe }}: {{ (("booth.screen." + k) | t(sl)) | dump | safe }}{{ "," if not loop.last }}{% endfor %}}{{ "," if not loop.last }}{% endfor %}}}{% endset %}
<script type="application/json" id="gvb-config">{{ cfg | replace("<", "\\u003c") | safe }}</script>
{%- endmacro %}
