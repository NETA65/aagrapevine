{#- The words ON the screen (booth.screen.<name>), in both languages: the visitors' bar, the slides' eyebrows,
    True / False, the quiz round, the welcome and "about" slides … -#}
{%- set screenKeys = [
  "slide", "controls", "back", "pause", "paused", "play", "next",
  "quiz_me", "lang", "lang_en", "lang_es", "lang_both", "take_home", "take_home_text",
  "take_site", "take_slide", "close", "sound", "skip", "tap_full",
  "tap_play", "quiz", "truefalse", "true", "false", "fact", "quote",
  "history", "fill", "scramble", "poll", "prompt", "prompt_line", "qr",
  "video", "audio", "events", "countdown", "themes", "prices", "book",
  "meetings", "as_of", "answer", "right", "wrong", "right_answer", "your_answer",
  "show_answer", "votes", "votes_one", "votes_none", "voted", "days", "day",
  "hours", "hour", "minutes", "minute", "today", "welcome", "welcome_plain", "this_event",
  "welcome_line", "about_line", "about_note", "question_n", "score", "score_all", "score_good",
  "score_some", "score_line", "next_question", "see_score", "play_again", "back_to_show", "did_you",
  "got_it", "missed_it", "no_quiz", "gv", "lv", "both"
] -%}
{%- set tabs = [["event", "calendar-days"], ["show", "list-checks"], ["items", "presentation"], ["timing", "timer"], ["screen", "monitor"], ["kiosk", "lock"], ["offline", "wifi-off"], ["share", "share-2"]] -%}
<template id="gvb-tpl">
  <div class="gvb" role="dialog" aria-modal="true" aria-labelledby="gvb-dialog-title" tabindex="-1" data-gvb lang="{{ lang }}">
    <h2 id="gvb-dialog-title" class="sr-only">{{ "booth.dialog_label" | t(lang) }}</h2>
    {#- the screen (drawn by the script: header, stage, footer, the visitors' bar, the "Take it home" panel) -#}
    <div class="gvb-host" data-gvb-host></div>
    <aside class="gvb-drawer" data-gvb-drawer hidden aria-labelledby="gvb-drawer-h">
      <div class="gvb-dhead">
        <h3 id="gvb-drawer-h" class="gvb-dh">{% icon "sliders-horizontal", "size-5" %}<span>{{ "booth.set_h" | t(lang) }}</span></h3>
        <button type="button" class="gvb-iconbtn" data-gvb-act="settings" aria-label="{{ 'booth.set_close' | t(lang) }}" title="{{ 'booth.set_close' | t(lang) }} (Esc)">{% icon "x", "size-5" %}</button>
      </div>
      <p class="gvb-dnote">{{ "booth.set_note" | t(lang) }}</p>
      {#- shown while this browser keeps nothing (a private window, site data turned off) -#}
      <p class="gvb-nostore" data-gvb-nostore hidden>{% icon "info", "size-4" %}<span>{{ "booth.no_storage" | t(lang) }}</span></p>
      <div class="gvb-tabs" role="tablist" aria-label="{{ 'booth.set_h' | t(lang) }}" data-gvb-tabs>
        {%- for tb in tabs %}
        <button type="button" role="tab" class="gvb-tab" id="gvb-tab-{{ tb[0] }}" aria-controls="gvb-panel-{{ tb[0] }}" aria-selected="false" tabindex="-1" data-gvb-tab="{{ tb[0] }}">{% icon tb[1], "size-4" %}<span>{{ ("booth.tab." + tb[0]) | t(lang) }}</span></button>
        {%- endfor %}
      </div>
      <div class="gvb-panels">
        {%- for tb in tabs %}
        <div class="gvb-panel" role="tabpanel" id="gvb-panel-{{ tb[0] }}" aria-labelledby="gvb-tab-{{ tb[0] }}" tabindex="0" data-gvb-panel="{{ tb[0] }}" hidden></div>
        {%- endfor %}
      </div>
      {#- under every tab: the way out on a touch screen (Settings asked for the PIN already; "Leave?" still asks) -#}
      <div class="gvb-dfoot"><button type="button" class="gvb-pill" data-gvb-act="leave">{% icon "log-out", "size-4" %}<span>{{ "booth.leave_show" | t(lang) }}</span></button></div>
    </aside>
    {#- the PIN (asked before Settings and before leaving, when one is set) -#}
    <div class="gvb-modal" data-gvb-pin role="dialog" aria-modal="true" aria-labelledby="gvb-pin-h" aria-describedby="gvb-pin-why" hidden>
      <form class="gvb-modal-box" data-gvb-pin-form novalidate>
        <h3 id="gvb-pin-h" class="gvb-modal-h">{% icon "lock", "size-5" %}<span>{{ "booth.pin_h" | t(lang) }}</span></h3>
        <p id="gvb-pin-why" class="gvb-modal-text" data-gvb-pin-why></p>
        <label class="gvb-label" for="gvb-pin-input">{{ "booth.pin_label" | t(lang) }}</label>
        <input class="gvb-input gvb-pin-input" id="gvb-pin-input" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="off" data-gvb-pin-input aria-describedby="gvb-pin-err">
        <p class="gvb-modal-err" id="gvb-pin-err" data-gvb-pin-err aria-live="assertive"></p>
        <div class="gvb-modal-acts">
          <button type="submit" class="gvb-pill gvb-pill--primary">{{ "booth.ok" | t(lang) }}</button>
          <button type="button" class="gvb-pill" data-gvb-act="pin-cancel">{{ "booth.cancel" | t(lang) }}</button>
        </div>
      </form>
    </div>
    {#- Esc, or Settings → "Leave the show", asks before leaving the show (the PIN, when one is set, comes first) -#}
    <div class="gvb-modal" data-gvb-leave role="dialog" aria-modal="true" aria-labelledby="gvb-leave-h" aria-describedby="gvb-leave-text" hidden>
      <div class="gvb-modal-box">
        <h3 id="gvb-leave-h" class="gvb-modal-h">{% icon "log-out", "size-5" %}<span>{{ "booth.leave_h" | t(lang) }}</span></h3>
        <p id="gvb-leave-text" class="gvb-modal-text">{{ "booth.leave_text" | t(lang) }}</p>
        <div class="gvb-modal-acts">
          <button type="button" class="gvb-pill gvb-pill--primary" data-gvb-act="leave-yes">{{ "booth.leave" | t(lang) }}</button>
          <button type="button" class="gvb-pill" data-gvb-act="leave-no">{{ "booth.stay" | t(lang) }}</button>
        </div>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-gvb-live></p>
    {#- the toast: a live region that is there from the start, out of sight while it has nothing to say -#}
    <div class="gvb-toast is-idle" data-gvb-toast role="status" aria-live="polite"></div>
  </div>
</template>
