{#- =========================================================================
    The booth display — a show that plays by itself on a screen at the committee's Grapevine / La Viña table
    (assemblies, conventions, workshops). The screen is src/assets/js/booth.js (the logic — what may show now, what
    comes next, how long — is booth-core.js, window.GVB); the look is areas/booth.css (class prefix gvb-). The show
    itself is /about/booth.json (src/_data/booth.js: the CSV content/booth/booth.csv, the Drive booth folder and the
    site's live data), fetched by the script — nothing of it is in this page. Import with context (it reads `site`
    and the `url` filter), under a name other than `booth` (that name is the global data of src/_data/booth.js,
    which an import called `booth` would hide on the page):
      {% import "macros/booth.njk" as boothUi with context %}
      {{ boothUi.section(lang) }}   the About page's #booth section (after #committee)
      {{ boothUi.player(lang) }}    the player's dialog shell, its icons and #gvb-config — once, at the end of the page

    section(lang): the eyebrow, heading and two lines on what it is; a 16:9 preview card (a still welcome slide
      in the HTML — what shows without JavaScript and with reduced motion; the script cycles a few real slides in it,
      small and without sound, only while it is on screen); the quick controls (event name, its Spanish name,
      language, preset) and "Start the booth" · "Settings" · "Preview here"; three status chips the script fills
      (how many slides the show has, the content's date, the offline copy); a closed <details> "How to use it at a
      booth" with the steps and the link to how-to/booth.md; a <noscript> line. The controls are data-js-only.
    player(lang) prints, all inert until the script uses them:
      #gvb-tpl     the dialog, cloned when the booth starts: the host the script draws the screen into (header,
                   stage, footer, the visitors' bar — their words follow the slide's language, so the script writes
                   them from `screen`), the Settings drawer (eight tabs; the panels are drawn by the script; its foot
                   has "Leave the show", a touch screen's way out), the PIN and "Leave?" panels, a live region and
                   the toast — every label in the page language
      #gvb-icons   the Lucide icons the script puts on what it draws
      #gvb-config  JSON for the script: { lang, base, json (the show's address), build (build.json: the online
                   probe), pages (both About pages, saved for offline), site: { url, url_es, host, committee_en,
                   committee_es }, howto, t: the booth.* strings in the page language, screen: { en, es } — the
                   booth.screen.* words in BOTH languages (a slide shows its content's language, not the page's) }.
                   "<" is written <, so no text can end the script element.
    Strings: src/_i18n/booth.json (tests/test_booth_page.py checks that every key the script and this file use
    exists in both languages and reaches the script). -#}
{% import "macros/ui.njk" as ui with context %}

{% macro section(lang) %}
{#- the language choices and the presets, in the order the controls list them (the presets' names are the ones
    booth.js hands to GVB.preset) -#}
{%- set boothLangs = ["en", "es", "both", "alternate"] -%}
{%- set boothPresets = ["assembly", "spanish", "english", "quiet", "quizparty"] -%}
{%- set howto = (site.repository or "https://github.com/NETA65/aagrapevine") ~ "/blob/main/how-to/booth.md" -%}
{%- set committee = site | pick(lang, "committee") -%}
{#- (after the tinted #committee band: its own top padding; the block after it brings its own, so none at the bottom) -#}
<section id="booth" class="container-page section pb-0" aria-labelledby="booth-title" data-gvb-section>
  {{ ui.sectionHead("booth.title" | t(lang), "booth.sub" | t(lang), "", "", "monitor-play", { eyebrow: "booth.eyebrow" | t(lang), tone: "text-grape", id: "booth-title", lang: lang }) }}
  <p class="-mt-3 mb-8 max-w-3xl leading-relaxed text-muted sm:-mt-5">{{ "booth.lead" | t(lang) }}</p>
  <div class="gvb-sec">
    {#- The preview: a still welcome slide (no JavaScript, reduced motion); the script swaps in real slides. It is a
        picture for screen readers (role img + its name) until "Preview here" makes it a live, playable screen. -#}
    <figure class="gvb-pv">
      <div class="gvb-pv-frame" data-gvb-pv-frame role="img" aria-label="{{ 'booth.preview_still' | t(lang) }}">
        <div class="gvb-screen gvb-screen--pv" data-gvb-theme="dark" data-gvb-still>
          <div class="gvb-bg" data-pub="both" aria-hidden="true"></div>
          <div class="gvb-head" aria-hidden="true">
            <div class="gvb-event"><p class="gvb-event-name">{{ "booth.screen.both" | t(lang) }}</p><p class="gvb-event-sub">{{ committee }}</p></div>
          </div>
          <div class="gvb-stage" aria-hidden="true">
            <section class="gvb-slide gvb-t-welcome is-shown" data-pub="both" lang="{{ lang }}">
              <div class="gvb-s gvb-s--center">
                <p class="gvb-welcome-mark">{% icon "grapes", "gvb-ic" %}</p>
                <p class="gvb-h gvb-h--xl">{{ "booth.screen.welcome_plain" | t(lang) }}</p>
                <p class="gvb-txt">{{ "booth.screen.welcome_line" | t(lang) }}</p>
              </div>
            </section>
          </div>
          <div class="gvb-foot" aria-hidden="true"><span class="gvb-progress"><span></span></span></div>
        </div>
      </div>
      <figcaption class="gvb-pv-cap" data-gvb-pv-cap>{% icon "volume-x", "size-4 shrink-0" %}<span>{{ "booth.preview_label" | t(lang) }}</span></figcaption>
      {#- shown while "Preview here" plays the show in the card -#}
      <div class="gvb-pv-ctl" data-gvb-pv-ctl hidden>
        <button type="button" class="btn-secondary btn-sm" data-gvb-pv-act="pause">{% icon "pause", "size-4" %} <span>{{ "booth.preview_pause" | t(lang) }}</span></button>
        <button type="button" class="btn-secondary btn-sm" data-gvb-pv-act="next">{% icon "skip-forward", "size-4" %} <span>{{ "booth.preview_next" | t(lang) }}</span></button>
        <button type="button" class="btn-secondary btn-sm" data-gvb-pv-act="stop">{% icon "x", "size-4" %} <span>{{ "booth.preview_stop" | t(lang) }}</span></button>
      </div>
    </figure>

    <div class="card card-pad gvb-quick" data-js-only>
      <h3 class="h-card flex items-center gap-2">{% icon "sliders-horizontal", "size-5 shrink-0 text-grape" %}<span>{{ "booth.quick_h" | t(lang) }}</span></h3>
      <div class="gvb-q-field">
        <label class="gvb-q-label" for="gvb-q-event">{{ "booth.f_event" | t(lang) }}</label>
        <input class="input" id="gvb-q-event" type="text" maxlength="80" autocomplete="off" spellcheck="false" data-gvb-q="event" placeholder="{{ 'booth.f_event_ph' | t(lang) }}" aria-describedby="gvb-q-event-hint">
        <p class="gvb-q-hint" id="gvb-q-event-hint">{{ "booth.f_event_hint" | t(lang) }}</p>
      </div>
      <div class="gvb-q-field">
        <label class="gvb-q-label" for="gvb-q-event-es">{{ "booth.f_event_es" | t(lang) }}</label>
        <input class="input" id="gvb-q-event-es" type="text" maxlength="80" autocomplete="off" spellcheck="false" lang="es" data-gvb-q="event_es" placeholder="{{ 'booth.f_event_es_ph' | t(lang) }}">
      </div>
      <div class="gvb-q-row">
        <div class="gvb-q-field">
          <label class="gvb-q-label" for="gvb-q-lang">{{ "booth.f_lang" | t(lang) }}</label>
          <select class="input" id="gvb-q-lang" data-gvb-q="lang">
            {%- for l in boothLangs %}
            <option value="{{ l }}"{% if l == "en" %} lang="en"{% elif l == "es" %} lang="es"{% endif %}>{{ ("booth.lang." + l) | t(lang) }}</option>
            {%- endfor %}
          </select>
        </div>
        <div class="gvb-q-field">
          <label class="gvb-q-label" for="gvb-q-preset">{{ "booth.f_preset" | t(lang) }}</label>
          <select class="input" id="gvb-q-preset" data-gvb-q="preset">
            <option value="">{{ "booth.preset_choose" | t(lang) }}</option>
            {%- for p in boothPresets %}
            <option value="{{ p }}">{{ ("booth.preset." + p) | t(lang) }}</option>
            {%- endfor %}
          </select>
        </div>
      </div>
      <div class="gvb-q-actions">
        <button type="button" class="btn-primary" data-gvb-start>{% icon "monitor-play", "size-4" %} {{ "booth.start" | t(lang) }}</button>
        <button type="button" class="btn-secondary" data-gvb-settings>{% icon "sliders-horizontal", "size-4" %} {{ "booth.open_settings" | t(lang) }}</button>
        <button type="button" class="btn-secondary" data-gvb-preview aria-pressed="false">{% icon "eye", "size-4" %} {{ "booth.preview_here" | t(lang) }}</button>
      </div>
      {#- filled by the script: how many slides can show, the content's date, the offline copy -#}
      <ul class="gvb-chips" role="list" aria-label="{{ 'booth.st_label' | t(lang) }}">
        <li class="gvb-chip" data-gvb-chip="items">{% icon "presentation", "size-3.5 shrink-0" %}<span>{{ "booth.st_waiting" | t(lang) }}</span></li>
        <li class="gvb-chip" data-gvb-chip="content" hidden>{% icon "calendar-days", "size-3.5 shrink-0" %}<span></span></li>
        <li class="gvb-chip" data-gvb-chip="offline" hidden>{% icon "wifi-off", "size-3.5 shrink-0" %}<span></span></li>
      </ul>
    </div>
  </div>

  <details class="gvb-how group/how mt-6">
    <summary>
      {% icon "circle-help", "size-5 shrink-0 text-grape" %}
      <span class="min-w-0 flex-1 font-semibold text-ink">{{ "booth.how_h" | t(lang) }}</span>
      {% icon "chevron-down", "size-4 shrink-0 text-muted transition group-open/how:rotate-180" %}
    </summary>
    <div class="gvb-how-body">
      <ol class="gvb-how-steps" role="list">
        {%- for n in range(1, 8) %}
        <li><span class="step-num" aria-hidden="true">{{ n }}</span><span>{{ ("booth.how_" + n) | t(lang) }}</span></li>
        {%- endfor %}
      </ol>
      <p class="mt-4 flex gap-2.5 text-sm leading-relaxed text-muted"><span class="mt-0.5 text-vine">{% icon "shield-check", "size-4" %}</span><span>{{ "booth.how_aa" | t(lang) }}</span></p>
      <p class="mt-3"><a class="link tap-link" href="{{ howto }}" target="_blank" rel="noopener">{{ "booth.how_link" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
    </div>
  </details>
  <noscript><p class="mt-4 text-sm text-muted">{{ "booth.noscript" | t(lang) }}</p></noscript>
</section>
{% endmacro %}

{% macro player(lang) %}
